        },
        {
          "id": "mf-vuelta-e0804-v06",
          "texto": "le estan lanzando al finao!\".",
          "coincidencia": "le estan resando al finao",
          "semejanza": 86.3
        },
        {
          "id": "mf-vuelta-e0819-v02",
          "texto": "\"¿dónde estarás padeciendo?",
          "coincidencia": "donde andaras padeciendo",
          "semejanza": 87.5
        },
        {
          "id": "mf-vuelta-e0926-v04",
          "texto": "ya no es fácil que se ablande,",
          "coincidencia": "ya no es facil de que ablande",
