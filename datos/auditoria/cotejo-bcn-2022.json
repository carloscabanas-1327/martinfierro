        },
        {
          "id": "mf-vuelta-e0432-v03",
          "texto": "estaban irresolutos;",
          "coincidencia": "estan muertos o cautivos",
          "semejanza": 60.5
        },
        {
          "id": "mf-vuelta-e0462-v02",
          "texto": "ninguna conversación:",
