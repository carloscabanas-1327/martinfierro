---
import Base from '../../layouts/Base.astro';
const secciones=[
{grupo:'CONSEJOS Y LENGUAJE',titulo:'Viejo Vizcacha y Martín Fierro: consejos comparados',descripcion:'Seis comparaciones de estrofas originales con análisis de la prudencia, la amistad, la familia y la violencia.',href:'/biblioteca/vizcacha-y-fierro-consejos/',imagen:'/media/fotografias-v3/consejos-fogon-hijos.webp'},

{grupo:'LECTURA Y ESTUDIO',titulo:'Martín Fierro para estudiantes',descripcion:'Fichas de los 46 cantos, preguntas de lectura y once personajes documentados.',href:'/estudiantes/',imagen:'/media/fotografias-v3/la-ida.webp'},
{grupo:'LECTURA Y ESTUDIO',titulo:'Personajes del poema',descripcion:'Perfiles ilustrados, relaciones narrativas y pasajes originales.',href:'/personajes/',imagen:'/media/fotografias-v3/consejos-fogon-hijos.webp'},
{grupo:'LECTURA Y ESTUDIO',titulo:'Seis recorridos temáticos',descripcion:'Vida gaucha, frontera, justicia, amistad, familia y consejos, siempre con enlaces a los cantos.',href:'/temas/',imagen:'/media/fotografias-v3/exegesis.webp'},
{grupo:'CRÍTICA LITERARIA',titulo:'Biblioteca crítica',descripcion:'Estudios documentales, antecedentes gauchescos y enfoques de interpretación ya publicados.',href:'/biblioteca-critica/',imagen:'/media/fotografias-v3/biblioteca-critica.webp'},
{grupo:'CRÍTICA LITERARIA',titulo:'Exégesis de Martín Fierro',descripcion:'Análisis de la voz narrativa, los episodios y su contexto literario.',href:'/exegesis/',imagen:'/media/fotografias-v3/exegesis.webp'},
{grupo:'CRÍTICA LITERARIA',titulo:'La vuelta: lecturas críticas',descripcion:'Estudio de la segunda parte y sus nuevas voces.',href:'/exegesis/la-vuelta/',imagen:'/media/fotografias-v3/la-vuelta.webp'},
{grupo:'CONSEJOS Y LENGUAJE',titulo:'Consejos de Martín Fierro a sus hijos',descripcion:'Lectura de los consejos vinculada directamente a los pasajes originales.',href:'/consejos-martin-fierro/',imagen:'/media/fotografias-v3/consejos-fogon-hijos.webp'},
{grupo:'CONSEJOS Y LENGUAJE',titulo:'Buscar palabras en los versos',descripcion:'Localizá expresiones del texto original y comprobá su contexto.',href:'/buscar/',imagen:'/media/fotografias-v3/archivo-documental-recreacion.webp'},
{grupo:'HISTORIA Y CULTURA',titulo:'Revista cultural',descripcion:'Investigaciones sobre gauchos, fortines, pulperías, frontera y tradición.',href:'/revista/',imagen:'/media/fotografias-v3/revista-cultural.webp'},
{grupo:'HISTORIA Y CULTURA',titulo:'Cultura gauchesca',descripcion:'Mate, objetos, costumbres y vida rural explicados en la guía existente.',href:'/cultura-gauchesca/',imagen:'/media/fotografias-v3/revista-cultural.webp'},
{grupo:'HISTORIA Y CULTURA',titulo:'Archivo documental',descripcion:'Fuentes históricas y materiales de investigación diferenciados de las recreaciones.',href:'/archivo/',imagen:'/media/fotografias-v3/archivo-documental-recreacion.webp'}
];
const grupos=['LECTURA Y ESTUDIO','CRÍTICA LITERARIA','CONSEJOS Y LENGUAJE','HISTORIA Y CULTURA'];
---
<Base pageType="CollectionPage" title="Biblioteca popular de Martín Fierro: guías y estudios" description="Consultá la biblioteca de Martín Fierro con guías para estudiantes, personajes, análisis literario y enlaces al poema completo y sus dos partes originales.">
<article class="mf-popular">
<nav class="mf-crumb" aria-label="Ruta de navegación"><a href="/">Inicio</a> / Biblioteca popular</nav>
<header><p class="eyebrow">BIBLIOTECA DE CONSULTA · ESPAÑOL</p><h1>Biblioteca popular de Martín Fierro</h1><p class="lead">Un punto de entrada a las guías, estudios, investigaciones y recursos ya publicados. Organizamos lo existente sin alterar su contenido ni confundirlo con el poema original.</p><p><a href="/leer/">Leer el poema completo</a> · <a href="/buscar-documentos/">Buscar documentos</a> · <a href="/indice-general/">Índice completo del sitio</a></p></header>
<nav class="mf-popular-jumps" aria-label="Explorar colecciones">{grupos.map((grupo,i)=><a href={`#coleccion-${i+1}`}>{grupo.replace('CRÍTICA','Crítica').toLowerCase()}</a>)}</nav>
{grupos.map((grupo,i)=><section id={`coleccion-${i+1}`} aria-label={grupo}><h2>{grupo}</h2><div class="mf-popular-grid">{secciones.filter(s=>s.grupo===grupo).map(s=><a class="mf-popular-card" href={s.href}><img src={s.imagen} alt="" width="640" height="400" loading="lazy" decoding="async"/><div><small>{s.grupo}</small><h3>{s.titulo}</h3><p>{s.descripcion}</p><span>Explorar recurso →</span></div></a>)}</div></section>)}
<section class="mf-popular-note"><h2>Qué contiene esta biblioteca</h2><p>Este directorio reúne páginas reales del proyecto. Los comentarios literarios pertenecen a sus páginas de origen y no se reproducen aquí. La Biblioteca crítica continúa siendo una colección especializada; la Revista mantiene sus artículos independientes; las fichas para estudiantes conservan su carácter pedagógico.</p><p>Las páginas dedicadas a comparaciones de consejos, glosarios y otros temas específicos se incorporarán como artículos independientes únicamente cuando su contenido español esté revisado y verificado.</p></section>
</article>
<style>
.mf-popular{max-width:1170px;margin:0 auto 80px;padding:0 15px}.mf-crumb{font:.83rem system-ui,sans-serif;margin-bottom:30px}.mf-popular header{margin:25px 0 30px}.mf-popular h1{max-width:none!important}.mf-popular a{color:#864531;text-underline-offset:4px}.mf-popular-jumps{display:flex;gap:10px 20px;flex-wrap:wrap;border-block:1px solid #d0bca7;padding:15px 0}.mf-popular-jumps a{text-transform:capitalize;font:700 .88rem system-ui,sans-serif}.mf-popular section{margin:45px 0}.mf-popular h2{font:600 clamp(1.7rem,3vw,2.35rem) Georgia,serif;text-transform:capitalize}.mf-popular-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.mf-popular-card{display:block;background:#f1e8dc;text-decoration:none;border-top:3px solid #9c4935}.mf-popular-card img{width:100%;aspect-ratio:8/5;object-fit:cover}.mf-popular-card div{padding:20px}.mf-popular-card small{font:750 .7rem system-ui,sans-serif;color:#89523b}.mf-popular-card h3{font:600 1.4rem/1.25 Georgia,serif;margin:8px 0;color:#302720}.mf-popular-card p{line-height:1.6;color:#584b40}.mf-popular-card span{font-weight:700}.mf-popular-note{border-top:1px solid #cfbaa6}.mf-popular :focus-visible{outline:3px solid #a34d36;outline-offset:3px}@media(max-width:900px){.mf-popular-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:570px){.mf-popular-grid{grid-template-columns:1fr}}
</style>
</Base>