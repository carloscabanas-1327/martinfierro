---
import Base from '../../../layouts/Base.astro';
const voces=[
{voz:'Gaucho',tipo:'Sociedad e identidad',def:'Habitante rural asociado con el trabajo a caballo en la campaña rioplatense. Es también una figura construida por la literatura: el narrador del poema no representa todas las experiencias rurales.',contexto:'La voz de Fierro cuenta su propia historia, no una descripción imparcial de todos los gauchos.',ruta:'/leer/ida/1/'},
{voz:'Payada',tipo:'Poesía oral',def:'Forma de canto versificado que puede organizarse como improvisación y contrapunto entre dos cantores.',contexto:'La confrontación entre Fierro y el Moreno incluye preguntas sobre conocimiento y experiencia; es una escena literaria, además de una práctica cultural.',ruta:'/leer/vuelta/30/'},
{voz:'Payador',tipo:'Poesía oral',def:'Cantor que realiza una payada; su destreza incluye la palabra, el ritmo y la respuesta a otro cantor.',contexto:'No equivale simplemente a cualquier músico o guitarrista.',ruta:'/leer/vuelta/30/'},
{voz:'Pulpería',tipo:'Vida rural',def:'Almacén de campaña y punto de encuentro donde podían realizarse compras, conversaciones y reuniones.',contexto:'El espacio público rural aparece también como escenario de conflictos, y no debe reducirse a la idea moderna de un bar.',ruta:'/revista/pulperias-y-sociabilidad/'},
{voz:'Fortín',tipo:'Frontera',def:'Puesto militar de frontera, generalmente de pequeña escala, relacionado con el despliegue de tropas y la vigilancia territorial.',contexto:'El servicio forzoso que describe Fierro debe distinguirse de la historia documentada de cada establecimiento real.',ruta:'/revista/vida-en-los-fortines/'},
{voz:'Leva',tipo:'Política y sociedad',def:'Reclutamiento forzoso de hombres para el servicio militar.',contexto:'Ayuda a comprender la separación del protagonista de su trabajo y su familia.',ruta:'/leer/ida/3/'},
{voz:'Partida',tipo:'Justicia y autoridad',def:'Grupo enviado a cumplir una misión; según el contexto, una patrulla armada que persigue a alguien.',contexto:'Cruz participa de la partida que busca a Fierro antes de decidir defenderlo.',ruta:'/leer/ida/9/'},
{voz:'Facón',tipo:'Objetos y costumbres',def:'Cuchillo largo vinculado a la cultura rural; puede utilizarse como herramienta y como arma.',contexto:'Reconocer un objeto histórico no significa justificar las peleas que narra el poema.',ruta:'/cultura-gauchesca/'},
{voz:'Mate',tipo:'Objetos y costumbres',def:'Infusión preparada con yerba mate; el nombre también designa el recipiente utilizado para beberla.',contexto:'Su importancia cultural depende de prácticas cotidianas y de sociabilidad que varían entre lugares y épocas.',ruta:'/cultura-gauchesca/'},
{voz:'Bombilla',tipo:'Objetos y costumbres',def:'Tubo para beber mate, provisto de un filtro en uno de sus extremos.',contexto:'Es distinto del recipiente y de la yerba utilizada para la infusión.',ruta:'/cultura-gauchesca/'},
{voz:'Cebar',tipo:'Objetos y costumbres',def:'Preparar y servir sucesivamente el mate, normalmente agregando agua al recipiente.',contexto:'La palabra tiene otros usos en español; aquí interesa el significado de la práctica cultural.',ruta:'/cultura-gauchesca/'},
{voz:'Poncho',tipo:'Vestimenta rural',def:'Prenda amplia, generalmente tejida, que se coloca sobre los hombros como protección o abrigo.',contexto:'La vestimenta rural cambió con el tiempo y no fue uniforme en todas las regiones.',ruta:'/cultura-gauchesca/'},
{voz:'Chiripá',tipo:'Vestimenta rural',def:'Prenda de tela ceñida o sujetada alrededor de la cintura, propia de determinadas formas históricas de vestir en el Río de la Plata.',contexto:'No debe confundirse con todos los tipos posteriores de pantalón de campo.',ruta:'/cultura-gauchesca/'},
{voz:'Bombachas',tipo:'Vestimenta rural',def:'Pantalones amplios asociados a ciertas tradiciones de vestimenta y equitación regional.',contexto:'La palabra tiene significados distintos según el país y la época.',ruta:'/cultura-gauchesca/'},
{voz:'Pingo',tipo:'Caballo y viaje',def:'Designación familiar o expresiva de un caballo, común en diferentes usos rioplatenses.',contexto:'Los matices concretos se determinan por el verso y por la voz que lo emplea.',ruta:'/buscar/'},
{voz:'Recado',tipo:'Caballo y viaje',def:'Conjunto o disposición de elementos usados para ensillar y montar; su forma y denominaciones pueden variar.',contexto:'No se trata de un mensaje o encargo cuando aparece referido a equipo de montar.',ruta:'/cultura-gauchesca/'},
{voz:'Paisano',tipo:'Sociedad e identidad',def:'Persona del campo o de la misma tierra; en el habla puede funcionar también como tratamiento cercano.',contexto:'No tiene exactamente el mismo alcance en todos los contextos.',ruta:'/leer/ida/2/'},
{voz:'Picardía',tipo:'Personajes y lengua',def:'Astucia, viveza o travesura; puede aludir tanto a ingenio como a engaño según el contexto.',contexto:'Picardía es también el nombre con que se identifica al hijo de Cruz en el poema. Su apodo no convierte todas sus acciones en un juicio moral uniforme.',ruta:'/personajes/#picardia'},
{voz:'Naides',tipo:'Lengua representada',def:'Forma popular empleada en la poesía gauchesca por «nadie».',contexto:'La grafía pertenece a la representación literaria del habla y se conserva tal como aparece en el poema.',ruta:'/consejos-martin-fierro/'},
{voz:'Vigüela',tipo:'Lengua y música',def:'Grafía tradicional o popular relacionada con «vihuela», instrumento de cuerdas.',contexto:'La palabra del verso inicial presenta la voz del cantor; no se moderniza en el texto original.',ruta:'/leer/ida/1/'}
];
const grupos=[...new Set(voces.map(v=>v.tipo))];
---
<Base pageType="CollectionPage" title="Glosario gauchesco de Martín Fierro: 20 palabras explicadas" description="Glosario en español de 20 palabras gauchescas, históricas y literarias del universo de Martín Fierro, con explicaciones y enlaces a fuentes internas.">
<article class="mf-glosario">
<nav class="migajas" aria-label="Ruta de navegación"><a href="/">Inicio</a> / <a href="/biblioteca/">Biblioteca popular</a> / Glosario gauchesco</nav>
<header><p class="eyebrow">BIBLIOTECA POPULAR · VOCABULARIO Y CULTURA</p><h1>Glosario gauchesco de Martín Fierro</h1><p class="lead">Veinte términos de la vida rural, la lengua representada, la poesía y la historia que ayudan a leer la obra sin modernizar sus versos.</p><p>Estas definiciones son explicaciones editoriales: no se atribuyen a José Hernández ni sustituyen una consulta al contexto. Cuando una voz puede tener varios significados, su sentido se decide leyendo el pasaje completo.</p></header>
<nav class="saltos" aria-label="Ir a un término">{voces.map(v=><a href={`#voz-${voces.indexOf(v)+1}`}>{v.voz}</a>)}</nav>
{grupos.map(g=><section class="grupo"><h2>{g}</h2><div class="tarjetas">{voces.filter(v=>v.tipo===g).map(v=><article id={`voz-${voces.indexOf(v)+1}`}><h3>{v.voz}</h3><p>{v.def}</p><p class="contexto"><strong>Para leerlo:</strong> {v.contexto}</p><a href={v.ruta}>Consultar el contexto en el sitio →</a></article>)}</div></section>)}
<section class="fuentes"><h2>Cómo usar este glosario</h2><p>Los términos proceden de los recursos de vocabulario ya desarrollados por la edición inglesa y de aclaraciones españolas existentes, reorganizados para el lector del texto original. Algunas palabras describen la cultura gauchesca aunque no se afirma aquí que cada una aparezca literalmente en el poema. Para verificar la presencia exacta de una voz, utilizá el <a href="/buscar/">buscador de los 7.210 versos</a>. Para contexto histórico, consultá <a href="/cultura-gauchesca/">Cultura gauchesca</a> y la <a href="/revista/">Revista</a>.</p></section>
</article>
<style>
.mf-glosario{max-width:1120px;margin:0 auto 75px;padding:0 16px}.mf-glosario a{color:#80442e;text-underline-offset:3px}.mf-glosario .migajas{font:.83rem system-ui,sans-serif;margin:0 0 30px}.mf-glosario h1{max-width:none!important}.mf-glosario header{padding:15px 0 20px}.mf-glosario header p{max-width:80ch}.mf-glosario .saltos{display:flex;flex-wrap:wrap;gap:10px 17px;padding:18px 0;border-block:1px solid #c6b39f}.mf-glosario .saltos a{font:700 .83rem system-ui,sans-serif}.mf-glosario .grupo{margin:42px 0}.mf-glosario h2{font:600 clamp(1.75rem,3vw,2.4rem)/1.2 Georgia,serif}.mf-glosario .tarjetas{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.mf-glosario .tarjetas article{background:#f2e9dd;padding:24px;border-top:3px solid #9e543d;min-width:0;scroll-margin-top:24px}.mf-glosario .tarjetas h3{font:600 1.6rem Georgia,serif;margin:0 0 12px}.mf-glosario .tarjetas p{line-height:1.65}.mf-glosario .contexto{color:#53483f}.mf-glosario .fuentes{border-top:1px solid #c6b39f;padding-top:20px}.mf-glosario :focus-visible{outline:3px solid #a34d36;outline-offset:3px}@media(max-width:700px){.mf-glosario .tarjetas{grid-template-columns:1fr}}
</style>
</Base>