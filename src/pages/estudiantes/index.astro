---
import Base from '../../layouts/Base.astro';
import {partes,enlaceCanto} from '../../lib/corpus';
import {personajes} from '../../data/personajes';
import {enlacePersonaje} from '../../data/personajes-seo';
const partesEstudio=[{clave:'ida' as const,nombre:'El gaucho Martín Fierro',anio:'1872'},{clave:'vuelta' as const,nombre:'La vuelta de Martín Fierro',anio:'1879'}];
---
<Base pageType="CollectionPage" title="Martín Fierro para estudiantes: análisis, cantos y personajes" description="Recursos para estudiar Martín Fierro: lectura de los 46 cantos, análisis textual, personajes, temas y ejercicios basados en el poema original.">
<article class="mf-students">
 <nav class="mf-crumb" aria-label="Ruta de navegación"><a href="/">Inicio</a> / Para estudiantes</nav>
 <header><p class="eyebrow">BIBLIOTECA EDUCATIVA · EDICIÓN ESPAÑOLA</p><h1>Martín Fierro para estudiantes</h1><p class="lead">Una guía de estudio para comprender las dos partes del poema sin perder de vista las palabras de José Hernández. Explorá los cantos, distinguí las voces narrativas, conocé a los personajes y trabajá con pasajes originales verificables.</p></header>
 <nav class="mf-student-top" aria-label="Secciones de estudio"><a href="#analisis">Análisis de los cantos</a><a href="#personajes">Personajes</a><a href="#herramientas">Herramientas de lectura</a></nav>
 <section id="metodo"><h2>Cómo estudiar la obra</h2><div class="mf-student-grid"><div><h3>Leer el texto</h3><p>Ubicá el canto, reconocé quién habla y consultá la estrofa en el lector original.</p></div><div><h3>Analizar la voz</h3><p>Diferenciá el relato de Fierro, las voces de otros personajes y las decisiones del autor.</p></div><div><h3>Interpretar con pruebas</h3><p>Relacioná temas, contexto y personajes citando cantos y versos concretos.</p></div></div></section>
 <section id="personajes"><p class="eyebrow">GUÍA ILUSTRADA · PERSONAJES</p><h2>Quién es quién en Martín Fierro</h2><p>Los once perfiles documentales explican la función de cada personaje y enlazan a los pasajes del poema. El Moreno de la payada no es el hombre que Fierro mata en La ida; tampoco toda opinión del protagonista representa la postura de Hernández.</p><div class="mf-student-grid">{personajes.map(p=><article><h3><a href={enlacePersonaje(p.id)}>{p.nombre}</a></h3><p>{p.tipo}</p><p><a href={`/leer/${p.estrofa.parte}/${p.estrofa.canto}/`}>Canto de referencia →</a></p></article>)}</div><p><a class="mf-student-cta" href="/personajes/">Abrir la guía ilustrada completa de personajes →</a></p></section>
 <section id="analisis"><p class="eyebrow">ESTUDIO CANTO POR CANTO</p><h2>Los 46 cantos de la obra</h2><p>Empezá por el texto original. Cada ficha de estudio incluye preguntas de lectura y estrofas procedentes del corpus, identificadas por número. El comentario literario específico de cada canto se desarrollará y verificará editorialmente antes de presentarlo como análisis definitivo.</p>
 {partesEstudio.map(p=><div class="mf-student-part"><h3>{p.nombre} ({p.anio})</h3><p><a href={`/leer/${p.clave}/`}>Índice del poema original →</a></p><div class="mf-canto-list">{partes[p.clave].cantos.map(c=><article><small>CANTO {c.numero}</small><h4>{c.titulo||`Canto ${c.numero}`}</h4><a href={`/estudiantes/${p.clave}/${c.numero}/`}>Ficha de estudio</a><a href={enlaceCanto(p.clave,c.numero)}>Texto original</a></article>)}</div></div>)}
 </section>
 <section id="herramientas"><h2>Herramientas para estudiar</h2><div class="mf-student-grid"><article><h3>Temas y conflictos</h3><p>Vida gaucha, frontera, autoridad, amistad, familia y consejos.</p><a href="/temas/">Explorar temas →</a></article><article><h3>Interpretación literaria</h3><p>Análisis del narrador, la estructura y la segunda parte.</p><a href="/exegesis/">Ir a exégesis →</a></article><article><h3>Vocabulario y versos</h3><p>Buscá una expresión y verificá en qué canto aparece.</p><a href="/buscar/">Buscar versos →</a></article></div></section>
</article>
<style>
.mf-students{max-width:1150px;margin:0 auto 70px;padding:0 16px}.mf-crumb{font:.83rem system-ui,sans-serif;margin:0 0 25px}.mf-students header{margin:25px 0 40px}.mf-students h1{max-width:100%!important}.mf-students h2{font:600 clamp(1.75rem,3.5vw,2.8rem)/1.15 Georgia,serif}.mf-students h3{font:600 1.35rem/1.3 Georgia,serif}.mf-students a{color:#80402f;text-underline-offset:4px}.mf-students section{margin:50px 0}.mf-student-top{display:flex;flex-wrap:wrap;gap:10px 22px;border-block:1px solid #cbbba8;padding:15px 0}.mf-student-top a{font-weight:700}.mf-student-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.mf-student-grid>article,.mf-student-grid>div{background:#f1e8dc;padding:20px;border-top:3px solid #9d543e}.mf-student-grid p{line-height:1.6}.mf-student-part{margin:30px 0 48px}.mf-canto-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.mf-canto-list article{padding:18px;background:#f0e7da}.mf-canto-list small{font:750 .72rem system-ui,sans-serif;color:#89513b}.mf-canto-list h4{font:600 1.13rem/1.3 Georgia,serif;margin:10px 0}.mf-canto-list a{display:inline-block;margin:6px 12px 0 0}.mf-student-cta{display:inline-block;margin-top:18px;font-weight:700}.mf-students :focus-visible{outline:3px solid #a34d36;outline-offset:3px}@media(max-width:800px){.mf-student-grid,.mf-canto-list{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:520px){.mf-student-grid,.mf-canto-list{grid-template-columns:1fr}}
</style>
</Base>