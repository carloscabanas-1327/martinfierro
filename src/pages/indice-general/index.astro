---
import Base from '../../layouts/Base.astro';
import { partes, enlaceCanto } from '../../lib/corpus';
import { temas } from '../../data/temas';
import { personajes } from '../../data/personajes';
import '../../styles/indice-general.css';
const grupos=[
  {
    "id": "lectura",
    "numero": "01",
    "titulo": "La obra completa",
    "nota": "Los cantos originales y las herramientas de lectura",
    "enlaces": [
      {
        "titulo": "Biblioteca del poema",
        "url": "/leer/",
        "descripcion": "Acceso al lector íntegro de ambas partes."
      },
      {
        "titulo": "El gaucho Martín Fierro · La ida (1872)",
        "url": "/leer/ida/",
        "descripcion": "Primera parte del poema: cantos y versos."
      },
      {
        "titulo": "La vuelta de Martín Fierro (1879)",
        "url": "/leer/vuelta/",
        "descripcion": "Segunda parte: reencuentros, relatos y consejos."
      },
      {
        "titulo": "Consejos de Martín Fierro",
        "url": "/consejos-martin-fierro/",
        "descripcion": "Selección y estudio de las enseñanzas del protagonista."
      },
      {
        "titulo": "Buscar palabras y versos",
        "url": "/buscar/",
        "descripcion": "Buscador textual de la obra completa."
      }
    ]
  },
  {
    "id": "temas",
    "numero": "02",
    "titulo": "Temas y recorridos",
    "nota": "Guías interpretativas que no alteran la estructura del poema",
    "enlaces": [
      {
        "titulo": "Todos los temas",
        "url": "/temas/",
        "descripcion": "Índice de recorridos temáticos por el poema."
      },
      ...temas.map(t=>({titulo:t.titulo,url:`/temas/${t.slug}/`,descripcion:t.descripcion}))
    ]
  },
  {
    "id": "revista",
    "numero": "03",
    "titulo": "Revista cultural",
    "nota": "Investigaciones y guías independientes, con fuentes",
    "enlaces": [
      {
        "titulo": "Portada de Revista cultural",
        "url": "/revista/",
        "descripcion": "Artículos publicados y recorridos culturales."
      },
      {
        "titulo": "La pulpería: almacén, encuentro y canto",
        "url": "/revista/pulperias-y-sociabilidad/",
        "descripcion": "Estudio de comercio y sociabilidad rural."
      },
      {
        "titulo": "Mate y cultura gauchesca",
        "url": "/cultura-gauchesca/",
        "descripcion": "Guía ilustrada de objetos y costumbres de la campaña."
      },
      {
        "titulo": "Vida cotidiana en los fortines",
        "url": "/revista/vida-en-los-fortines/",
        "descripcion": "Alojamiento, vigilancia y abastecimiento en la frontera."
      },
      {
        "titulo": "Las mujeres fortineras",
        "url": "/revista/mujeres-fortineras/",
        "descripcion": "Experiencias femeninas en los establecimientos fronterizos."
      },
      {
        "titulo": "La frontera y los pueblos indígenas",
        "url": "/revista/frontera-pueblos-indigenas/",
        "descripcion": "Relaciones, acuerdos, territorios y conflictos fronterizos."
      }
    ]
  },
  {
    "id": "estudios",
    "numero": "04",
    "titulo": "Historia, personajes y estudios",
    "nota": "Documentos, biografía y análisis literario",
    "enlaces": [
      {
        "titulo": "José Hernández: biografía documental",
        "url": "/jose-hernandez/",
        "descripcion": "Vida del autor, cronología, manuscritos y fuentes."
      },
      {
        "titulo": "Personajes de Martín Fierro",
        "url": "/personajes/",
        "descripcion": "Guía ilustrada de personajes y sus papeles en la obra."
      },
      ...personajes.map(p=>({titulo:p.nombre,url:`/personajes/#${p.id}`,descripcion:`${p.tipo}. ${p.resumen} ${p.interpretacion} ${p.id==='moreno-muerto'?'negro del baile; negro de la pulpería; hombre negro; afroargentino; afrodescendiente':''} ${p.id==='el-moreno'?'moreno de la payada; payador negro; cantor afroargentino':''}`})),
      {
        "titulo": "Exégesis y claves de lectura",
        "url": "/exegesis/",
        "descripcion": "Interpretación del poema y problemas de su lectura."
      },
      {
        "titulo": "Exégesis de La vuelta",
        "url": "/exegesis/la-vuelta/",
        "descripcion": "Lectura crítica particular de la segunda parte."
      },
      {
        "titulo": "Archivo documental",
        "url": "/archivo/",
        "descripcion": "Materiales históricos, archivos y ejemplares digitalizados."
      },
      {
        "titulo": "Biblioteca crítica",
        "url": "/biblioteca-critica/",
        "descripcion": "Libros y estudios sobre la recepción de Martín Fierro."
      }
    ]
  },
  {
    "id": "ediciones",
    "numero": "05",
    "titulo": "El proyecto y los idiomas",
    "nota": "Información editorial y versiones internacionales",
    "enlaces": [
      {
        "titulo": "Inicio",
        "url": "/",
        "descripcion": "Portada principal y novedades del proyecto."
      },
      {
        "titulo": "Acerca de la edición",
        "url": "/acerca/",
        "descripcion": "Criterios sobre procedencia e integridad del texto."
      },
      {
        "titulo": "El proyecto",
        "url": "/proyecto/",
        "descripcion": "Objetivos y organización editorial."
      },
      {
        "titulo": "Traducciones y referencias",
        "url": "/traducciones/",
        "descripcion": "Sección de idiomas, traducciones y fuentes."
      },
      {
        "titulo": "Español",
        "url": "/es/",
        "descripcion": "Entrada en español."
      },
      {
        "titulo": "English",
        "url": "/en/",
        "descripcion": "Página del proyecto en inglés."
      },
      {
        "titulo": "Português",
        "url": "/pt/",
        "descripcion": "Página del proyecto en portugués."
      },
      {
        "titulo": "Français",
        "url": "/fr/",
        "descripcion": "Página del proyecto en francés."
      },
      {
        "titulo": "Deutsch",
        "url": "/de/",
        "descripcion": "Página del proyecto en alemán."
      },
      {
        "titulo": "Italiano",
        "url": "/it/",
        "descripcion": "Página del proyecto en italiano."
      },
      {
        "titulo": "Latín",
        "url": "/la/",
        "descripcion": "Página del proyecto en latín."
      },
      {
        "titulo": "PMS",
        "url": "/pms/",
        "descripcion": "Ruta de edición internacional conservada en el proyecto; consultar su estado editorial."
      }
    ]
  },
  {
    "id": "legales",
    "numero": "06",
    "titulo": "Información y transparencia",
    "nota": "Datos institucionales y condiciones de consulta",
    "enlaces": [
      {
        "titulo": "Fuentes y derechos",
        "url": "/fuentes-y-derechos/",
        "descripcion": "Atribuciones, procedencia y derechos sobre materiales."
      },
      {
        "titulo": "Privacidad",
        "url": "/privacidad/",
        "descripcion": "Política de privacidad del sitio."
      },
      {
        "titulo": "Términos de uso",
        "url": "/terminos/",
        "descripcion": "Condiciones de acceso y utilización de contenidos."
      },
      {
        "titulo": "Publicidad y afiliados",
        "url": "/publicidad-y-afiliados/",
        "descripcion": "Información sobre publicidad y enlaces comerciales."
      },
      {
        "titulo": "Contacto",
        "url": "/contacto/",
        "descripcion": "Canal de comunicación con el proyecto."
      }
    ]
  }
];
const partesIndice=[{clave:'ida',nombre:'El gaucho Martín Fierro · La ida',anio:1872},{clave:'vuelta',nombre:'La vuelta de Martín Fierro',anio:1879}] as const;
const totalCantos=partesIndice.reduce((n,p)=>n+partes[p.clave].cantos.length,0);
const totalEnlaces=grupos.reduce((n,g)=>n+g.enlaces.length,0)+totalCantos;
const rutas=grupos.flatMap(g=>g.enlaces.map(e=>e.url));
if(new Set(rutas).size!==rutas.length) throw new Error("Enlaces duplicados en el índice general");
---
<Base title="Índice general del sitio — Directorio de contenidos" description="Directorio completo de Martín Fierro: secciones, investigaciones culturales, idiomas, documentos, legales y los 46 cantos de la obra.">
<article class="mf-directorio">
  <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>Índice general</span></nav>
  <header class="mf-directorio-header">
    <p class="mf-directorio-kicker">DIRECTORIO EDITORIAL · MARTINFIERRO.ORG</p>
    <h1>Índice general del sitio</h1>
    <p>Listado temático completo de enlaces del sitio: obra, guías, revista, historia, idiomas, documentación y cada uno de los cantos originales.</p>
    <div class="mf-directorio-stats"><span><strong>06</strong> grandes grupos</span><span><strong>{totalCantos}</strong> cantos</span><span><strong>{totalEnlaces}</strong> accesos organizados</span></div>
  </header>
  <div class="mf-directorio-busqueda"><label for="mf-buscar-directorio">Buscar páginas y cantos de este índice</label><input type="search" id="mf-buscar-directorio" placeholder="Ej.: Carolina, frontera, canto 12, portugués" autocomplete="off"/><p id="mf-buscar-estado" role="status" aria-live="polite">Escribí para buscar enlaces de este índice.</p><ul id="mf-resultados-directos" class="mf-resultados-directos" aria-label="Resultados de la búsqueda" hidden></ul></div>
  <nav class="mf-directorio-atajos" aria-label="Saltar a un grupo del directorio">
    <strong>IR DIRECTAMENTE A</strong>
    {grupos.map(g=><a href={`#${g.id}`}>{g.numero}. {g.titulo}</a>)}
    <a href="#cantos">07. Los 46 cantos</a>
  </nav>
  <div class="mf-directorio-lista">
    {grupos.map(g=><section class="mf-directorio-grupo" id={g.id} aria-labelledby={`titulo-${g.id}`}>
      <header><span class="mf-directorio-numero">{g.numero}</span><div><h2 id={`titulo-${g.id}`}>{g.titulo}</h2><p>{g.nota}</p></div></header>
      <ul>{g.enlaces.map((e,i)=><li data-indice-item data-indice-text={`${e.titulo} ${e.descripcion}`}><span>{String(i+1).padStart(2,'0')}</span><div><a href={e.url}>{e.titulo}</a></div></li>)}</ul>
    </section>)}
  </div>
  <section id="cantos" class="mf-directorio-cantos" aria-labelledby="mf-directorio-cantos-titulo">
    <header><span class="mf-directorio-numero">07</span><div><h2 id="mf-directorio-cantos-titulo">Índice completo de los 46 cantos</h2><p>Cada enlace abre directamente el canto correspondiente en el lector de la obra.</p></div></header>
    <div class="mf-directorio-partes">
      {partesIndice.map(p=><div class="mf-directorio-parte">
        <h3><a href={`/leer/${p.clave}/`}>{p.nombre}</a> <small>{p.anio} · {partes[p.clave].cantos.length} cantos</small></h3>
        <ol>{partes[p.clave].cantos.map(c=><li data-indice-item data-indice-text={`${p.nombre} canto ${c.numero} ${c.titulo ?? ""}`}><a href={enlaceCanto(p.clave,c.numero)}><span>Canto {String(c.numero).padStart(2,'0')}</span>{c.titulo && c.titulo !== `Canto ${c.numero}` && <small>{c.titulo}</small>}</a></li>)}</ol>
      </div>)}
    </div>
  </section>
<script is:inline src="/js/indice-general.js"></script>
  <aside class="mf-directorio-nota"><strong>Sobre este índice.</strong> Este directorio reúne enlaces a páginas y recorridos del proyecto. No confunde los seis temas interpretativos con las divisiones originales del poema. Las futuras investigaciones se agregarán cuando tengan una página publicada y un enlace verificable.</aside>
  <p class="mf-directorio-arriba"><a href="#contenido">↑ Volver al comienzo del directorio</a></p>
</article>
</Base>