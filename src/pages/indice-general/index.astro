const totalCantos=partesIndice.reduce((n,p)=>n+partes[p.clave].cantos.length,0);
const totalEnlaces=grupos.reduce((n,g)=>n+g.enlaces.length,0)+totalCantos;
const rutas=grupos.flatMap(g=>g.enlaces.map(e=>e.url));
if(new Set(rutas).size!==rutas.length) throw new Error("Enlaces duplicados en el índice general");
---
<Base title="Índice general del sitio — Directorio de contenidos" description="Directorio completo de Martín Fierro: secciones, investigaciones culturales, idiomas, documentos, legales y los 46 cantos de la obra.">
<article class="mf-directorio">
  <nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>Índice general</span></nav>
  <header class="mf-directorio-header">
    <p class="mf-directorio-kicker">DIRECTORIO EDITORIAL · MARTINFIERRO.ORG</p>
    <h1>Índice general del sitio</h1>
    <p>Listado temático completo de enlaces del sitio: obra, guías, revista, historia, idiomas, documentación y cada uno de los cantos originales.</p>
    <div class="mf-directorio-stats"><span><strong>06</strong> grandes grupos</span><span><strong>{totalCantos}</strong> cantos</span><span><strong>{totalEnlaces}</strong> accesos organizados</span></div>
  </header>
  <div class="mf-directorio-busqueda"><label for="mf-buscar-directorio">Buscar páginas y cantos de este índice</label><input type="search" id="mf-buscar-directorio" placeholder="Ej.: Carolina, frontera, canto 12, portugués" autocomplete="off"/><p id="mf-buscar-estado" role="status" aria-live="polite">Escribí para buscar enlaces de este índice.</p><ul id="mf-resultados-directos" class="mf-resultados-directos" aria-label="Resultados de la búsqueda" hidden></ul></div>
  <nav class="mf-directorio-atajos" aria-label="Saltar a un grupo del directorio">
    <strong>IR DIRECTAMENTE A</strong>
    {grupos.map(g=><a href={`#${g.id}`}>{g.numero}. {g.titulo}</a>)}
    <a href="#cantos">07. Los 46 cantos</a>
  </nav>
  <div class="mf-directorio-lista">
    {grupos.map(g=><section class="mf-directorio-grupo" id={g.id} aria-labelledby={`titulo-${g.id}`}>
      <header><span class="mf-directorio-numero">{g.numero}</span><div><h2 id={`titulo-${g.id}`}>{g.titulo}</h2><p>{g.nota}</p></div></header>
      <ul>{g.enlaces.map((e,i)=><li data-indice-item data-indice-text={`${e.titulo} ${e.descripcion}`}><span>{String(i+1).padStart(2,'0')}</span><div><a href={e.url}>{e.titulo}</a></div></li>)}</ul>
    </section>)}
  </div>
  <section id="cantos" class="mf-directorio-cantos" aria-labelledby="mf-directorio-cantos-titulo">
    <header><span class="mf-directorio-numero">07</span><div><h2 id="mf-directorio-cantos-titulo">Índice completo de los 46 cantos</h2><p>Cada enlace abre directamente el canto correspondiente en el lector de la obra.</p></div></header>
    <div class="mf-directorio-partes">
      {partesIndice.map(p=><div class="mf-directorio-parte">
        <h3><a href={`/leer/${p.clave}/`}>{p.nombre}</a> <small>{p.anio} · {partes[p.clave].cantos.length} cantos</small></h3>
        <ol>{partes[p.clave].cantos.map(c=><li data-indice-item data-indice-text={`${p.nombre} canto ${c.numero} ${c.titulo ?? ""}`}><a href={enlaceCanto(p.clave,c.numero)}><span>Canto {String(c.numero).padStart(2,'0')}</span>{c.titulo && c.titulo !== `Canto ${c.numero}` && <small>{c.titulo}</small>}</a></li>)}</ol>
      </div>)}
    </div>
  </section>
<script is:inline src="/js/indice-general.js"></script>
  <aside class="mf-directorio-nota"><strong>Sobre este índice.</strong> Este directorio reúne enlaces a páginas y recorridos del proyecto. No confunde los seis temas interpretativos con las divisiones originales del poema. Las futuras investigaciones se agregarán cuando tengan una página publicada y un enlace verificable.</aside>
  <p class="mf-directorio-arriba"><a href="#contenido">↑ Volver al comienzo del directorio</a></p>
</article>
</Base>