---
import Base from '../../../layouts/Base.astro';
const bufen:[string,string][]=[
 ['原诗','何塞·埃尔南德斯的 <em lang="es">El gaucho Martín Fierro</em>（1872）和 <em lang="es">La vuelta de Martín Fierro</em>（1879）属于公有领域。本版的诗句取自全站共用的结构化文本；方法见 <a href="/acerca/" lang="es">Fuentes y método</a> 页面（西班牙语）。'],
 ['中文译本','赵振江的译本（湖南人民出版社，1984；译林出版社修订版，1999）受版权保护，<strong>本版不予转载</strong>。我们提到它，是为了方便读者在图书馆找到它。译者仍然健在，译本将长期受到保护。'],
 ['学习译文','诗句旁边的中文段落（例如<a href="/zh/jiaohui/">父亲的教诲</a>中的译文）是 MARTINFIERRO.ORG 编辑部撰写的散文体学习译文。它们帮助理解；不是文学翻译，也不能取代原文。可以引用为“学习译文，MARTINFIERRO.ORG”。'],
 ['评注与学习卡片','内容概要、解析、讨论题和词汇表是本版编辑部的原创文字。其中始终区分诗本身说了什么和什么属于解读。'],
 ['照片与插图','何塞·埃尔南德斯的历史肖像来自 <a href="https://commons.wikimedia.org/wiki/File:Jos%C3%A9_Hern%C3%A1ndez.jpg">Wikimedia Commons</a>，摄影者不详。高乔人、茅屋和风景的图像是当代数字重现，不是十九世纪的照片，并且始终如此标注。这些图像由出版者指导、借助人工智能工具制作，角落标有“数字重现”字样。人工智能也协助撰写说明文字和核对版本；每一处改动在发布前都经过出版者审核和批准。诗的文本取自所列版本，不作改写。'],
 ['勘误','你发现了错误、可以改进的学习译文，或者关于《马丁·菲耶罗》在中文世界的资料吗？请通过<a href="/contacto/" lang="es">联系页面</a>告诉我们（页面为西班牙语；欢迎用中文来信）。'],
];
---
<Base noindex migas={[{label:'来源与版权'}]} lingue={{es:'/fuentes-y-derechos/',en:'/en/sources-and-rights/',it:'/it/fonti-e-diritti/',pt:'/pt/fontes-e-direitos/',fr:'/fr/sources-et-droits/',de:'/de/quellen-und-rechte/',ru:'/ru/istochniki-i-prava/'}} lang="zh-CN" pageType="WebPage" title="中文版的来源、引用与版权" description="MARTINFIERRO.ORG 中文版中，哪些属于公有领域，哪些受版权保护，哪些是本站的原创评注。">
<article class="banquan-zh"><p class="eyebrow">编辑部说明</p><h1>来源、引用与版权</h1><p class="lid">哪些属于公有领域，哪些受版权保护，哪些是本版自己的评注。</p>{bufen.map(([t,c])=><section><h2>{t}</h2><p set:html={c}/></section>)}<footer><p>本页描述的项目与西班牙语版相同。如有出入，以项目的原始文档为准；任何一个版本都不构成法律意见。</p></footer></article>
<style>.banquan-zh{max-width:900px;margin:28px auto 90px;color:#33291f}.banquan-zh a{color:#86402b;text-underline-offset:4px}.eyebrow{font:750 .8rem/1.55 system-ui,sans-serif;letter-spacing:.12em;color:#95513b}.banquan-zh h1{font:600 clamp(2.2rem,5vw,3.8rem)/1.2 Georgia,serif}.lid{font:1.2rem/1.85 Georgia,serif}.banquan-zh section{padding:22px 0;border-bottom:1px solid #c9b69e}.banquan-zh h2{font:600 1.8rem/1.3 Georgia,serif}.banquan-zh p{font:1.06rem/1.9 Georgia,serif}.banquan-zh footer{background:#efe3d5;padding:22px;margin-top:30px}</style>
</Base>
