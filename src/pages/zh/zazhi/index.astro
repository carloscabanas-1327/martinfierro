---
import Base from '../../../layouts/Base.astro';
const wenzhang=[
 {url:'/zh/zazhi/mate/',yinti:'高乔人的世界 · 拉普拉塔河',biaoti:'马黛茶，潘帕斯的饮品',neirong:'从瓜拉尼人的草叶到耶稣会传教区，从围坐传茶到篝火：一只在众人手中传递的茶具的历史，以及《马丁·菲耶罗》诗句中的苦马黛茶。',tu:'/media/fotografias-v3/mate-pava-yerba.webp',alt:'数字重现：火边的水壶和马黛茶'},
];
---
<Base noindex migas={[{label:'文化杂志'}]} lingue={{es:'/revista/',en:'/en/magazine/',it:'/it/rivista/',pt:'/pt/revista/',fr:'/fr/revue/',de:'/de/magazin/',ru:'/ru/zhurnal/'}} lang="zh-CN" pageType="CollectionPage" title="文化杂志：高乔人与潘帕斯的世界" description="MARTINFIERRO.ORG 中文版文化杂志：马黛茶、潘帕斯的传统，以及何塞·埃尔南德斯诗中的乡村世界。">
<div class="zazhi-zh">
 <header><p class="eyebrow">文化杂志 · 中文</p><h1>为中文读者讲述的高乔人世界</h1><p class="lid">关于阿根廷、乌拉圭和巴西南部之间潘帕斯乡村文化的文章，为中文读者撰写，每篇都注明来源。</p></header>
 <div class="liebiao">{wenzhang.map(a=><article><a href={a.url}><img src={a.tu} alt={a.alt} loading="lazy" decoding="async"/><div><p class="yinti">{a.yinti}</p><h2>{a.biaoti}</h2><p>{a.neirong}</p><strong>阅读文章 →</strong></div></a></article>)}</div>
 <section class="gengduo"><h2>更多文章正在准备中</h2><p>中文杂志还会陆续增加关于对歌（payada）、乡村杂货酒铺、边境堡垒、阿根廷“传统日”以及拉普拉塔河地区华人社区的文章。在此之前，西班牙语杂志已有几十篇文章，英语杂志也有若干篇。</p><p><a href="/revista/" lang="es">西班牙语文化杂志</a> · <a href="/en/magazine/" lang="en">Cultural magazine（英语）</a> · <a href="/zh/jiaohui/">马丁·菲耶罗对儿子们的教诲</a></p></section>
</div>
<style>.zazhi-zh{max-width:1000px;margin:25px auto 85px;color:#302820}.zazhi-zh a{color:#853d2b;text-underline-offset:4px}.eyebrow{font:750 .76rem system-ui,sans-serif;letter-spacing:.12em;color:#934e35}.zazhi-zh h1{font:600 clamp(2.1rem,5vw,3.8rem)/1.2 Georgia,serif;margin:16px 0;text-wrap:balance}.lid{font:1.2rem/1.85 Georgia,serif;max-width:42em}.liebiao{display:grid;gap:22px;margin:36px 0}.liebiao article{border-top:2px solid #382d25;background:#f3ecdf}.liebiao a{display:grid;grid-template-columns:300px 1fr;gap:24px;text-decoration:none;color:inherit}.liebiao img{width:100%;height:100%;min-height:220px;object-fit:cover}.liebiao div{padding:20px 22px 22px 0}.yinti{font:750 .76rem system-ui,sans-serif;letter-spacing:.08em;color:#8b4731;margin:0}.liebiao h2{font:600 clamp(1.5rem,3vw,2.1rem)/1.3 Georgia,serif;margin:8px 0 10px}.liebiao p:not(.yinti),.gengduo p{font:1.04rem/1.85 Georgia,serif}.liebiao strong{font:700 .88rem system-ui,sans-serif;text-decoration:underline}.gengduo{background:#eee3d7;padding:22px 28px}.gengduo h2{font:600 1.7rem Georgia,serif;margin:0 0 10px}@media(max-width:650px){.liebiao a{grid-template-columns:1fr;gap:0}.liebiao img{height:210px;min-height:0}.liebiao div{padding:16px}.gengduo{padding:18px}}</style>
</Base>
