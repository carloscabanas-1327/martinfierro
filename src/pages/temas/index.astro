---
import Base from '../../layouts/Base.astro';import {temas} from '../../data/temas';
---
<Base title="Explorar por temas"><p class="eyebrow">Guía de lectura</p><h1>Explorar por temas</h1><p class="lead">Recorridos editoriales iniciales para descubrir pasajes y situaciones del poema. No son etiquetas originales de José Hernández.</p>
<div class="cards">{temas.map(t=><a class="card" href={`/temas/${t.slug}/`}><h2>{t.titulo}</h2><p>{t.descripcion}</p></a>)}</div>
</Base>
