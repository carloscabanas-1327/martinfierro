---
import Base from '../../layouts/Base.astro';import {temas} from '../../data/temas';import {partes,enlaceCanto} from '../../lib/corpus';
export function getStaticPaths(){return temas.map(t=>({params:{slug:t.slug},props:{tema:t}}));}
const {tema}=Astro.props as {tema:typeof temas[number]};
---
<Base title={tema.titulo}><nav class="breadcrumbs"><a href="/">Inicio</a><span><a href="/temas/">Temas</a></span><span>{tema.titulo}</span></nav>
<p class="eyebrow">Recorrido temático</p><h1>{tema.titulo}</h1><p class="lead">{tema.descripcion}</p>
<div class="notice">Selección editorial orientativa de cantos. No constituye una clasificación exhaustiva ni una interpretación definitiva.</div>
<h2>Pasajes para leer</h2><div class="cards">
{tema.pasajes.map(p=><a class="card" href={enlaceCanto(p.parte,p.canto)}><p class="eyebrow">{partes[p.parte].descripcion}</p><h3>Canto {p.canto}</h3><p>{partes[p.parte].nombre}</p></a>)}
</div>
</Base>
