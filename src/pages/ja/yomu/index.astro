---
import Base from '../../../layouts/Base.astro';
import {estrofasDeCanto,partes,numeroDeVersos} from '../../../lib/corpus';
import {boutouJa,boutouGoi,jaKansuji} from '../../../data/ja-gakushu';
const boutou=estrofasDeCanto('ida',1).slice(0,3);
const zengyou=numeroDeVersos('ida')+numeroDeVersos('vuelta');
const kisoku=[
 ['güeno, güen, gúenas','bueno, buenas','よい。田舎の人は「bu」を「gü」と発音する。'],
 ['juí, juego, ajuera','fui, fuego, afuera','行った（…だった）、火、外。「f」が息の強い「j」に変わる。'],
 ['naides, ansí, ansina','nadie, así','誰も…ない、このように。'],
 ['dende, pa, ande','desde, para, donde','…から、…のために、どこで。'],
 ['sentao, desgraciao','sentado, desgraciado','座った、不運な。話し言葉と同じく、母音にはさまれた「d」が落ちる。'],
 ['estraño, esperencia','extraño, experiencia','奇妙な、経験。書き言葉の「x」が単純な「s」になる。'],
];
const nisemono=[
 ['rato','しばらく、少しのあいだ（ネズミ ratón ではない）'],
 ['pelear','けんかする、戦う'],
 ['china','田舎の男の連れ合い、妻（「中国」China とは無関係）'],
 ['pago','ふるさと、生まれた土地（「支払い」ではない）'],
 ['flete, pingo','よい馬、大切な馬（「運賃」ではない）'],
 ['facón','ガウチョの大型ナイフ'],
 ['pulpería','田舎の雑貨酒場。人が集まり、けんかもよく起こる場所'],
 ['picardía','ずる賢さ、悪知恵'],
];
const bu=[
 {parte:'ida' as const,midashi:'第一部 · El gaucho Martín Fierro（1872）',honbun:'フィエロは、小屋での幸せな暮らし、辺境への強制徴兵、脱走、お尋ね者の暮らし、クルス軍曹との友情を歌います。最後に二人は辺境を越え、先住民のもとで暮らそうと旅立ちます。'},
 {parte:'vuelta' as const,midashi:'第二部 · La vuelta de Martín Fierro（1879）',honbun:'フィエロは戻ってきて息子たちと再会し、クルスの息子にも出会います。一人ひとりが自分の物語を語ります。老ビスカーチャ、モレーノとの歌比べ、そして第三十二歌の息子たちへの教えがあります。'},
];
---
<Base noindex migas={[{label:'原詩を読む'}]} lingue={{es:'/leer/',en:'/en/reader/',it:'/it/lettore/',pt:'/pt/ler-o-poema/',fr:'/fr/lire-le-poeme/',de:'/de/das-gedicht-lesen/',ru:'/ru/chitat-poemu/',zh:'/zh/yuedu/'}} lang="ja" pageType="CollectionPage" title="『マルティン・フィエロ』をスペイン語の原文で読むには：日本語ガイド" description="日本語の読者が『マルティン・フィエロ』をスペイン語の原文で読むためのガイド：冒頭の連と学習訳、ガウチョ方言のつづりの規則、まぎらわしい言葉、全46歌への入り口。">
<article class="yomu-ja">
<header><p class="eyebrow">原詩を読む · 日本語ガイド</p><h1>『マルティン・フィエロ』を原文で読む</h1><p class="lid">スペイン語を少し学んだ人なら、この詩のかなりの部分がもう読めます。このガイドでは、エルナンデスのつづりがどう変わるのか、どの言葉がまぎらわしいのか、46の歌それぞれにどうたどり着けるのかを説明します。</p></header>
<div class="chuui"><strong>テキストについて：</strong>「原文を読む」のリンクは、ホセ・エルナンデスのスペイン語の原詩、全{zengyou.toLocaleString('ja-JP')}行につながっています。本版では日本語の全訳は掲載しません。既存の日本語訳は著作権で保護されているからです。このページの日本語の文章はすべて、このサイトの編集部による学習訳です。</div>

<section class="boutou" aria-labelledby="ja-boutou"><p class="eyebrow">詩はこう始まる</p><h2 id="ja-boutou" lang="es">«Aquí me pongo a cantar»</h2><p>第一歌の最初の三連です。歌い手は自分の物語を語る前に、即興歌手（パジャドール）が歌い始めるときのように、まず聖人たちに助けを求めます。</p>
{boutou.map(e=><div class="taishou"><blockquote lang="es"><span class="bangou">第{e.numero}連</span>{e.versos.map(v=><span class="gyou">{v.texto}</span>)}</blockquote><div class="yaku"><span class="bangou">学習訳</span><p>{boutouJa[e.numero]}</p>{boutouGoi[e.numero]&&<dl>{boutouGoi[e.numero].map(([w,s])=><><dt lang="es">{w}</dt><dd>{s}</dd></>)}</dl>}</div></div>)}
<p class="tsuzuki"><a href="/leer/ida/1/" lang="es">第一歌の原文を続けて読む →</a></p></section>

<section aria-labelledby="ja-tsuzuri"><h2 id="ja-tsuzuri">田舎のスペイン語：六つの規則</h2><p>エルナンデスは、ブエノスアイレス州のガウチョの話し方に合わせて書きました。つづりは奇妙に見えますが、簡単な規則に従っています。声に出して読んでみてください。たいていの場合、音がどの言葉なのかを教えてくれます。</p>
<table><thead><tr><th scope="col">詩の中のつづり</th><th scope="col">標準のスペイン語</th><th scope="col">日本語</th></tr></thead><tbody>{kisoku.map(([a,b,c])=><tr><td lang="es"><em>{a}</em></td><td lang="es">{b}</td><td>{c}</td></tr>)}</tbody></table></section>

<section aria-labelledby="ja-nise"><h2 id="ja-nise">まぎらわしい言葉</h2><p>教科書で習ったスペイン語のように見えても、詩の中ではまったく別の意味になる言葉があります。</p><dl class="nise">{nisemono.map(([w,s])=><div><dt lang="es">{w}</dt><dd>{s}</dd></div>)}</dl><p>ほかの言葉は<a href="/ja/gakusei/yogo/">ガウチョ用語集</a>をご覧ください。</p></section>

{bu.map(p=><section aria-label={p.midashi}><h2>{p.midashi}</h2><p>{p.honbun}</p><div class="utaichiran">{partes[p.parte].cantos.map(c=><div><strong>第{jaKansuji(c.numero)}歌</strong><a href={`/ja/gakusei/${p.parte}/${c.numero}/`}>学習カード</a><a href={`/leer/${p.parte}/${c.numero}/`} lang="es">原文を読む</a></div>)}</div>{p.parte==='vuelta'&&<p class="susume">第三十二歌から読み始めるのもおすすめです：<a href="/ja/oshie/">父の教え、一連ごとの学習訳つき</a>。</p>}</section>)}

<section class="honyaku" aria-labelledby="ja-honyaku-shousai"><h2 id="ja-honyaku-shousai">『マルティン・フィエロ』の日本語訳</h2><p>国立国会図書館サーチで確認できた日本語訳は二つあります。一つは興村禎吉訳『マルティンフィエロ』（協同組合通信社、1962年、353ページ）で、序文と作者の略伝がついています。もう一つは大林文彦・玉井礼一郎訳『マルティン・フィエロ：パンパスの吟遊ガウチョ』（たまいらぼ、1981年、235ページ）です。どちらの記録からも、全訳か抄訳かは確かめられませんでした。</p><p>大阪外国語大学の『Estudios Hispánicos』第2号（1972年）には、吉田秀太郎による論文「「マルティン・フィエロ」の邦訳と若干の問題点」が載っています。日本語訳を手がかりに原文を読む人には、よい参考になるでしょう。</p><p>これらの翻訳は著作権で保護されているため、本版では転載しません。お手元にあれば、原文と並べて照らし合わせながら読んでください。本版はまさにそのために作られています。</p><p class="shutten">出典：国立国会図書館サーチの書誌記録（<a href="https://ndlsearch.ndl.go.jp/books/R100000002-I000001043626" target="_blank" rel="noopener noreferrer">1962年版</a>、<a href="https://ndlsearch.ndl.go.jp/books/R100000002-I000001502392" target="_blank" rel="noopener noreferrer">1981年版</a>）。吉田秀太郎の論文は大阪大学の機関リポジトリで公開されています（<a href="https://hdl.handle.net/11094/93567" target="_blank" rel="noopener noreferrer">論文のページ</a>）。</p></section>

<section aria-labelledby="ja-inyou"><h2 id="ja-inyou">引用のしかた</h2><p>作者、その部の原題、年、歌、連を書いてください。たとえば：Hernández, <em lang="es">La vuelta de Martín Fierro</em>（1879）、第三十二歌、第1160連。原文を読むページでは、どの連にも固有のアドレスがあるので、そのままコピーできます。本版の学習訳は「学習訳、MARTINFIERRO.ORG」として引用できます。</p></section>
</article>
<style>.yomu-ja{max-width:1050px;margin:28px auto 85px;color:#30271f}.yomu-ja a{color:#83402d;text-underline-offset:4px}.eyebrow{font:750 .78rem system-ui,sans-serif;letter-spacing:.12em;color:#95503a}.yomu-ja h1{font:600 clamp(2.2rem,5vw,4rem)/1.25 Georgia,serif;text-wrap:balance}.yomu-ja h2{font:600 clamp(1.6rem,3vw,2.2rem)/1.3 Georgia,serif}.yomu-ja p,.yomu-ja td,.yomu-ja dd{font:1.06rem/1.85 Georgia,serif}.lid{font-size:1.2rem!important;max-width:42em}.chuui{background:#eee3d5;border-left:4px solid #904b36;padding:22px;font:1rem/1.8 Georgia,serif}.yomu-ja section{margin:44px 0}.boutou{border-block:1px solid #bba995;padding:30px 0}.taishou{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin:18px 0}.taishou blockquote{margin:0;background:#f3ecdf;padding:20px 24px;border-top:2px solid #382d25}.gyou{display:block;font:1.13rem/1.65 Georgia,serif}.bangou{display:block;font:700 .74rem system-ui,sans-serif;letter-spacing:.1em;color:#8b4731;margin-bottom:8px}.yaku{padding:20px 4px}.yaku p{margin:0}.yaku dl{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;margin:12px 0 0;font:.88rem/1.6 system-ui,sans-serif;color:#56483b}.yaku dt{font-style:italic;font-weight:600}.yaku dd{margin:0;font:inherit}.tsuzuki{font:.95rem system-ui,sans-serif!important}table{width:100%;border-collapse:collapse;margin-top:14px}th{font:700 .82rem system-ui,sans-serif;letter-spacing:.06em;text-align:left;border-bottom:2px solid #382d25;padding:8px}td{border-bottom:1px solid #d7c7b4;padding:10px 8px;vertical-align:top}.nise{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 28px}.nise div{border-top:1px solid #d7c7b4;padding-top:8px}.nise dt{font:600 1.05rem Georgia,serif;font-style:italic}.nise dd{margin:2px 0 0}.utaichiran{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.utaichiran div{background:#efe5d8;padding:14px 16px;display:grid;gap:6px}.utaichiran strong{font:700 .95rem system-ui,sans-serif;color:#30271f}.utaichiran a{font:.86rem system-ui,sans-serif}.susume{background:#f0e6d7;border-top:3px solid #aa533c;padding:16px 20px}.honyaku{background:#f6efe5;padding:10px 25px 22px}.shutten{font:.85rem/1.6 system-ui,sans-serif!important;color:#6c5b4a}@media(max-width:750px){.taishou{grid-template-columns:1fr;gap:6px}.utaichiran{grid-template-columns:repeat(2,minmax(0,1fr))}.nise{grid-template-columns:1fr}td,th{padding:8px 4px}.yomu-ja td{font-size:.95rem}}</style>
</Base>
