---
import Base from '../../../layouts/Base.astro';
import ArticleJa from '../../../components/ArticleJa.astro';
const nenpyo=[
 ['1834','11月10日、ペルディエル（Perdriel）に生まれる。現在のブエノスアイレス州ヘネラル・サン・マルティン郡にあたる。'],
 ['1840年代','ブエノスアイレス州の田園で暮らし、働き、牧畜を身につける。'],
 ['1850〜1860年代','政治的・軍事的な争いに加わり、ジャーナリズムの仕事を始める。'],
 ['1863','連邦派の指導者アンヘル・ビセンテ・ペニャロサを描いた『Vida del Chacho』を発表。'],
 ['1869','新聞『El Río de la Plata』を創刊。'],
 ['1871','ロペス・ホルダンの反乱がニャエンベの戦いで敗れたのち、ブラジルのリオグランデ・ド・スル州サンタナ・ド・リヴラメントに亡命。'],
 ['1872','ブエノスアイレスに戻り、『El gaucho Martín Fierro』を発表。'],
 ['1879','『La vuelta de Martín Fierro』を発表。'],
 ['1882','牧場経営の実用書『Instrucción del estanciero』を発表。'],
 ['1886','10月21日、ブエノスアイレスのベルグラーノで死去。']
];
---
<Base noindex migas={[{label:'ホセ・エルナンデス'}]} lingue={{es:'/jose-hernandez/',en:'/en/jose-hernandez/',it:'/it/jose-hernandez/',pt:'/pt/jose-hernandez/',fr:'/fr/jose-hernandez/',de:'/de/jose-hernandez/',ru:'/ru/jose-hernandez/',zh:'/zh/jose-hernandez/'}} lang="ja" pageType="Article" title="ホセ・エルナンデス：『マルティン・フィエロ』の作者の生涯" description="ホセ・エルナンデス（1834〜1886）とはどんな人か。生涯、ジャーナリズム、政治活動、『マルティン・フィエロ』の誕生を、年表と出典つきで紹介します。">
<ArticleJa kicker="アルゼンチン文学 · 確かめた生涯" midashi="ホセ・エルナンデス、<em>『マルティン・フィエロ』の作者</em>"
 ridobun="エルナンデスが描いたアルゼンチンの田園は、遠くから眺めたものではありません。田舎の牧場主、軍人、ジャーナリスト、政治家として、彼はのちに代表作を形づくることになる矛盾を内側から知っていました。"
 gazou="https://upload.wikimedia.org/wikipedia/commons/d/de/Jos%C3%A9_Hern%C3%A1ndez.jpg" alt="ホセ・エルナンデスの歴史的な肖像写真" caption="ホセ・エルナンデスの歴史的な肖像、Wikimedia Commons（撮影者不明）。このサイトの挿絵と違い、これは当時の写真です。"
 shutten={[
  {name:'Biblioteca Virtual Miguel de Cervantes：ホセ・エルナンデス年譜（スペイン語）',url:'https://www.cervantesvirtual.com/portales/jose_hernandez/autor_cronologia/',gengo:'es'},
  {name:'Biblioteca Nacional Mariano Moreno：«10 de noviembre de 1834: nace José Hernández»（スペイン語）',url:'https://www.bn.gob.ar/noticias/10-de-noviembre-de-1834-nace-jose-hernandez',gengo:'es'},
  {name:'このサイトのスペイン語版の作者紹介',url:'/jose-hernandez/',gengo:'es'}
 ]}
 chuki="この記事は日本語版のために書いたものです。日付と書誌情報は上の年譜と照らし合わせて確認しています。">
 <section class="it-scheda" aria-labelledby="ja-gaiyou"><h2 id="ja-gaiyou">プロフィール</h2><dl>
  <div><dt>本名</dt><dd lang="es">José Rafael Hernández y Pueyrredón</dd></div>
  <div><dt>生まれ</dt><dd>1834年11月10日、ペルディエル（ブエノスアイレス州）</dd></div>
  <div><dt>没</dt><dd>1886年10月21日、ベルグラーノ（ブエノスアイレス）</dd></div>
  <div><dt>主な作品</dt><dd><em lang="es">El gaucho Martín Fierro</em>（1872）、<em lang="es">La vuelta de Martín Fierro</em>（1879）</dd></div>
  <div><dt>ほかの著作</dt><dd>新聞記事、<em lang="es">Vida del Chacho</em>、<em lang="es">Instrucción del estanciero</em></dd></div>
 </dl></section>
 <section><h2>ペルディエルから草原へ</h2>
  <p>ホセ・エルナンデスは1834年11月10日、ブエノスアイレス近郊のペルディエルで、父ラファエル・エルナンデスと母イサベル・プエイレドンのあいだに生まれました。当時のアルゼンチンの政治的な分断は抽象的なものではなく、家族にも制度にも日々の暮らしにも入りこんでいました。彼はブエノスアイレスで学びましたが、カマロネスやラグナ・デ・ロス・パドレスのあたりの田園で過ごした年月を通して、農村の働き手たちと知り合い、牧人の技にも親しみました。</p>
  <p>とはいえ、彼を「自分の暮らしを紙に書いたガウチョ」と呼ぶのは正確ではありません。エルナンデスは教育を受けた人であり、活動的な政治家であり、経験を積んだジャーナリストでした。マルティン・フィエロの声は、観察と特定の社会的な視点から生まれた文学的な創造なのです。</p>
 </section>
 <section><h2>政治の争いの中のジャーナリスト</h2>
  <p>彼はブエノスアイレスと地方諸州との争いを生きました。連邦派の考え方、権力闘争、戦争の帰結が彼の道を決めていきます。ジャーナリストになる前には軍事と政治の世界に関わり、ジャーナリストとしては、しばしば権力の中心から遠い人々のために書きました。1869年には新聞 <em lang="es">El Río de la Plata</em> を創刊し、農村の住民が受けている不正を告発しました。のちにはブエノスアイレス州の下院議員、上院議員に選ばれています。</p>
  <p>1871年、リカルド・ロペス・ホルダンの反乱がニャエンベの戦いで敗れると、彼はウルグアイ国境に近いブラジル南部のサンタナ・ド・リヴラメントに亡命し、1872年の初めまでそこにとどまりました。ブエノスアイレスに戻り、「オテル・アルヘンティーノ」（Hotel Argentino）に滞在していたときに、<em lang="es">El gaucho Martín Fierro</em> を書き上げたのです。</p>
 </section>
 <section><h2>『マルティン・フィエロ』の誕生</h2>
  <p>1872年、彼は田舎の騎手の口調で語られる物語詩 <em lang="es">El gaucho Martín Fierro</em> を発表しました。1879年には続編 <em lang="es">La vuelta de Martín Fierro</em> が出て、新しい証言が加わり、出会いと教えにもより多くの紙幅が割かれました。二つの部は一緒に読むべきもので、一つのメッセージに還元すべきではありません。そこには抗議、排除、暴力、責任、そして社会への適応が共存しています。</p>
  <p><a href="/ja/yomu/">この詩の読み方 →</a> · <a href="/ja/gakusei/">46歌の学習カード →</a></p>
 </section>
 <section><h2>いまも彼が大切な理由</h2>
  <p>エルナンデスは1886年10月21日にベルグラーノで亡くなりました。のちの世代は彼の詩をアルゼンチンのアイデンティティを支える柱の一つと見なすようになり、彼の誕生日である11月10日は、いまアルゼンチンで「伝統の日」（Día de la Tradición）とされています。彼をしのぶいちばんよい方法は、賛辞を繰り返すことではなく、彼の詩句を注意深く読み、歴史資料と突き合わせることです。</p>
 </section>
 <section><h2>年表</h2><ol class="ja-nenpyo">{nenpyo.map(([a,t])=><li><strong>{a}</strong><span>{t}</span></li>)}</ol></section>
</ArticleJa>
<style>.ja-nenpyo{list-style:none;padding:0}.ja-nenpyo li{display:grid;grid-template-columns:140px 1fr;gap:16px;border-top:1px solid #c8baab;padding:12px 0}.ja-nenpyo strong{color:#8d4b36;font-family:system-ui,sans-serif}@media(max-width:520px){.ja-nenpyo li{grid-template-columns:1fr;gap:2px}}</style>
</Base>
