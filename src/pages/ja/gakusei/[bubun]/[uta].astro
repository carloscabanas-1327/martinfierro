---
import Base from '../../../../layouts/Base.astro';
import {estrofasDeCanto,partes,type Parte} from '../../../../lib/corpus';
import {kaadoIda,type KaadoJa} from '../../../../data/ja-kaado-ida';
import {kaadoVuelta} from '../../../../data/ja-kaado-vuelta';
import {jaKansuji} from '../../../../data/ja-gakushu';
export function getStaticPaths(){
 const p=(parte:Parte,k:Record<number,KaadoJa>)=>Object.keys(k).map(n=>({params:{bubun:parte,uta:n},props:{parte,n:Number(n)}}));
 return [...p('ida',kaadoIda),...p('vuelta',kaadoVuelta)];
}
const {parte,n}=Astro.props as {parte:Parte;n:number};
const k=(parte==='ida'?kaadoIda:kaadoVuelta)[n];
const uta=`第${jaKansuji(n)}歌`;
const sousu=partes[parte].cantos.length;
const sakuhin=parte==='ida'?'El gaucho Martín Fierro':'La vuelta de Martín Fierro';
const nen=partes[parte].anio;
const bassui=estrofasDeCanto(parte,n).filter(e=>k.setsu.includes(e.numero));
const mae=n>1?`/ja/gakusei/${parte}/${n-1}/`:(parte==='vuelta'?'/ja/gakusei/ida/13/':undefined);
const tsugi=n<sousu?`/ja/gakusei/${parte}/${n+1}/`:(parte==='ida'?'/ja/gakusei/vuelta/1/':undefined);
const hoka={en:`/en/students/${parte==='ida'?'canto':'vuelta-canto'}-${n}/`,pt:`/pt/estudantes/${parte==='ida'?'ida':'volta'}/${n}/`,fr:`/fr/etudiants/${parte==='ida'?'aller':'retour'}/${n}/`,de:`/de/studierende/${parte}/${n}/`,ru:`/ru/studentam/${parte}/${n}/`,zh:`/zh/xuesheng/${parte}/${n}/`};
const bu=parte==='ida'?'第一部':'第二部';
---
<Base noindex migas={[{label:'学生のために',href:'/ja/gakusei/'},{label:`${bu}・${uta}`}]} lingue={hoka} lang="ja" pageType="Article" title={`『マルティン・フィエロ』${bu}${uta}：${k.midashi}`} description={`『${sakuhin}』${uta}の日本語のあらすじと解説：原文の連、登場人物、テーマ、ガウチョの言葉、授業で使える問い。`}>
<article class="kaado">
<header><p class="eyebrow">『マルティン・フィエロ』学習カード · {sakuhin.toUpperCase()} · {nen}</p><h1><span>{uta}</span> {k.midashi}</h1><p class="lid">日本語の学習カードです。いつもホセ・エルナンデスの原詩と照らし合わせて読んでください。</p></header>
<section><h2>{uta}のあらすじ</h2><p>{k.arasuji}</p><p><a href={`/leer/${parte}/${n}/`} lang="es">{uta}の原文を全部読む ↗</a></p></section>
<section><h2>原文の詩句：重要な{bassui.length}か所</h2><p>連は原文から取り、現代の表記に直していません。このページの説明は解釈であって、翻訳ではありません。</p>{bassui.map(e=><figure class="ren" lang="es"><figcaption lang="ja">第{e.numero}連</figcaption><blockquote>{e.versos.map(v=><span>{v.texto}</span>)}</blockquote></figure>)}</section>
<section class="futatsu"><div><h2>登場人物と声</h2><p>{k.jinbutsu}</p></div><div><h2>テーマ</h2><p>{k.teema}</p></div></section>
<section><h2>この歌の言葉</h2><dl class="goi">{k.goi.map(([w,s])=><div><dt lang="es">{w}</dt><dd>{s}</dd></div>)}</dl></section>
{k.seidoku&&<section><h2>精読</h2><p>{k.seidoku}</p>{parte==='vuelta'&&n===32&&<p><a href="/ja/oshie/">学習訳つきで教えを一連ずつ読む ↗</a></p>}</section>}
<section><h2>授業と話し合いのための問い</h2><ol>{k.toi.map(q=><li>{q}</li>)}</ol><p>答えるときは、この歌の原文の箇所を根拠にしてください。本文と背景にもとづいていれば、いくつかの異なる解釈がどれも正しいこともあります。</p></section>
<nav class="nabi" aria-label="ほかの歌">{mae?<a href={mae}>← 前の歌</a>:<span></span>}<a href="/ja/gakusei/">すべての歌</a>{tsugi?<a href={tsugi}>次の歌 →</a>:<span></span>}</nav>
<section class="shutten"><h2>出典</h2><p>ホセ・エルナンデス『<span lang="es">{sakuhin}</span>』（{nen}年）、{uta}。このサイトの構造化された原文にもとづく。あらすじ、精読、問い：MARTINFIERRO.ORG 編集部による学習用の解説であり、作者自身の説明ではありません。</p></section>
</article>
<style>.kaado{max-width:850px;margin:25px auto 85px;color:#302820}.kaado a{color:#80402f;text-underline-offset:4px}.eyebrow{font:750 .74rem system-ui,sans-serif;letter-spacing:.1em;color:#945138}.kaado h1{font:600 clamp(2rem,5vw,3.4rem)/1.3 Georgia,serif;margin:15px 0;text-wrap:balance}.kaado h1 span{display:block;font:700 .95rem system-ui,sans-serif;letter-spacing:.12em;color:#8b4731;margin-bottom:10px}.lid{font:1.15rem/1.8 Georgia,serif}.kaado section{margin:36px 0}.kaado h2{font:600 clamp(1.5rem,3vw,2rem)/1.35 Georgia,serif}.kaado p,.kaado li,.kaado dd{font:1.05rem/1.9 Georgia,serif}.kaado li{margin:12px 0}.ren{border-top:1px solid #cab7a2;margin:22px 0;padding:20px;background:#f3ecdf}.ren figcaption{font:.82rem system-ui,sans-serif;color:#74604e}.ren blockquote{margin:12px 0;border-left:3px solid #ac937b;padding-left:17px}.ren span{display:block;font:1.11rem/1.65 Georgia,serif}.futatsu{display:grid;grid-template-columns:1fr 1fr;gap:28px}.futatsu h2{font-size:1.45rem!important}.goi{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 26px}.goi div{border-top:1px solid #d7c7b4;padding-top:8px}.goi dt{font:600 1.05rem Georgia,serif;font-style:italic}.goi dd{margin:0;font-size:.98rem!important;line-height:1.7!important}.nabi{display:flex;justify-content:space-between;gap:12px;border-block:1px solid #c8b9a7;padding:16px 0;font:.92rem system-ui,sans-serif}.shutten{background:#eee4d7;padding:22px 25px}@media(max-width:650px){.futatsu,.goi{grid-template-columns:1fr;gap:12px}.ren{padding:16px}.shutten{padding:18px}}</style>
</Base>
