---
import Base from '../../../layouts/Base.astro';
import {partes} from '../../../lib/corpus';
import {kaadoIda} from '../../../data/ja-kaado-ida';
import {kaadoVuelta} from '../../../data/ja-kaado-vuelta';
import {jaKansuji} from '../../../data/ja-gakushu';
const bu=[
 {bubun:'ida',midashi:'第一部 · El gaucho Martín Fierro（1872）',honbun:'失われた小屋から辺境へ。徴兵、脱走、殺人、クルスとの友情、そして荒野への旅立ち。',uta:partes.ida.cantos.map(c=>({...c,k:kaadoIda[c.numero]}))},
 {bubun:'vuelta',midashi:'第二部 · La vuelta de Martín Fierro（1879）',honbun:'囚われ、捕らわれの女性、息子たちとの再会、老ビスカーチャ、ピカルディア、モレーノとの歌比べ、そして父の教え。',uta:partes.vuelta.cantos.map(c=>({...c,k:kaadoVuelta[c.numero]}))},
];
---
<Base noindex migas={[{label:'学生のために'}]} lingue={{es:'/estudiantes/',en:'/en/students/',it:'/it/studenti/',pt:'/pt/estudantes/',fr:'/fr/etudiants/',de:'/de/studierende/',ru:'/ru/studentam/',zh:'/zh/xuesheng/'}} lang="ja" pageType="CollectionPage" title="『マルティン・フィエロ』各歌のあらすじ：学生のための学習カード" description="『マルティン・フィエロ』全46歌の日本語学習カード：あらすじ、原文の連、登場人物、テーマ、ガウチョの言葉、話し合いのための問い。">
<div class="gakusei-ja">
 <header><p class="eyebrow">学生のために · 日本語の学習カード46枚</p><h1>『マルティン・フィエロ』を一歌ずつ読む</h1><p class="lid">一つの歌に一枚のカード。あらすじ、原文の重要な連、登場人物、テーマ、ガウチョの言葉、そしてスペイン語の授業やレポート、読書会で使える問いをまとめました。</p></header>
 <div class="tsukaikata"><strong>使い方：</strong>まずカードを読み、それからその歌の原文を読んでください（どのページにもリンクがあります）。日本語訳をお持ちなら、原文の横に置いて照らし合わせることもできます。カードは解説であって、詩句の翻訳ではありません。一連ずつの学習訳は<a href="/ja/oshie/">「父の教え」</a>でお読みいただけます。</div>
 {bu.map(b=><section><h2>{b.midashi}</h2><p>{b.honbun}</p><ol class="ichiran">{b.uta.map(c=><li><a href={`/ja/gakusei/${b.bubun}/${c.numero}/`}><span>第{jaKansuji(c.numero)}歌</span><strong>{c.k.midashi}</strong></a></li>)}</ol></section>)}
 <section class="motto"><h2>さらに読む</h2><p><a href="/ja/yomu/">日本語の読者のための原詩の読み方</a> · <a href="/ja/zasshi/mate/">マテ茶、パンパの飲み物</a> · <a href="/ja/gakusei/yogo/">ガウチョ用語集</a> · <a href="/ja/jinbutsu/">登場人物</a></p></section>
</div>
<style>.gakusei-ja{max-width:1000px;margin:25px auto 85px;color:#302820}.gakusei-ja a{color:#853d2b;text-underline-offset:4px}.eyebrow{font:750 .76rem system-ui,sans-serif;letter-spacing:.12em;color:#934e35}.gakusei-ja h1{font:600 clamp(2.1rem,5vw,3.8rem)/1.25 Georgia,serif;margin:16px 0;text-wrap:balance}.lid{font:1.2rem/1.85 Georgia,serif;max-width:42em}.tsukaikata{background:#eee3d5;border-left:4px solid #904b36;padding:20px 22px;font:1rem/1.8 Georgia,serif;margin:28px 0}.gakusei-ja section{margin:40px 0}.gakusei-ja h2{font:600 clamp(1.6rem,3vw,2.2rem)/1.3 Georgia,serif}.gakusei-ja section>p{font:1.05rem/1.85 Georgia,serif}.ichiran{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.ichiran a{display:grid;gap:4px;background:#efe5d8;padding:14px 16px;text-decoration:none;color:#30271f;height:100%}.ichiran span{font:700 .78rem system-ui,sans-serif;letter-spacing:.08em;color:#8b4731}.ichiran strong{font:600 1.04rem/1.5 Georgia,serif}.ichiran a:hover strong{text-decoration:underline}.motto{background:#f3ecdf;padding:20px 24px}@media(max-width:650px){.ichiran{grid-template-columns:1fr}.motto{padding:16px}}</style>
</Base>
