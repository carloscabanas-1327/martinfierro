---
import Base from '../../../layouts/Base.astro';
const artikel=[
 {url:'/de/magazin/mate/',dachzeile:'Die Welt des Gaucho · Río de la Plata',titel:'Mate, das Getränk der Pampa',text:'Vom Kraut der Guaraní zu den Jesuitenmissionen, von der Mate-Runde zum Lagerfeuer: die Geschichte des Gefäßes, das von Hand zu Hand geht, und der bittere Mate in den Versen von Martín Fierro.',bild:'/media/fotografias-v3/mate-pava-yerba.webp',alt:'Digitale Nachbildung eines Wasserkessels und eines Mate am Feuer'},
];
---
<Base migas={[{label:'Magazin'}]} lingue={{es:'/revista/',en:'/en/magazine/',it:'/it/rivista/',pt:'/pt/revista/',fr:'/fr/revue/'}} lang="de-DE" pageType="CollectionPage" title="Kulturmagazin: die Welt des Gaucho und der Pampa" description="Das Kulturmagazin der deutschen Ausgabe von MARTINFIERRO.ORG: Mate, die Traditionen der Pampa und die ländliche Welt im Gedicht von José Hernández.">
<div class="magazin-de">
 <header><p class="eyebrow">KULTURMAGAZIN · AUF DEUTSCH</p><h1>Die Welt des Gaucho, erzählt für deutschsprachige Leser</h1><p class="vorspann">Artikel über die ländliche Kultur der Pampa zwischen Argentinien, Uruguay und Südbrasilien, geschrieben für deutschsprachige Leser und immer mit Quellenangaben.</p></header>
 <div class="liste">{artikel.map(a=><article><a href={a.url}><img src={a.bild} alt={a.alt} loading="lazy" decoding="async"/><div><p class="dachzeile">{a.dachzeile}</p><h2>{a.titel}</h2><p>{a.text}</p><strong>Artikel lesen →</strong></div></a></article>)}</div>
 <section class="mehr"><h2>Weitere Artikel in Vorbereitung</h2><p>Das deutsche Magazin wird um Texte über die payada, die pulpería, die Grenzforts, den argentinischen Tag der Tradition und die deutschsprachigen Einwanderer am Río de la Plata wachsen. Bis dahin umfasst das spanische Magazin bereits Dutzende Artikel, und auch das englische bietet einige an.</p><p><a href="/revista/" lang="es">Kulturmagazin auf Spanisch</a> · <a href="/en/magazine/" lang="en">Cultural magazine (auf Englisch)</a> · <a href="/de/ratschlaege-von-martin-fierro/">Die Ratschläge Martín Fierros an seine Söhne</a></p></section>
</div>
<style>.magazin-de{max-width:1000px;margin:25px auto 85px;color:#302820}.magazin-de a{color:#853d2b;text-underline-offset:4px}.eyebrow{font:750 .72rem system-ui,sans-serif;letter-spacing:.13em;color:#934e35}.magazin-de h1{font:600 clamp(2.3rem,5vw,4.2rem)/1.1 Georgia,serif;letter-spacing:-.03em;margin:16px 0;text-wrap:balance;hyphens:auto}.vorspann{font:1.2rem/1.65 Georgia,serif;max-width:70ch}.liste{display:grid;gap:22px;margin:36px 0}.liste article{border-top:2px solid #382d25;background:#f3ecdf}.liste a{display:grid;grid-template-columns:300px 1fr;gap:24px;text-decoration:none;color:inherit}.liste img{width:100%;height:100%;min-height:220px;object-fit:cover}.liste div{padding:20px 22px 22px 0}.dachzeile{font:750 .7rem system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#8b4731;margin:0}.liste h2{font:600 clamp(1.6rem,3vw,2.2rem)/1.15 Georgia,serif;margin:8px 0 10px}.liste p:not(.dachzeile),.mehr p{font:1.04rem/1.7 Georgia,serif;hyphens:auto}.liste strong{font:700 .84rem system-ui,sans-serif;text-decoration:underline}.mehr{background:#eee3d7;padding:22px 28px}.mehr h2{font:600 1.7rem Georgia,serif;margin:0 0 10px}@media(max-width:650px){.liste a{grid-template-columns:1fr;gap:0}.liste img{height:210px;min-height:0}.liste div{padding:16px}.mehr{padding:18px}}</style>
</Base>
