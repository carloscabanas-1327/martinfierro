---
import Base from '../../../../layouts/Base.astro';
import ArticleDe from '../../../../components/ArticleDe.astro';
// Wenn es ein nahes deutsches Wort gibt, wird es angegeben (»Auf Deutsch«).
const eintraege:{wort:string;art:string;sinn:string;gedicht:string;deutsch?:string;url:string}[]=[
 {wort:'Gaucho',art:'Historischer und kultureller Begriff',sinn:'Reiter der Ebenen Argentiniens, Uruguays und Südbrasiliens.',gedicht:'Das Wort verweist auf Arbeit, Geschick, eine soziale Stellung und eine umstrittene literarische Identität. Fierro spricht als Gaucho, nicht im Namen aller Gauchos.',url:'/de/das-gedicht-lesen/'},
 {wort:'Payada',art:'Mündliche Dichtung und Musik',sinn:'Gesungene, improvisierte Dichtung vom Río de la Plata, oft als Wettstreit zweier Sänger mit Gitarre.',gedicht:'Der Moreno und Fierro messen sich in einer payada, die eine ungelöste Gewalttat wieder aufreißt.',deutsch:'Sängerwettstreit',url:'/de/studierende/vuelta/30/'},
 {wort:'Pulpería',art:'Ländliche Einrichtung',sinn:'Kramladen mit Ausschank und Treffpunkt auf dem Land, wo man Vorräte kaufte, trank und manchmal sang.',gedicht:'Mehrere Raufereien des Gedichts spielen an solchen Orten.',deutsch:'Dorfladen mit Schänke',url:'/de/studierende/ida/8/'},
 {wort:'Fortín',art:'Grenzeinrichtung',sinn:'Kleiner Militärposten an der Grenze zu den indigenen Gebieten.',gedicht:'Fierro beschreibt dort das Elend und die Ausbeutung während seines Dienstes.',deutsch:'Grenzfort, Schanze',url:'/de/studierende/ida/4/'},
 {wort:'Leva',art:'Militärischer und politischer Begriff',sinn:'Zwangsweise Aushebung von Männern für den Militärdienst.',gedicht:'Sie erklärt, warum die Grenze Fierros Familienleben zerstört.',deutsch:'Aushebung',url:'/de/studierende/ida/3/'},
 {wort:'Partida',art:'Bewaffnete Gruppe',sinn:'Für einen Auftrag gebildete Streife; im Gedicht fast immer die Truppe, die jemanden verfolgt.',gedicht:'Cruz gehört zur Streife, die Fierro jagt, bevor er ihn verteidigt.',deutsch:'Streife',url:'/de/studierende/ida/9/'},
 {wort:'Facón',art:'Materielle Kultur',sinn:'Großes Messer, das mit dem historischen Gaucho verbunden wird.',gedicht:'Die Messerkämpfe sind nicht als Lob der Gewalt zu lesen.',url:'/de/studierende/ida/7/'},
 {wort:'Mate, cimarrón',art:'Getränk',sinn:'Aufguss aus Yerba Mate; das Wort bezeichnet auch das Gefäß, aus dem man ihn trinkt. Cimarrón ist der bittere Mate ohne Zucker.',gedicht:'Fierro erinnert sich an den cimarrón, den er vor Tagesanbruch am Feuer trank.',deutsch:'Mate, Matetee',url:'/de/magazin/mate/'},
 {wort:'Pago',art:'Ort',sinn:'Die Heimat, der Herkunftsort.',gedicht:'In den pago zurückzukehren und ihn in Trümmern zu finden, ist einer der härtesten Schläge des ersten Teils.',deutsch:'Heimat',url:'/de/studierende/ida/6/'},
 {wort:'Tapera',art:'Ort',sinn:'Verlassenes oder verfallenes Haus (Wort aus dem Guaraní).',gedicht:'Fierros Hütte ist zur tapera geworden, als er von der Grenze zurückkehrt.',deutsch:'Ruine, verfallene Hütte',url:'/de/studierende/ida/6/'},
 {wort:'Matrero',art:'Soziale Lage',sinn:'Flüchtiger Gaucho, der versteckt lebt, um der Obrigkeit zu entgehen.',gedicht:'Nach seiner Fahnenflucht wird Fierro zum matrero.',deutsch:'Gesetzloser, Vogelfreier',url:'/de/studierende/ida/6/'},
 {wort:'Pingo, flete',art:'Pferd',sinn:'Das gute Pferd, das Lieblingspferd.',gedicht:'Das Pferd ist Gefährte, Fluchtmittel und Zeichen des Ansehens.',url:'/de/studierende/ida/5/'},
 {wort:'China',art:'Bezeichnung',sinn:'Die Gefährtin, die Frau des Mannes vom Land.',gedicht:'Das Wort erscheint in den Bildern des häuslichen Lebens und in den Tanzszenen.',url:'/de/studierende/ida/2/'},
 {wort:'Malón',art:'Grenzbegriff',sinn:'Indigener Überfall auf Estancias und Dörfer an der Grenze.',gedicht:'Fierro und Cruz kommen ins indigene Lager, während ein malón vorbereitet wird.',deutsch:'Überfall, Raubzug',url:'/de/studierende/vuelta/2/'},
 {wort:'Moreno',art:'Historische Bezeichnung',sinn:'Ausdruck der Zeit für einen Menschen mit dunkler Haut; im Gedicht ein afroargentinischer Sänger.',gedicht:'Der Moreno der payada ist nicht der im ersten Teil getötete Mann, sondern dessen Bruder.',url:'/de/studierende/vuelta/30/'},
 {wort:'Viejo Vizcacha',art:'Name einer Figur',sinn:'Viejo heißt »alt«; die Viscacha ist ein Nagetier der Pampa, das in Bauen lebt.',gedicht:'Der Spitzname erinnert an das Tier, das allerlei Gegenstände in seinem Bau anhäuft; der Vergleich ist eine mögliche Lesart, keine Regel.',url:'/de/studierende/vuelta/15/'},
 {wort:'Picardía',art:'Name einer Figur und gängiges Wort',sinn:'List, Schlitzohrigkeit, Gaunerei: je nach Zusammenhang findige Schläue oder Betrug. Falscher Freund: hat mit »Pikanterie« nichts zu tun.',gedicht:'Der Sohn von Cruz behält diesen Spitznamen, auch nachdem er versucht hat, sein Leben zu ändern.',deutsch:'Schlitzohrigkeit',url:'/de/studierende/vuelta/26/'},
 {wort:'Naides',art:'Gaucheske Sprache',sinn:'Volkstümliche Form von »nadie«, niemand.',gedicht:'Die gaucheske Dichtung verwendet solche Formen, um eine erkennbare ländliche Stimme zu schaffen.',url:'/de/das-gedicht-lesen/'},
 {wort:'Canto, estrofa, verso',art:'Literarische Gliederung',sinn:'Der canto ist ein nummerierter Abschnitt, wie ein Kapitel; die estrofa ist eine Gruppe von Versen; der verso ist eine Zeile des Gedichts.',gedicht:'Die beiden Teile haben 13 und 33 Gesänge, fast immer in Sechszeilern aus Achtsilbern.',deutsch:'Gesang, Strophe, Vers',url:'/de/studierende/'},
];
---
<Base migas={[{label:'Für Studierende',href:'/de/studierende/'},{label:'Glossar'}]} lingue={{en:'/en/students/glossary/',it:'/it/studenti/glossario/',pt:'/pt/estudantes/glossario/',fr:'/fr/etudiants/glossaire/'}} lang="de-DE" pageType="Article" noindex={true} title="Glossar zu Martín Fierro: die gauchesken Wörter erklärt" description="Glossar für Studierende von Martín Fierro: payada, pulpería, fortín, facón, leva, pago, tapera, Vizcacha, Picardía und weitere Wörter des Gedichts, auf Deutsch erklärt.">
<ArticleDe dachzeile="Für Studierende · Wörter im Zusammenhang" titel="Gauchesker Glossar"
 vorspann="Die Wörter des Gedichts versteht man im Zusammenhang besser als durch ein Wörterbuchäquivalent. Jeder Eintrag erklärt die Bedeutung, die Rolle des Wortes in Martín Fierro und, wo es eines gibt, das nächstliegende deutsche Wort."
 quellen={[{name:'Diccionario de americanismos (ASALE), auf Spanisch',url:'https://www.asale.org/damer/',sprache:'es'},{name:'Gaucho glossary, englische Ausgabe',url:'/en/students/glossary/',sprache:'en'}]}
 quellenHinweis="Die Definitionen sind Erklärungen für den Leser und ersetzen nicht die Verse von Hernández.">
 <dl class="de-glossar">{eintraege.map(v=><div><dt lang="es">{v.wort}</dt><dd><p class="de-art">{v.art}</p><p><strong>Bedeutung:</strong> {v.sinn}</p><p><strong>Im Gedicht:</strong> {v.gedicht}</p>{v.deutsch&&<p><strong>Auf Deutsch:</strong> {v.deutsch}</p>}<p><a href={v.url}>Mehr dazu →</a></p></dd></div>)}</dl>
</ArticleDe>
<style>.de-glossar{display:grid;gap:0;margin:0}.de-glossar>div{display:grid;grid-template-columns:200px 1fr;gap:20px;border-top:1px solid #c8baab;padding:18px 0}.de-glossar dt{font:600 1.3rem Georgia,serif;font-style:italic}.de-glossar dd{margin:0;hyphens:auto}.de-glossar dd p{margin:0 0 6px}.de-art{font:700 .7rem system-ui,sans-serif!important;letter-spacing:.1em;text-transform:uppercase;color:#8b4731}@media(max-width:600px){.de-glossar>div{grid-template-columns:1fr;gap:6px}}</style>
</Base>
