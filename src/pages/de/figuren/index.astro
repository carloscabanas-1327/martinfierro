---
import Base from '../../../layouts/Base.astro';
import {personajes} from '../../../data/personajes';
const karten:Record<string,{name:string;rolle:string;beschreibung:string;lektuere:string}>={
 'martin-fierro':{name:'Martín Fierro',rolle:'Der Sänger, Held und Erzähler',beschreibung:'Ein Gaucho, dessen Familienleben nach dem Zwangsdienst an der Grenze zerbricht. Sein Gesang handelt von Unrecht, Gewalt, Flucht, Freundschaft und Wiedersehen.',lektuere:'Fierro ist nicht José Hernández, der ungefiltert spricht. Seine Klagen haben Gewicht, doch auch seine Versuche, Gewalt zu rechtfertigen, müssen geprüft werden.'},
 'sargento-cruz':{name:'Sergeant Cruz',rolle:'Der Sergeant, der die Freundschaft wählt',beschreibung:'Er gehört zur Streife, die Fierro festnehmen soll, wechselt die Seite und kämpft an seiner Seite. Die Solidarität der beiden Männer ist eine der zentralen Beziehungen des Gedichts.',lektuere:'Cruz’ Entscheidung stellt eine Frage der Treue: Was tun, wenn der erhaltene Befehl dem eigenen Gerechtigkeitssinn widerspricht?'},
 'esposa-fierro':{name:'Fierros Frau',rolle:'Die Ehefrau und das verlorene Zuhause',beschreibung:'Zentrale Gestalt des Familienlebens, das Fierro mit der Rekrutierung verliert. Die Nachricht von ihrem Tod erreicht ihn später aus dem Mund seiner Söhne.',lektuere:'Das Gedicht gibt ihr weder eine eigene Stimme noch einen festen Namen, eine Leerstelle, die Aufmerksamkeit verdient.'},
 'primer-hijo':{name:'Der ältere Sohn',rolle:'Der Sohn, der das Gefängnis kennengelernt hat',beschreibung:'Einer der beiden Söhne, die im zweiten Teil ihren Vater wiederfinden. Sein Bericht erweitert die Geschichte der Familie: Verlassenheit, ungerechte Anklage, Zuchthaus.',lektuere:'Seine Erfahrung und seine Stimme dürfen nicht mit denen seines Bruders verwechselt werden.'},
 'segundo-hijo':{name:'Der jüngere Sohn',rolle:'Der Sohn, den Vizcacha großzog',beschreibung:'Zu seiner Geschichte gehören das verlorene Erbe und das Leben unter der Vormundschaft des alten Vizcacha, dessen zynische Ratschläge bittere Komik und Leid verbinden.',lektuere:'Der Gegensatz zwischen Vizcachas Maximen und Fierros letzten Ratschlägen ist entscheidend.'},
 'don-vizcacha':{name:'Der alte Vizcacha',rolle:'Der Vormund und satirische Ratgeber',beschreibung:'Ein armer, schlauer Alter, der zum Vormund von Fierros jüngerem Sohn bestellt wird. Seine grotesken Marotten und eigennützigen Maximen gehören zu den berühmtesten Episoden des zweiten Teils.',lektuere:'Vizcachas Sprichwörter dürfen nicht automatisch für die Moral des Gedichts gehalten werden.'},
 'picardia':{name:'Picardía',rolle:'Der Sohn von Cruz, ein Erzähler',beschreibung:'Ein junger Mann, der von seiner Kindheit als Waise, vom Spiel, vom Machtmissbrauch und vom Grenzdienst erzählt, bis er entdeckt, dass er der Sohn von Sergeant Cruz ist.',lektuere:'Sein Name deutet auf List, doch seine Geschichte zeigt immer wieder den Preis des Überlebens.'},
 'la-cautiva':{name:'Die Gefangene',rolle:'Die bei einem malón verschleppte Frau',beschreibung:'Ihr Leid in der Gefangenschaft und Fierros Eingreifen werden im zweiten Teil aus seiner Sicht erzählt.',lektuere:'Sie hat keinen Namen; die Stelle verlangt eine kritische Lektüre zu Geschlecht und zur Darstellung der Indigenen in jener Zeit.'},
 'el-moreno':{name:'Der Moreno',rolle:'Der schwarze Sänger der payada',beschreibung:'Ein afrostämmiger Sänger fordert Fierro zu einem dichterischen Wettstreit aus Fragen und Antworten heraus und weckt die Erinnerung an einen alten Tod.',lektuere:'Er ist nicht der Mann, den Fierro im ersten Teil tötete, sondern dessen Bruder; und eine einzelne literarische Stimme vertritt nicht eine ganze Bevölkerung.'},
 'moreno-muerto':{name:'Der beim Tanzfest getötete Mann',rolle:'Das Opfer von Gesang VII',beschreibung:'Ein schwarzer Mann stirbt in einer Rauferei mit Fierro. Der Bericht des Erzählers enthält rassistische Beleidigungen, Provokation und Gewalt.',lektuere:'Die Version des Erzählers ist kein Freispruch, und dieses Opfer darf nicht mit dem Sänger der payada verwechselt werden.'},
 'juez-paz':{name:'Der Friedensrichter',rolle:'Die örtliche Obrigkeit',beschreibung:'Gestalt der lokalen Macht im Bericht von Rekrutierung und Verfolgung. Das Amt verweist auf reale Institutionen, die Figur aber ist erfunden.',lektuere:'Nichts erlaubt es, dem Richter des Gedichts eine bestimmte historische Identität zuzuschreiben.'},
};
const bild=(id:string)=>({'martin-fierro':'martin-fierro','sargento-cruz':'sargento-cruz','esposa-fierro':'esposa-de-fierro','primer-hijo':'hijo-mayor-de-fierro','segundo-hijo':'hijo-segundo-de-fierro','don-vizcacha':'viejo-vizcacha','picardia':'picardia','la-cautiva':'la-cautiva','el-moreno':'el-moreno','moreno-muerto':'negro-del-baile','juez-paz':'juez-de-paz'} as Record<string,string>)[id];
const blatt=(r:{parte:'ida'|'vuelta';canto:number})=>`/de/studierende/${r.parte}/${r.canto}/`;
---
<Base migas={[{label:'Figuren'}]} lingue={{es:'/personajes/',en:'/en/characters/',pt:'/pt/personagens/',fr:'/fr/personnages/'}} lang="de-DE" pageType="CollectionPage" noindex={true} title="Die Figuren von Martín Fierro: ein Leitfaden auf Deutsch" description="Martín Fierro, Sergeant Cruz, der alte Vizcacha, Picardía, die Söhne, die Gefangene und der Moreno: Wer sind die Figuren im Gedicht von José Hernández, und wie liest man sie kritisch?">
<article class="figuren-de">
<header><p class="eyebrow">LESELEITFADEN · FIGUREN</p><h1>Die Figuren von <em>Martín Fierro</em></h1><p class="vorspann">Ein flüchtiger Gaucho, ein treuer Freund, zwei Söhne, die ihre Verluste zu verstehen suchen, ein skrupelloser Vormund und Stimmen, die an den Rand gedrängt sind. Lernen Sie die Gestalten kennen, die dem Gedicht seine moralische Vielschichtigkeit geben.</p></header>
<nav class="spruenge" aria-label="Zu einer Figur springen">{personajes.map(p=><a href={`#${p.id}`}>{karten[p.id].name}</a>)}</nav>
<div class="karten">{personajes.map(p=><section class="karte" id={p.id} aria-labelledby={`t-${p.id}`}><figure><img src={`/media/fotografias-v3/${bild(p.id)}.webp`} alt={`Digitale redaktionelle Deutung: ${karten[p.id].name}; kein historisches Porträt`} loading="lazy"/><figcaption>Zeitgenössische digitale Nachbildung</figcaption></figure><div><p class="eyebrow">{karten[p.id].rolle}</p><h2 id={`t-${p.id}`}>{karten[p.id].name}</h2><p>{karten[p.id].beschreibung}</p><p><strong>Kritische Lektüre:</strong> {karten[p.id].lektuere}</p><p class="verweise"><strong>In den Studienblättern:</strong> {p.referencias.map(r=><a href={blatt(r)}>{r.parte==='ida'?'Erster Teil':'Zweiter Teil'} · Gesang {r.canto}</a>)}</p></div></section>)}</div>
<section class="methode"><h2>Wie man diesen Leitfaden nutzt</h2><p>Diese Karten erklären die Rolle von elf Figuren und verweisen auf die Studienblätter zu den einzelnen Gesängen, wo die Originalstrophen stehen. Es sind deutende Zusammenfassungen, keine Zitate und keine Übersetzungen der Verse von Hernández. Die Illustrationen sind moderne Rekonstruktionen, keine historischen Dokumente.</p></section>
</article>
<style>.figuren-de{max-width:1100px;margin:25px auto 80px;color:#31291f}.figuren-de a{color:#843e2c;text-underline-offset:4px}.eyebrow{font:750 .72rem system-ui,sans-serif;letter-spacing:.13em;color:#955138;text-transform:uppercase}.figuren-de h1{font:600 clamp(2.5rem,5vw,4.6rem)/1.08 Georgia,serif;letter-spacing:-.04em;margin:18px 0}.figuren-de h1 em{font-weight:400}.vorspann{font:1.2rem/1.65 Georgia,serif;max-width:75ch}.spruenge{border-block:1px solid #cbb9a5;display:flex;flex-wrap:wrap;gap:10px 17px;padding:19px 0;margin:35px 0;font:.86rem system-ui,sans-serif}.karten{display:grid;gap:30px}.karte{display:grid;grid-template-columns:300px 1fr;gap:30px;border-top:2px solid #382d25;padding-top:24px;scroll-margin-top:70px}.karte figure{margin:0}.karte img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:4px}.karte figcaption{font:.72rem system-ui,sans-serif;color:#74614d;margin-top:6px}.karte h2{font:600 2rem Georgia,serif;margin:6px 0 12px;hyphens:auto}.karte p{font:1.04rem/1.75 Georgia,serif;hyphens:auto}.verweise{display:flex;flex-wrap:wrap;gap:6px 14px;font:.86rem system-ui,sans-serif!important}.methode{background:#efe3d5;padding:22px 26px;margin-top:40px}.methode h2{font:600 1.7rem Georgia,serif;margin:0 0 10px}.methode p{font:1.03rem/1.7 Georgia,serif}@media(max-width:720px){.karte{grid-template-columns:1fr;gap:14px}.karte img{aspect-ratio:3/2}.methode{padding:18px}}</style>
</Base>
