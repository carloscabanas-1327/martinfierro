---
import EditorialSection from '../../../../components/EditorialSection.astro';
import Base from '../../../../layouts/Base.astro';
import '../../../../styles/edizione-italiana.css';
import {partiIt,urlCantoIt,urlCantoOriginale,versiDiCanto,versiDiParte,romano,corrispondenzaCanto,type ParteIt} from '../../../../lib/testena';
export function getStaticPaths(){return (Object.keys(partiIt) as ParteIt[]).map(parte=>({params:{parte},props:{parte}}));}
const {parte}=Astro.props as {parte:ParteIt};
const libro=partiIt[parte];
---
<Base migas={[{label:"Lettore",href:"/it/lettore/"},{label:libro.titolo}]} lang="it-IT" pageType="CollectionPage" title={`${libro.titolo}: indice dei canti in italiano`}
 description={`${libro.titolo} (${libro.anno}) di José Hernández nella traduzione italiana di Folco Testena: ${libro.canti.length} canti, ciascuno con l’originale spagnolo e il facsimile.`}>
<EditorialSection kind="category" image={parte==='andata'?'/media/fotografias-v3/la-ida.webp':'/media/fotografias-v3/la-vuelta.webp'} imageAlt="Ricostruzione digitale della pampa argentina" label="INDICE DEI CANTI · TRADUZIONE ITALIANA" heroLabel="Immagine di ambientazione" credit="Immagine di ambientazione: ricostruzione digitale contemporanea, non fotografia storica.">
 <p class="eyebrow">{libro.etichetta} · {libro.anno} · {libro.canti.length} canti · {versiDiParte(parte).toLocaleString('it-IT')} versi</p>
 <h1>{libro.titolo}</h1>
 <p class="lead">{libro.descrizione} Titolo originale: <em lang="es">{libro.titolo_originale}</em>.</p>
 <p class="mf-it-avviso">Trascrizione OCR dell’edizione del 1919, in revisione. Ogni canto rimanda al testo spagnolo e all’immagine della pagina stampata.</p>
 <p><a class="btn" href={urlCantoIt(parte,1)}>Comincia dal canto I</a></p>
 <section class="section"><h2>Indice dei canti</h2><div class="cards">
 {libro.canti.map(c=>{const k=corrispondenzaCanto(parte,c.numero);return <article class="card"><p class="eyebrow">Canto {romano(c.numero)}</p><h3><a href={urlCantoIt(parte,c.numero)}>Leggi il canto {romano(c.numero)}</a></h3><p>{versiDiCanto(c)} versi nella traduzione · {k.originale.versi} nell’originale</p><p><a href={urlCantoOriginale(parte,c.numero)} lang="es">Originale spagnolo</a> · <a href={c.url_facsimile} target="_blank" rel="noopener noreferrer">Facsimile ↗</a></p></article>})}
 </div></section>
</EditorialSection>
</Base>
