const piezas=[
 {fecha:'HACIA 1872 · MANUSCRITO',titulo:'La libreta escrita por José Hernández',detalle:'El Museo Histórico Nacional conserva una libreta manuscrita de trabajo para El gaucho Martín Fierro. Una fotografía institucional permite acercarse a la escritura del poeta y a las huellas materiales de su proceso creativo.',img:'https://www.argentina.gob.ar/sites/default/files/img_1483_2.jpg',alt:'Libreta abierta con páginas manuscritas atribuidas a José Hernández, conservada por el Museo Histórico Nacional',fuente:'Museo Histórico Nacional · Ministerio de Cultura de la Nación',url:'https://www.argentina.gob.ar/noticias/maraton-de-lectura-del-martin-fierro-en-el-museo-historico-nacional',tipo:'Fotografía y noticia institucional de 2022',etiqueta:'Ver la libreta en la publicación del museo ↗'},
 {fecha:'ABRIL DE 1865 · CARTA ORIGINAL',titulo:'Una carta a Carolina, su esposa',detalle:'Desde Nogoyá, José Hernández escribió una carta personal a Carolina González del Solar. El repositorio patrimonial conserva una digitalización del documento original, con una escritura íntima muy distinta de la voz del poema.',img:null,alt:'Vista de una carta manuscrita de José Hernández a Carolina González del Solar, fechada en 1865',fuente:'Biblioteca Pública de las Misiones · Fondo SADE',url:'https://repositorio.bpm.parquedelconocimiento.com/bitstream/handle/bpm/386/HERNANDEZ-CartaEsposa-1865-OPT.pdf?isAllowed=y&sequence=1',tipo:'Manuscrito de 1865 · documento completo de 4 páginas',etiqueta:'Abrir la carta manuscrita de 1865 (PDF de 4 páginas) ↗'},
 {fecha:'1872 · PRIMERA EDICIÓN',titulo:'Un ejemplar con correcciones manuscritas',detalle:'Portada del ejemplar de 1872 conservado por la Academia Argentina de Letras, descrito en Wikimedia Commons como corregido a mano por José Hernández. La imagen aquí reproducida es la portada impresa; las correcciones manuscritas deben consultarse dentro del facsímil completo.',img:'/media/archivo/ejemplar-corregido-martin-fierro-1872-portada.webp',alt:'Portada impresa auténtica del ejemplar de El gaucho Martín Fierro de 1872, procedente de la Academia Argentina de Letras',fuente:'Academia Argentina de Letras · Wikimedia Commons',url:'https://commons.wikimedia.org/wiki/File:El_gaucho_Martin_Fierro_-_Jose_Hernandez.pdf',tipo:'Facsímil de 1872 · 84 páginas · dominio público (reproducción mecánica)',etiqueta:'Abrir el facsímil completo de 1872 (PDF) ↗'},
 {fecha:'1879 · PRIMERA EDICIÓN',titulo:'La vuelta de Martín Fierro y sus grabados',detalle:'La portada original anuncia una edición adornada con diez láminas. En La vuelta, Hernández incorporó ilustraciones de Carlos Clérice: un cambio decisivo en la historia visual y editorial del poema.',img:'https://upload.wikimedia.org/wikipedia/commons/5/53/La_vuelta_de_Mart%C3%ADn_Fierro_cover_-_1879.jpg',alt:'Portada original de la primera edición de La vuelta de Martín Fierro publicada en 1879',fuente:'Ejemplar histórico · Wikimedia Commons',url:'https://upload.wikimedia.org/wikipedia/commons/5/53/La_vuelta_de_Mart%C3%ADn_Fierro_cover_-_1879.jpg',tipo:'Reproducción de portada original de 1879 · dominio público',etiqueta:'Ampliar la portada original de 1879 ↗'}
