---
import Base from '../../../layouts/Base.astro';
import EditorialSection from '../../../components/EditorialSection.astro';
import AdSlot from '../../../components/AdSlot.astro';
import '../../../styles/ensayos-culturales.css';
const apartados=[{"titulo":"No era una línea inmóvil","texto":"Los mapas históricos muestran desplazamientos de los espacios bajo control estatal durante los siglos XVIII y XIX. Los materiales de la Dirección General de Cultura y Educación bonaerense permiten seguir transformaciones territoriales entre 1779 y 1879. Los mapas, al mismo tiempo, expresan perspectivas y objetivos de quienes los elaboraron."},{"titulo":"Asentamientos y acuerdos","texto":"La historiadora Melina Yuln estudia los asentamientos de grupos identificados en la documentación estatal como «indios amigos», así como los modos de ocupación y reconocimiento de tierras en el sur y oeste bonaerenses. El término debe leerse como categoría histórica de los documentos, no como denominación universal de los pueblos indígenas."},{"titulo":"Participación militar y agencia política","texto":"Luciano Literas estudia cuantitativamente la militarización indígena en el oeste bonaerense entre 1850 y 1870. Sus investigaciones sobre los grupos vinculados a Rondeau y Melinao muestran que la participación indígena en las fronteras no puede describirse únicamente desde el enfrentamiento armado."},{"titulo":"Lectura crítica del poema","texto":"Los episodios de la frontera de La ida y de la permanencia entre comunidades indígenas de La vuelta están relatados desde la perspectiva de Fierro. Sus descripciones contienen juicios y generalizaciones propias del texto y su época. Para una revista histórica es imprescindible no tratarlas como voces de las comunidades retratadas ni como descripción total de su cultura."},{"titulo":"Preguntas abiertas","texto":"Falta incorporar documentos, mapas y testimonios de procedencia indígena o mediaciones archivísticas que permitan una comparación más amplia. La ausencia de esas voces en el poema no debe reproducirse como ausencia en la investigación."}];
const fuentes=[{"nombre":"Yuln: asentamientos indígenas en la frontera","url":"https://sedici.unlp.edu.ar/handle/10915/121869"},{"nombre":"Literas: militarización indígena","url":"https://revistas.uns.edu.ar/csh/article/view/2858"},{"nombre":"Quijada: repensar la frontera sur","url":"https://revistadeindias.revistas.csic.es/index.php/revistadeindias/article/view/461"},{"nombre":"Cambios de frontera entre 1779 y 1879","url":"https://continuemosestudiando.abc.gob.ar/contenido/100-anos-de-cambios-en-la-frontera-sur-1779-1879/"}];
const cantos=[3,4];
---
<Base title="La frontera y los pueblos indígenas: más allá del enfrentamiento | Revista MARTINFIERRO.ORG" description="La frontera bonaerense del siglo XIX fue una zona de violencia y expansión estatal, pero también de negociaciones, asentamientos, vínculos comerciales y relaciones sociales diversas." adKind="article">
<EditorialSection kind="article" image="/media/fotografias-v3/revista-cultural.webp" label="INVESTIGACIÓN HISTÓRICA · TERRITORIO">
<nav class="breadcrumbs" aria-label="Ubicación"><a href="/">Inicio</a><a href="/revista/">Revista</a><span>La frontera y los pueblos indígenas: más allá del enfrentamiento</span></nav>
<section class="section-intro"><p class="eyebrow">INVESTIGACIÓN HISTÓRICA · TERRITORIO</p><h1>La frontera y los pueblos indígenas: más allá del enfrentamiento</h1><p class="lead">La frontera bonaerense del siglo XIX fue una zona de violencia y expansión estatal, pero también de negociaciones, asentamientos, vínculos comerciales y relaciones sociales diversas.</p></section>
<div class="mf-essay-alert"><strong>Alcance:</strong> investigación editorial basada en estudios históricos e instituciones citadas al final. Los hechos documentados se distinguen de la voz literaria del poema; las fotografías de ambientación no son registros de los episodios narrados.</div>
{apartados.map(a=><section class="mf-essay"><h2>{a.titulo}</h2><p>{a.texto}</p></section>)}
<section class="mf-essay"><p class="eyebrow">LECTURA EN EL POEMA</p><h2>Contrastar con Martín Fierro</h2><p>Estos cantos permiten estudiar la representación literaria del tema, sin sustituir las fuentes históricas.</p><ul>{cantos.map(c=><li><a href={`/leer/ida/${c}/`}>El gaucho Martín Fierro · Canto {c} ↗</a></li>)}</ul><p><a href="/leer/vuelta/">Consultar también La vuelta de Martín Fierro ↗</a></p></section>
<section class="mf-essay"><p class="eyebrow">PROCEDENCIA</p><h2>Fuentes y lecturas de verificación</h2><ul>{fuentes.map(f=><li><a href={f.url} target="_blank" rel="noopener noreferrer">{f.nombre} ↗</a></li>)}</ul><p>Las referencias son puntos de comprobación y ampliación; los artículos originales no se reproducen íntegramente.</p></section>
