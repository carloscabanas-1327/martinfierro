---
import Base from '../../../layouts/Base.astro';
import EditorialSection from '../../../components/EditorialSection.astro';
import AdSlot from '../../../components/AdSlot.astro';
import '../../../styles/ensayos-culturales.css';
const apartados=[{"titulo":"Una presencia documentada","texto":"El Museo Roca identifica a las fortineras como mujeres que acompañaban a soldados o formaban parte de la vida de los cuerpos militares. Algunas fueron esposas o familiares; sus situaciones no pueden reducirse a una única experiencia. Las fuentes históricas también registran hambre, frío, desplazamientos y trabajos indispensables."},{"titulo":"La historia detrás de los nombres","texto":"La investigación institucional menciona a Domiciana Correa, recordada en Carhué como fortinera, partera y curandera. Su caso permite mostrar una historia individual; no debe confundirse con una biografía representativa de todas las mujeres de la frontera."},{"titulo":"Trabajo cotidiano y objetos","texto":"Cocinar, obtener alimentos, cuidar niños, atender enfermos o trasladarse con las tropas formaba parte de una vida compleja. Los estudios arqueológicos de las lozas halladas en fortines del sur bonaerense ofrecen otra vía para estudiar consumo, abastecimiento, identidad y diferencias sociales, sin atribuir cada objeto a una persona determinada."},{"titulo":"Qué vemos y qué no vemos en Martín Fierro","texto":"La esposa de Fierro, la cautiva y otras figuras femeninas cumplen funciones narrativas importantes, pero no equivalen a un retrato de las fortineras. El poema habla mediante voces literarias situadas. Cruzar esas representaciones con testimonios de mujeres y documentos permite ampliar el campo de visión."},{"titulo":"Próximas pruebas documentales","texto":"Necesitamos reunir padrones, registros militares y testimonios personales, identificar la procedencia de cada fotografía y evitar atribuciones que no consten en archivos."}];
const fuentes=[{"nombre":"Museo Roca: Fortineras","url":"https://museoroca.cultura.gob.ar/noticia/fortineras-quienes-fueron-las-mujeres-que-habitaron-los-fortines/"},{"nombre":"Estudio arqueológico de lozas fortineras","url":"https://revistas.unlp.edu.ar/relaciones/article/view/12729"},{"nombre":"Museo Roca: viviendas en los fortines","url":"https://museoroca.cultura.gob.ar/noticia/viviendas-en-los-fuertes-y-fortines-de-frontera/"}];
const cantos=[3,6];
---
<Base pageType="Article" image="/media/revista/fortineras-mujeres-frontera.webp" title="Mujeres fortineras: vida en la frontera" description="La vida en los fortines también involucró a mujeres y familias. Explorá su presencia en la frontera, sus trabajos cotidianos y el siglo XIX." adKind="article">
<EditorialSection kind="article" image="/media/revista/fortineras-mujeres-frontera.webp" label="HISTORIA SOCIAL · MUJERES">
<nav class="breadcrumbs" aria-label="Ubicación"><a href="/">Inicio</a><a href="/revista/">Revista</a><span>Las fortineras: mujeres en la vida cotidiana de la frontera</span></nav>
<section class="section-intro"><p class="eyebrow">HISTORIA SOCIAL · MUJERES</p><h1>Las fortineras: mujeres en la vida cotidiana de la frontera</h1><p class="lead">La frontera no estuvo habitada solamente por soldados: mujeres y familias compartieron las condiciones de vida de los establecimientos militares.</p></section>
<p class="mf-essay-alert">Las imágenes de ambientación son recreaciones contemporáneas y no registros fotográficos de los episodios narrados.</p>
{apartados.map(a=><section class="mf-essay"><h2>{a.titulo}</h2><p>{a.texto}</p></section>)}
<section class="mf-essay"><p class="eyebrow">LECTURA EN EL POEMA</p><h2>Contrastar con Martín Fierro</h2><p>Estos cantos permiten estudiar la representación literaria del tema, sin sustituir las fuentes históricas.</p><ul>{cantos.map(c=><li><a href={`/leer/ida/${c}/`}>El gaucho Martín Fierro · Canto {c} ↗</a></li>)}</ul><p><a href="/leer/vuelta/">Consultar también La vuelta de Martín Fierro ↗</a></p></section>
<section class="mf-essay"><p class="eyebrow">PROCEDENCIA</p><h2>Fuentes históricas y lecturas complementarias</h2><ul>{fuentes.map(f=><li><a href={f.url} target="_blank" rel="noopener noreferrer">{f.nombre} ↗</a></li>)}</ul><p>Consultá las publicaciones citadas para ampliar el contexto histórico.</p></section>
