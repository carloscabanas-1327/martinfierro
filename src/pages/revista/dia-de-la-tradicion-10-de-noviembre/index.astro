const apartados=[
{titulo:"¿Por qué el 10 de noviembre?",texto:"Cada 10 de noviembre, la Argentina recuerda el nacimiento de José Hernández, en 1834. Su Martín Fierro dio una voz literaria perdurable al gaucho. La fecha celebra el legado cultural de la obra y la memoria de quienes forjaron nuestras costumbres."},
{titulo:"1939: la primera ley bonaerense",texto:"La provincia de Buenos Aires instituyó el Día de la Tradición el 10 de noviembre mediante la Ley 4756. Fue promulgada el 18 de agosto de 1939 y publicada el 13 de septiembre. Su alcance era provincial; todavía no era una celebración establecida por ley nacional."},
{titulo:"1975: reconocimiento nacional",texto:"La Ley 21.154, sancionada el 30 de septiembre de 1975 y publicada el 28 de octubre, declaró el 10 de noviembre Día de la Tradición en toda la Nación y designó a San Martín, provincia de Buenos Aires, Ciudad de la Tradición."},
{titulo:"Qué significa tradición",texto:"El Día de la Tradición es una celebración de lo que nos une como argentinos: la memoria de nuestros mayores, el trabajo de nuestra tierra, la palabra empeñada, el coraje, la solidaridad y las costumbres que pasan de generación en generación. En el mate compartido, la música, las payadas, las danzas, los oficios y las fiestas de cada región reconocemos una patria viva, construida por generaciones de argentinos de distintos orígenes. Honrarla es conocerla, transmitirla y mantenerla viva."},
{titulo:"Más que una fiesta gauchesca",texto:"Martín Fierro no surgió de la nada: Bartolomé Hidalgo, Hilario Ascasubi y Estanislao del Campo desarrollaron antes distintas formas de poesía gauchesca. Sus obras permiten conocer cómo se representó la voz del gaucho y cómo evolucionó un género central de nuestra literatura."},
{titulo:"Cómo celebrarlo desde la lectura",texto:"Una manera de celebrar la fecha es leer el canto I de La ida, conversar sobre la vida rural de entonces y comparar sus costumbres con las de nuestra comunidad. Las actividades escolares pueden incluir música regional, relatos familiares y consulta de documentos originales."}
];
const fuentes=[{"nombre":"Provincia de Buenos Aires: texto y vigencia de la Ley 4756","url":"https://normas.gba.gob.ar/ar-b/ley/1939/4756/10470"},{"nombre":"Boletín oficial y texto de la Ley nacional 21.154","url":"https://www.argentina.gob.ar/normativa/nacional/ley-21154-231404/texto"},{"nombre":"Instituto Nacional de Antropología y Pensamiento Latinoamericano: Día de la Tradición","url":"https://www.argentina.gob.ar/node/287035"},{"nombre":"Ministerio de Cultura: José Hernández y el Día de la Tradición","url":"https://www.cultura.gob.ar/por-que-se-celebra-el-dia-de-la-tradicion-en-argentina-8528/"}];
const lecturas=[{"nombre":"La ida · Canto I","url":"/leer/ida/1/"},{"nombre":"Biografía documental de José Hernández","url":"/jose-hernandez/"},{"nombre":"Los gauchos: historia social","url":"/revista/quienes-eran-los-gauchos/"}];
