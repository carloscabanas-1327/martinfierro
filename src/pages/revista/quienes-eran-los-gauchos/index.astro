const apartados=[{"titulo":"Del hombre rural al símbolo","texto":"No existió un único gaucho, idéntico en toda región y época. Los estudios patrimoniales oficiales subrayan diversidad de orígenes y ocupaciones: peones, soldados, trabajadores de la hacienda y también personas perseguidas como matreras. Convertirlo en una figura exclusivamente libre o exclusivamente delincuente borra las relaciones de trabajo y poder que estructuraban la campaña."},{"titulo":"Oficios y destrezas","texto":"La actividad ganadera exigía saber montar, enlazar, arrear, cuidar animales, reparar aperos y desplazarse por distancias extensas. El caballo y los instrumentos rurales ocupaban un lugar central, pero las condiciones concretas dependían del establecimiento, la región, la propiedad de la tierra y el período. La habilidad ecuestre no era sinónimo de independencia económica."},{"titulo":"Pulperías, canciones y encuentros","texto":"Las pulperías articularon comercio y sociabilidad: allí podían circular noticias, realizarse intercambios y escucharse cantores. El mate, la guitarra y ciertas prendas forman parte de las representaciones de la cultura gauchesca. Su presencia actual en festividades es una tradición viva, no una fotografía inmutable del siglo XIX."},{"titulo":"La leva, el control social y las desigualdades","texto":"Las leyes de control de la movilidad rural, las levas militares y las transformaciones de la propiedad afectaron de manera desigual a los habitantes de la campaña. El poema de José Hernández coloca precisamente el desarraigo y el servicio fronterizo en el centro del relato. Conviene distinguir ese testimonio literario de las experiencias históricas de personas concretas."},{"titulo":"El gaucho de Hernández no representa a todos","texto":"Fierro habla desde su propia voz: recuerda el hogar, denuncia abusos y también protagoniza episodios violentos. La presencia de mujeres, población afroargentina y pueblos indígenas exige fuentes independientes y miradas críticas. Un análisis cultural gana rigor cuando deja de considerar al protagonista como un retrato estadístico de toda la sociedad rural."},{"titulo":"Del siglo XIX a la cultura de hoy","texto":"Agrupaciones tradicionalistas, celebraciones y prácticas rurales transmiten saberes y crean nuevas lecturas del pasado. La tradición no es solo conservación: también implica selección y reinterpretación. La construcción del gaucho como emblema argentino debe estudiarse en paralelo con las vidas efectivas de los trabajadores rurales."}];
const fuentes=[{"nombre":"Ministerio de Cultura: diversidad social y memoria del gaucho","url":"https://www.argentina.gob.ar/normativa/nacional/resoluci%C3%B3n-150-2022-361054/texto"},{"nombre":"Biblioteca Nacional de Maestros: tradiciones gauchas","url":"https://bnm.educacion.gob.ar/tradicion-nacional/"},{"nombre":"Ministerio de Cultura: José Hernández y Día de la Tradición","url":"https://www.cultura.gob.ar/por-que-se-celebra-el-dia-de-la-tradicion-en-argentina-8528/"}];
const lecturas=[{"nombre":"La ida · Canto II","url":"/leer/ida/2/"},{"nombre":"La ida · Canto III","url":"/leer/ida/3/"},{"nombre":"Vida gaucha · guía temática","url":"/temas/vida-gaucha/"}];
