---
import IdiomaEnPreparacion from '../../components/IdiomaEnPreparacion.astro';
const textos = {
  "titulo": "Martín Fierro en català: traduccions i fonts",
  "aviso": "Edició lingüística en preparació. No es publica cap traducció fins a verificar-ne la font, la integritat i els drets de reproducció.",
  "original": "Llegir el poema original en castellà",
  "traducciones": "Traduccions documentades",
  "sinTraducciones": "Encara no hi ha cap traducció documentada en aquesta llengua.",
  "biblioteca": "Biblioteca i arxiu",
  "bibliotecaTexto": "Les fonts històriques, les edicions i els documents són comuns a totes les llengües i es consulten en castellà.",
  "derechos": "Catàleg de traduccions i drets"
};
---
<IdiomaEnPreparacion codigo="ca" nombre="Català" dir="ltr" textos={textos} />
