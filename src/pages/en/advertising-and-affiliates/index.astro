---
import Base from '../../../layouts/Base.astro';
const sections=[["The site will have advertisers", "MARTINFIERRO.ORG will show ads served by networks such as Google AdSense and may include direct advertisers: publishers, bookshops, cultural institutions, rural tourism, craftspeople, regional producers and other businesses relevant to our readers. Revenue funds the maintenance and growth of the edition."], ["How ads are identified", "Every commercial placement is labelled “Advertisement” and kept distinct from the content. Ads are never placed between the poem's verses or over images or navigation buttons."], ["Editorial separation", "Advertisers cannot change the poem, its verses or documentary references, decide what is published or buy opinions. Advertising on the site is not an endorsement."], ["What we do not accept", "Gambling, adult content, tobacco, weapons, miracle products, discriminatory or misleading messages, and ads aimed at children. We may refuse or remove any ad."], ["Affiliate links and sponsored content", "Links that may earn a commission are disclosed next to the link. Paid content is labelled “Sponsored content”. Paid recommendations are never presented as independent reviews."], ["How to advertise", "Write to <a href='mailto:info@martinfierro.org?subject=Advertising'>info@martinfierro.org</a> with your company, product and preferred period. The site has editions in nine languages, read in Argentina, Latin America and worldwide. See also the <a href='/en/privacy/'>Privacy and Cookie Policy</a> and <a href='/en/terms/'>Terms of Use</a>."]];
---
<Base migas={[{label:"Advertising and Advertisers"}]} lang="en-US" pageType="WebPage" title="Advertising and Advertisers — MARTINFIERRO.ORG" description="MARTINFIERRO.ORG is funded by advertising: how ads are labelled, what we do not accept and how to advertise on the site.">
<article class="legal-en"><p class="eyebrow">COMMERCIAL TRANSPARENCY · 15 NOVEMBER 2026</p><h1>Advertising and Advertisers</h1><p class="lead">MARTINFIERRO.ORG is free for readers. To sustain the edition, the site will carry advertising and advertisers.</p>{sections.map(([heading,body],i)=><section><h2>{heading}</h2><p set:html={body}/></section>)}<footer><p>This English page describes the same underlying project as its Spanish counterpart. In case of a material discrepancy, consult the original project documentation and request an editorial correction; neither version is represented as independently certified legal advice.</p><a href="/en/contact/">Contact and corrections</a></footer></article>
<style>.legal-en{max-width:960px;margin:28px auto 90px;color:#33291f}.legal-en a{color:#86402b;text-underline-offset:4px}.crumb,.eyebrow{font:.79rem/1.55 system-ui,sans-serif}.eyebrow{font-weight:750;letter-spacing:.12em;color:#95513b}.legal-en h1{font:600 clamp(2.5rem,5vw,4.4rem)/1.1 Georgia,serif}.lead{font:1.22rem/1.68 Georgia,serif}.legal-en section{padding:23px 0;border-bottom:1px solid #c9b69e}.legal-en h2{font:600 1.9rem/1.25 Georgia,serif}.legal-en p{font:1.06rem/1.77 Georgia,serif}.legal-en footer{background:#efe3d5;padding:22px;margin-top:30px}@media(max-width:700px){.legal-en{padding:0 12px}}</style>
</Base>