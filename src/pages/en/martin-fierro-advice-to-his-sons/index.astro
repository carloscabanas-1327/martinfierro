import {estrofasDeCanto} from '../../../lib/corpus';
const stanzas=estrofasDeCanto('vuelta',32);
const verseCount=stanzas.reduce((total,stanza)=>total+stanza.versos.length,0);
const annotations:Record<number,{title:string,explanation:string}> = {
 1144:{title:'A father speaks from experience',explanation:'Fierro presents his advice as the outcome of a difficult life. He is not an infallible moral instructor: the reader has seen him make grave mistakes. The words matter because they come from experience, not because their speaker is beyond criticism.'},
 1146:{title:'Learning and practical wisdom',explanation:'The gauchesque spellings “cencia,” “gúenas” and “ducho” refer to knowledge, good things and being skilled or experienced. The language is part of Hernández’s crafted rural voice. The passage places moral learning alongside other kinds of knowledge.'},
 1150:{title:'Friendship and integrity',explanation:'Fierro’s counsel about friends and honesty asks how people can depend on one another. Remember Cruz’s decision to stand with him: friendship has already carried both solidarity and risk within the plot.'},
 1153:{title:'The dignity of work',explanation:'Work is presented as a foundation for life, an idea charged with meaning after Fierro’s forced service and loss of his own livelihood. The passage should be read against the difference between free labor and labor imposed by authority.'},
 1160:{title:'“Los hermanos sean unidos”: the strength of solidarity',explanation:'This is the celebrated appeal for brothers to remain united. Its resonance extends beyond blood relatives, but the original line is specifically addressed to brothers. The advice has special weight after the family separations described in both parts.'},
 1161:{title:'Respect across generations',explanation:'The advice asks younger people to recognize the experience and vulnerability of their elders. It is an appeal to conduct within a family and community, rather than proof that age makes every judgment right.'},
 1167:{title:'Rejecting violence',explanation:'Warnings against violence are especially striking from a narrator who has killed. The tension between what Fierro did and what he now recommends is part of the poem’s ethical complexity.'},
 1174:{title:'Advice at a moment of departure',explanation:'The closing advice belongs to the larger scene of reunion and separation. The poem does not conclude that the hardships of its characters can be erased by good counsel; instead, their experience becomes something to carry forward.'}
};
const topics=[
 {label:'A father speaks',n:1144},{label:'Learning and experience',n:1146},
 {label:'Friendship and honesty',n:1150},{label:'Work',n:1153},
 {label:'Unity among brothers',n:1160},{label:'Respect for elders',n:1161},
 {label:'Rejecting violence',n:1167},{label:'Final counsel',n:1174}
];
const canonical=new URL('/en/martin-fierro-advice-to-his-sons/',Astro.site).toString();
