---
import Base from '../../../../layouts/Base.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import {estrofasDeCanto} from '../../../../lib/corpus';
const canto=3;
const stanzas=estrofasDeCanto('ida',canto);
const chosen=[49,50,103];
const excerpts=stanzas.filter(s=>chosen.includes(s.numero));
const questions=["How does the opening contrast Fierro's former household with his later condition?","What forms of power constrain Fierro's choices?","How can a student distinguish Fierro's perspective on Indigenous people from historical evidence about those communities?"];
const intro={"n":3,"title":"Forced Frontier Service and a Broken Home","summary":"Fierro says he once had a wife, children and livestock but was sent to the frontier. The canto develops the injustice and dangers he associates with military service, including the conditions of the frontier and conflict with Indigenous groups. Read the narrator's descriptions critically: they are situated literary testimony, not an exhaustive account of Indigenous peoples.","people":"Martín Fierro; his absent family; frontier authorities and soldiers; Indigenous figures as represented by his perspective.","themes":"Recruitment and coercion; displacement; loss of family; the frontier as military and social space; unreliable or partial testimony.","words":"frontera (frontier); tapera (abandoned or ruined dwelling); indiada (historically derogatory collective term for Indigenous people, quoted only to explain the poem); pago (home district).","questions":["How does the opening contrast Fierro's former household with his later condition?","What forms of power constrain Fierro's choices?","How can a student distinguish Fierro's perspective on Indigenous people from historical evidence about those communities?"],"nums":[49,50,103]};
---
<Base lang="en-US" adKind="article" pageType="Article" title="Martín Fierro Canto 3 Explained: Forced Frontier Service and a Broken Home" description="Study El gaucho Martín Fierro Canto 3 in English: verified plot summary, original Spanish stanzas, themes, vocabulary, characters and reading questions.">
<article class="student-guide"><nav class="crumb"><a href="/en/">English</a> / <a href="/en/students/">Study guides</a> / Part One, Canto 3</nav><header><p class="eyebrow">MARTÍN FIERRO FOR STUDENTS · THE GAUCHO · 1872</p><h1>Canto 3 Explained: Forced Frontier Service and a Broken Home</h1><p class="deck">A source-linked English study guide alongside José Hernández’s original Spanish poem.</p></header>
<section><h2>What happens in Canto 3?</h2><p>{intro.summary}</p><p><a href="/leer/ida/3/" lang="es">Read every original verse of Canto 3 ↗</a></p></section>
<AdSlot id="article-02-after-summary" kind="article"/>
<section><h2>Original verses: three passages worth studying</h2><p>The following stanzas are taken directly from the repository's original-text corpus, without modernization. Explanations elsewhere on this page are interpretation, not translation.</p>{excerpts.map(s=><figure class="stanza" lang="es"><figcaption>Original stanza {s.numero}</figcaption><blockquote>{s.versos.map(v=><span>{v.texto}</span>)}</blockquote></figure>)}</section>
<AdSlot id="article-03-after-original-verses" kind="article"/>
<section><h2>Main characters and voices</h2><p>{intro.people}</p><h2>Literary themes to identify</h2><p>{intro.themes}</p><h2>Gaucho vocabulary in context</h2><p>{intro.words}</p></section>
<AdSlot id="article-04-after-themes" kind="article"/>
<section><h2>Reading-comprehension and discussion questions</h2><ol>{questions.map(q=><li>{q}</li>)}</ol><p>Support answers with details from the original canto. Different interpretations may be justified if the quoted passages and narrative context support them.</p></section>
<section class="sources"><h2>Sources and further reading</h2><p>Primary source: José Hernández, <em>El gaucho Martín Fierro</em> (1872), Canto 3, reproduced from the site's structured Spanish corpus. Summary and questions are original English educational commentary, not quoted authorial explanations.</p><p><a href="/leer/ida/3/" lang="es">Original canto</a> · <a href="/en/martin-fierro-summary/">Summary of both parts</a> · <a href="/en/characters/">Character guide</a> · <a href="/en/students/">All study guides</a></p></section>
<AdSlot id="article-05-end" kind="article"/>
</article>
