---
import Base from '../../../../layouts/Base.astro';
import {personajes} from '../../../../data/personajes';
import {estrofasDeCanto} from '../../../../lib/corpus';
const extended:Record<string,string>={'martin-fierro':"Begin with the contrast between the free rural life Fierro remembers and the injustice he describes after his recruitment. His first-person singing makes his suffering immediate, but it also means readers must ask what he leaves out. In Part Two he listens to other people's stories and offers advice, making his changing role a useful topic for discussion.",
'sargento-cruz':"Cruz first appears as an armed representative of authority, then risks his position to defend the man he was sent to arrest. He becomes a storyteller in his own right and later a companion in exile. His death in the sequel matters not just as a plot event but because it transforms Fierro's account of loyalty, grief, and responsibility.",
'esposa-fierro':"She is essential to understanding what forced service destroys: a household, a marriage, and the children's security. Yet nearly everything students learn about her comes through other speakers. Ask whose story is being told, whose testimony is missing, and why a figure central to the emotional narrative is given so little direct speech.",
'primer-hijo':"The elder son's testimony shows that the consequences of Fierro's disappearance outlast the original injustice. His story of isolation and confinement introduces a new speaking voice and a perspective unlike his father's. When comparing the sons, keep their separate experiences and episodes clearly distinguished.",
'segundo-hijo':"The younger son's account shifts between distress and dark humor as he recalls living with Vizcacha. The guardian's proverbs can sound clever in isolation, but their practical selfishness is exposed by the conditions in which the boy lives. Compare them with Fierro's later advice to identify how the poem stages competing ideas about how to survive.",
'don-vizcacha':"Vizcacha is more than comic relief. His opportunistic sayings provide a deliberately uncomfortable lesson in distrust, self-protection, and manipulation. The young narrator's circumstances invite readers to consider the difference between remembering a memorable proverb and accepting it as ethical guidance.",
'picardia':"Picardía brings Cruz's family history into the reunion and supplies a further independent narrative voice. His account of childhood difficulties, gambling, elections, recruitment, and frontier service links private misfortune to public institutions. Evaluate each episode on its own: wit and survival do not necessarily turn deception into a virtue.",
'la-cautiva':"The captive woman's story includes suffering, resistance, and a dangerous escape, but it is filtered through Fierro's narration. A careful student can distinguish the actions the text describes from the language used to characterize Indigenous people. Discuss the woman's limited opportunity to speak for herself without reducing her to a mere symbol.",
'el-moreno':"The singer confronts Fierro through an art form rather than by immediately repeating the earlier violence. Their questions about knowledge, justice, and human experience make the payada a major intellectual scene. His family connection to the earlier killing must be read carefully: he is a different person from the victim.",
'moreno-muerto':"This character matters even though he is not allowed to narrate his own experience. Fierro's insults and account of the killing demand critical attention rather than automatic acceptance of his self-defense. Reading his death alongside the later payada reveals how violence and its consequences can reappear across both parts.",
'juez-paz':"The justice of the peace embodies the local power Fierro blames for recruitment and persecution. The position has a real historical context, but the poem's particular figure remains fictional. Students should separate the narrator's charges, the role of the institution, and any independent historical claims."};
const sourceStanza=(p:typeof personajes[number])=>estrofasDeCanto(p.estrofa.parte,p.estrofa.canto).find(s=>s.numero===p.estrofa.numero);
const guideUrl=(r:{parte:'ida'|'vuelta';canto:number})=>r.parte==='ida'? `/en/students/canto-${r.canto}/`:`/en/students/vuelta-canto-${r.canto}/`;
const notes:Record<string,{role:string,description:string,reading:string}> ={
'martin-fierro':{role:'The singer, protagonist and narrator',description:'A rural horseman whose family life collapses after forced frontier service. His song tells of injustice, violence, flight, friendship and eventual reunion.',reading:'Fierro is not José Hernández speaking without a filter. His grievances matter, but his attempts to justify violence must also be scrutinized.'},
'sargento-cruz':{role:'The sergeant who chooses friendship',description:'Initially part of the group sent after Fierro, Cruz changes sides and joins him. Their solidarity becomes one of the pivotal relationships in the poem.',reading:'Cruz’s choice raises a question of loyalty: what happens when following orders conflicts with a personal sense of justice?'},
'esposa-fierro':{role:'Fierro’s wife and the lost home',description:'A central presence in the family life Fierro loses after conscription. News of her death reaches him later, largely through accounts told by others.',reading:'The poem does not give her a separate narrative voice or a stable personal name, an absence that deserves attention.'},
'primer-hijo':{role:'Fierro’s elder son',description:'One of the two sons reunited with their father in the second part. His own account broadens the family story with deprivation and mistreatment.',reading:'His experience and voice should not be conflated with his brother’s.'},
'segundo-hijo':{role:'Fierro’s younger son',description:'His story includes life under the guardianship of Don Vizcacha, whose cynical advice and unusual habits mix bleak comedy with suffering.',reading:'The contrast between Vizcacha’s maxims and Fierro’s later counsel is crucial.'},
'don-vizcacha':{role:'A guardian and satirical adviser',description:'An impoverished older man placed in charge of Fierro’s younger son. His cunning, grotesque habits and self-serving sayings are among the sequel’s memorable episodes.',reading:'Vizcacha’s proverbs should not automatically be treated as the poem’s moral position.'},
'picardia':{role:'Cruz’s son and a storyteller',description:'A young man who recounts hardship, gambling, abuses of authority and frontier service. His testimony adds a separate perspective to the later poem.',reading:'His name suggests cleverness, but the story repeatedly exposes the costs of survival.'},
'la-cautiva':{role:'The captive woman',description:'Her suffering in captivity and Fierro’s intervention are narrated through his perspective in the second part.',reading:'She remains unnamed; the passage requires a critical reading of gender and of period portrayals of Indigenous peoples.'},
'el-moreno':{role:'The Afro-Argentine singer in the payada',description:'An Afro-descendant singer challenges Fierro in a poetic contest of questions and answers, reviving the memory of an earlier death.',reading:'He is not the same man whom Fierro killed in the first part; nor should one literary voice stand for an entire population.'},
'moreno-muerto':{role:'The man killed in a pulpería',description:'An Afro-descendant man dies in a fight with Fierro. The narrator’s account includes racial insults, provocation and violence.',reading:'The narrator’s version of this killing is not an acquittal, and this victim must not be confused with the later singer.'},
'juez-paz':{role:'The justice of the peace',description:'A figure of local authority in Fierro’s account of conscription and persecution. His office recalls actual institutions but is part of the poem’s fiction.',reading:'There is no basis for assigning the fictional judge a specific historical identity.'}
};
const image=(id:string)=>({'martin-fierro':'martin-fierro','sargento-cruz':'sargento-cruz','esposa-fierro':'esposa-de-fierro','primer-hijo':'hijo-mayor-de-fierro','segundo-hijo':'hijo-segundo-de-fierro','don-vizcacha':'viejo-vizcacha','picardia':'picardia','la-cautiva':'la-cautiva','el-moreno':'el-moreno','moreno-muerto':'negro-del-baile','juez-paz':'juez-de-paz'} as Record<string,string>)[id];
---
<Base lang="en-US" pageType="CollectionPage" title="Martín Fierro Characters for Students — Illustrated English Study Guide" description="Illustrated English profiles of 11 Martín Fierro characters, with original Spanish stanzas, classroom reading questions and links to all 46 canto study guides.">
<article class="international">
<nav class="crumb" aria-label="Breadcrumb"><a href="/en/">English edition</a><span>/</span><a href="/en/students/">For students</a><span>/</span><span>Characters</span></nav>
<header class="head"><p class="eyebrow">FOR STUDENTS · ILLUSTRATED CHARACTER GUIDE</p><h1>Who’s who in <em>Martín Fierro</em></h1><p class="deck">A fugitive gaucho, a loyal friend, two sons trying to make sense of their losses, an irreverent guardian, and voices often pushed to the margins. Explore these eleven characters through their stories, original Spanish verses, and links to the canto-by-canto lessons. The portraits are digital recreations, not historical photographs.</p></header>
<p class="glossary-link">New to gaucho vocabulary? Read the <a href="/en/students/glossary/">English glossary of regional words and character names</a>, including what <em>Picardía</em> means.</p><nav class="jump" aria-label="Jump to a character">{personajes.map(p=><a href={`#${p.id}`}>{p.nombre}</a>)}</nav>
<div class="student-character-list">{personajes.map(p=><section class="student-character-item" id={p.id} aria-labelledby={`title-${p.id}`}><figure><img src={`/media/fotografias-v3/${image(p.id)}.webp`} alt={`Digital editorial interpretation of ${p.nombre}; not a historical portrait`} loading="lazy"/><figcaption>Modern editorial reconstruction · Not historical evidence</figcaption></figure><div><p class="eyebrow">{notes[p.id].role}</p><h2 id={`title-${p.id}`}>{p.nombre}</h2><p>{notes[p.id].description}</p><p>{extended[p.id]}</p><p><strong>Reading critically:</strong> {notes[p.id].reading}</p>{sourceStanza(p) && <div class="passage"><p class="eyebrow">FROM THE ORIGINAL POEM · {p.estrofa.parte==='ida'?'PART ONE':'PART TWO'} · CANTO {p.estrofa.canto} · STANZA {p.estrofa.numero}</p><blockquote lang="es">{sourceStanza(p)!.versos.slice(0,6).map(v=><span>{v.texto}</span>)}</blockquote><p><a href={`/leer/${p.estrofa.parte}/${p.estrofa.canto}/#${sourceStanza(p)!.id}`} lang="es">Read the stanza in context</a></p></div>}<p class="refs"><strong>Explore the original Spanish text:</strong> {p.referencias.map(r=><a href={`/leer/${r.parte}/${r.canto}/`} lang="es">{r.parte==='ida'?'Part One':'Part Two'} · Canto {r.canto}</a>)}</p><p class="refs"><strong>Continue with the English lessons:</strong> {p.referencias.map(r=><a href={guideUrl(r)}>{r.parte==='ida'?'Part One':'Part Two'} · Canto {r.canto}</a>)}</p></div></section>)}</div>
<section class="method"><h2>How to use this character guide</h2><p>These eleven profiles follow the Spanish character index, reuse its pictures, and quote short passages directly from the structured Spanish corpus. Each also links to the relevant English lessons. These are interpretive summaries, not quotations or new English translations of Hernández’s verses. The figure of a gaucho in literature should not be mistaken for the full variety of historical rural experience.</p><p>Use the <a href="/en/students/">complete 46-canto student index</a> to follow the story in order. For broader context, read <a href="/en/what-is-martin-fierro/">the English introduction to the poem</a>, <a href="/en/what-is-a-gaucho/">our guide to gaucho history</a>, and <a href="/en/jose-hernandez/">the biography of José Hernández</a>.</p><p><strong>Editorial source:</strong> Character identities and canto references are mapped to the project’s structured Spanish corpus and <a href="/personajes/">Spanish research index</a>. The 46 cantos and 7,210 Spanish verses remain unchanged.</p></section>
</article>
