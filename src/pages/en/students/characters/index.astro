.student-character-item .passage{background:#f2e7d9;border-left:3px solid #a77e5b;padding:15px 18px;margin:22px 0}.passage blockquote{margin:10px 0}.passage blockquote span{display:block;font:1rem/1.65 Georgia,serif}.passage p{margin:8px 0}.student-character-item .refs a{display:inline-block;margin-right:12px}.student-character-item{scroll-margin-top:90px}@media(max-width:620px){.method{padding:20px}.student-character-item .passage{padding:12px}}
.glossary-link{padding:15px 20px;background:#efe3d4;border-left:3px solid #945139;font:1rem/1.6 Georgia,serif}</style>
</Base>