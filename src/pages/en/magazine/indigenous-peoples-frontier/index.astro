import AdSlot from '../../../../components/AdSlot.astro';
import Base from '../../../../layouts/Base.astro';
const sections=[{"id":"section-1","heading":"A frontier that moved","body":"Maps of the southern frontier between 1779 and 1879 show major territorial changes. Educational resources from Buenos Aires Province explain the different moments of conflict, negotiated relations and state expansion. Such maps are useful evidence, but they also reflect the aims and categories of those who drew them. Indigenous territory must not be described as uninhabited simply because the nineteenth-century state sought to occupy it."},{"id":"section-2","heading":"Settlements, agreements and land","body":"Historian Melina Yuln has researched Indigenous settlements in the south and west of Buenos Aires and the treatment of land by state authorities. Period records use the term indios amigos for certain communities in political or military relations with the government. That expression is a state-era category, not a general name for Indigenous peoples or an explanation of their identities."},{"id":"section-3","heading":"Indigenous political choices and military service","body":"Research by Luciano Literas on the groups associated with Rondeau and Melinao shows why frontier history cannot be told solely as clashes between opposing armies. Indigenous leaders and communities negotiated, served, refused or sought advantages in circumstances of unequal power. Documented participation in military structures does not erase the larger history of coercion or territorial dispossession."},{"id":"section-4","heading":"Reading Martín Fierro against the archive","body":"The scenes of recruitment in the first part and Fierro’s time among Indigenous communities in the second are told from his viewpoint. The text includes sweeping judgments, hostile descriptions and violence. They are part of the work’s nineteenth-century literary representation, not the voices of the Indigenous communities being described. Critical reading can respect the poem as literature without repeating its prejudices as fact."},{"id":"section-5","heading":"What the history must include","body":"A more complete inquiry needs historical maps, treaty records, Indigenous testimony and studies attentive to their archival mediation. The advance of state forces culminating in 1879 brought death, captivity and dispossession to Indigenous peoples, as contemporary educational scholarship explicitly acknowledges. That history cannot be replaced by a romantic image of the frontier."},{"id":"section-6","heading":"Beyond a simple two-sided story","body":"The southern frontier involved Indigenous groups, military officers, settlers, workers, women and traders with changing relationships. Distinguishing an archive’s terminology from a community’s own name is one small but important step toward telling that history more accurately."}];
const sources=[{"name":"Melina Yuln — Indigenous settlements and frontier land","url":"https://sedici.unlp.edu.ar/handle/10915/121869"},{"name":"Luciano Literas — Indigenous militarization, 1850–1870","url":"https://revistas.uns.edu.ar/csh/article/view/2858"},{"name":"Mónica Quijada — rethinking the southern frontier","url":"https://revistadeindias.revistas.csic.es/index.php/revistadeindias/article/view/461"},{"name":"Buenos Aires Province — changing frontier maps, 1779–1879","url":"https://continuemosestudiando.abc.gob.ar/contenido/100-anos-de-cambios-en-la-frontera-sur-1779-1879/"}];
const cantos=[3,4];
