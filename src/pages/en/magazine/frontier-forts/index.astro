import Base from '../../../../layouts/Base.astro';
const sections=[{"id":"section-1","heading":"Not every fort looked alike","body":"Historical research from the Museo Roca distinguishes larger forts from smaller fortines. Larger establishments could contain command spaces, barracks, storehouses, medical facilities and defensive structures. Smaller posts might chiefly provide observation and communications between positions. Their layouts depended on geography, resources and date. There was no universal model for the Argentine frontier."},{"id":"section-2","heading":"Shelter made from available materials","body":"Museum research based on photographs taken in 1883 by Carlos Encina and Edgardo Moreno describes dwellings made with quincha: branches and reeds combined with mud. These structures help historians investigate construction techniques, but the photographs were taken eleven years after the 1872 publication of El gaucho Martín Fierro. They cannot serve as direct visual evidence of the episodes in the poem."},{"id":"section-3","heading":"The labor behind military service","body":"Life at an outpost also required cooking, obtaining water, feeding animals, maintaining shelter, watching roads and transporting supplies. Soldiers and civilians experienced shortages and discomfort differently. Educational materials from Buenos Aires Province also describe games and gatherings in the intervals between military duties. Avoid imagining every day as a battle or every settlement as equally supplied."},{"id":"section-4","heading":"The frontier in Martín Fierro","body":"In Cantos III and IV of the first part, Fierro narrates recruitment and the ordeal of frontier service. His voice gives an extraordinarily forceful account of deprivation and abuse. Yet the poem is a literary narrative, told by a fictional speaker. Comparing its scenes with dated plans, supply records and photographs clarifies the difference between a historical setting and a character’s testimony."},{"id":"section-5","heading":"What historical investigation still needs","body":"A careful reconstruction would compare the records of particular forts, dated maps, muster rolls, inventories and named individuals. Evidence from 1883 may illuminate a building type without proving its exact appearance in 1872. The most useful question is not simply what the frontier looked like, but whose lives each surviving document allows us to see."}];
const sources=[{"name":"Museo Roca — forts and fortines","url":"https://museoroca.cultura.gob.ar/noticia/como-eran-los-fuertes-y-fortines-ubicados-en-la-frontera-con-el-indio/"},{"name":"Museo Roca — frontier dwellings","url":"https://museoroca.cultura.gob.ar/noticia/viviendas-en-los-fuertes-y-fortines-de-frontera/"},{"name":"Buenos Aires Province educational materials — frontier expansion","url":"https://continuemosestudiando.abc.gob.ar/contenido/la-expansion-de-la-frontera-criolla-fuertes-y-fortines/"}];
const cantos=[3,4];
---
