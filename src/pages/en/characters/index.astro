---
import Base from '../../../layouts/Base.astro';
import {personajes} from '../../../data/personajes';
const notes:Record<string,{role:string,description:string,reading:string}> ={
'martin-fierro':{role:'The singer, protagonist and narrator',description:'A rural horseman whose family life collapses after forced frontier service. His song tells of injustice, violence, flight, friendship and eventual reunion.',reading:'Fierro is not José Hernández speaking without a filter. His grievances matter, but his attempts to justify violence must also be scrutinized.'},
'sargento-cruz':{role:'The sergeant who chooses friendship',description:'Initially part of the group sent after Fierro, Cruz changes sides and joins him. Their solidarity becomes one of the pivotal relationships in the poem.',reading:'Cruz’s choice raises a question of loyalty: what happens when following orders conflicts with a personal sense of justice?'},
'esposa-fierro':{role:'Fierro’s wife and the lost home',description:'A central presence in the family life Fierro loses after conscription. News of her death reaches him later, largely through accounts told by others.',reading:'The poem does not give her a separate narrative voice or a stable personal name, an absence that deserves attention.'},
'primer-hijo':{role:'Fierro’s elder son',description:'One of the two sons reunited with their father in the second part. His own account broadens the family story with deprivation and mistreatment.',reading:'His experience and voice should not be conflated with his brother’s.'},
'segundo-hijo':{role:'Fierro’s younger son',description:'His story includes life under the guardianship of Don Vizcacha, whose cynical advice and unusual habits mix bleak comedy with suffering.',reading:'The contrast between Vizcacha’s maxims and Fierro’s later counsel is crucial.'},
'don-vizcacha':{role:'A guardian and satirical adviser',description:'An impoverished older man placed in charge of Fierro’s younger son. His cunning, grotesque habits and self-serving sayings are among the sequel’s memorable episodes.',reading:'Vizcacha’s proverbs should not automatically be treated as the poem’s moral position.'},
'picardia':{role:'Cruz’s son and a storyteller',description:'A young man who recounts hardship, gambling, abuses of authority and frontier service. His testimony adds a separate perspective to the later poem.',reading:'His name suggests cleverness, but the story repeatedly exposes the costs of survival.'},
'la-cautiva':{role:'The captive woman',description:'Her suffering in captivity and Fierro’s intervention are narrated through his perspective in the second part.',reading:'She remains unnamed; the passage requires a critical reading of gender and of period portrayals of Indigenous peoples.'},
'el-moreno':{role:'The Afro-Argentine singer in the payada',description:'An Afro-descendant singer challenges Fierro in a poetic contest of questions and answers, reviving the memory of an earlier death.',reading:'He is not the same man whom Fierro killed in the first part; nor should one literary voice stand for an entire population.'},
'moreno-muerto':{role:'The man killed in a pulpería',description:'An Afro-descendant man dies in a fight with Fierro. The narrator’s account includes racial insults, provocation and violence.',reading:'The narrator’s version of this killing is not an acquittal, and this victim must not be confused with the later singer.'},
'juez-paz':{role:'The justice of the peace',description:'A figure of local authority in Fierro’s account of conscription and persecution. His office recalls actual institutions but is part of the poem’s fiction.',reading:'There is no basis for assigning the fictional judge a specific historical identity.'}
};
const image=(id:string)=>({'martin-fierro':'martin-fierro','sargento-cruz':'sargento-cruz','esposa-fierro':'esposa-de-fierro','primer-hijo':'hijo-mayor-de-fierro','segundo-hijo':'hijo-segundo-de-fierro','don-vizcacha':'viejo-vizcacha','picardia':'picardia','la-cautiva':'la-cautiva','el-moreno':'el-moreno','moreno-muerto':'negro-del-baile','juez-paz':'juez-de-paz'} as Record<string,string>)[id];
---
<Base lang="en-US" pageType="CollectionPage" title="Martín Fierro Characters — An English Guide" description="Meet Martín Fierro, Sergeant Cruz, Don Vizcacha, Picardía, Fierro's sons and the other principal characters. Read their roles, themes, and canto references.">
<article class="international">
<nav class="crumb" aria-label="Breadcrumb"><a href="/en/">English edition</a><span>/</span><span>Characters</span></nav>
<header class="head"><p class="eyebrow">READING COMPANION · CHARACTERS</p><h1>The characters of <em>Martín Fierro</em></h1><p class="deck">A fugitive gaucho, a loyal friend, two sons trying to make sense of their losses, an irreverent guardian, and voices often pushed to the margins. Explore the people who give José Hernández’s poem its moral complexity.</p></header>
<nav class="jump" aria-label="Jump to a character">{personajes.map(p=><a href={`#${p.id}`}>{p.nombre}</a>)}</nav>
<div class="cards">{personajes.map(p=><section class="character" id={p.id} aria-labelledby={`title-${p.id}`}><figure><img src={`/media/fotografias-v3/${image(p.id)}.webp`} alt={`Digital editorial interpretation of ${p.nombre}; not a historical portrait`} loading="lazy"/><figcaption>Modern editorial reconstruction · Not historical evidence</figcaption></figure><div><p class="eyebrow">{notes[p.id].role}</p><h2 id={`title-${p.id}`}>{p.nombre}</h2><p>{notes[p.id].description}</p><p><strong>Reading critically:</strong> {notes[p.id].reading}</p><p class="refs"><strong>Explore the original Spanish text:</strong> {p.referencias.map(r=><a href={`/leer/${r.parte}/${r.canto}/`} lang="es">{r.parte==='ida'?'Part One':'Part Two'} · Canto {r.canto}</a>)}</p></div></section>)}</div>
<section class="method"><h2>How to use this character guide</h2><p>The profiles explain the fictional roles of eleven characters and link to specific cantos in the original Spanish poem. These are interpretive summaries, not quotations or new English translations of Hernández’s verses. The figure of a gaucho in literature should not be mistaken for the full variety of historical rural experience.</p><p>For broader context, read <a href="/en/what-is-martin-fierro/">the English introduction to the poem</a>, <a href="/en/what-is-a-gaucho/">our guide to gaucho history</a>, and <a href="/en/jose-hernandez/">the biography of José Hernández</a>.</p><p><strong>Editorial source:</strong> Character identities and canto references are mapped to the project’s structured Spanish corpus and <a href="/personajes/">Spanish research index</a>. The 46 cantos and 7,210 Spanish verses remain unchanged.</p></section>
</article>
