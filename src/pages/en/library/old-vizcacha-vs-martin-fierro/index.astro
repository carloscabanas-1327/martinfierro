import Base from '../../../../layouts/Base.astro';
import AdSlot from '../../../../components/AdSlot.astro';
import {estrofasDeCanto} from '../../../../lib/corpus';
const vizcacha=estrofasDeCanto('vuelta',15);
const fierro=estrofasDeCanto('vuelta',32);
const comparisons=[{"topic":"Survival and the law","viz":758,"fierro":1153,"comment":"Vizcacha tells the boy to cultivate the judge's favor: the advice rests on access to power. Fierro puts weight on working and sustaining oneself. These are different responses to an unequal society, not a simple split between a bad man and a flawless hero."},{"topic":"Age and experience","viz":757,"fierro":1145,"comment":"Both speakers invoke hard experience. Vizcacha treats age as a survival advantage; Fierro admits that his difficult life has not prevented him from making mistakes. A memorable proverb becomes an argument about whether experience produces judgment or merely tactics."},{"topic":"Friendship and mutual obligation","viz":767,"fierro":1150,"comment":"Vizcacha openly values moving where it serves his interests. Fierro urges loyalty to a friend without demanding repayment. Compare these values carefully: both men understand need, but they draw different conclusions about what one owes another person."},{"topic":"Prudence, cunning and conduct","viz":759,"fierro":1157,"comment":"Avoiding conflict with the powerful is a recurring Vizcacha strategy. Fierro recognizes that cleverness may become prudence or deceit. His distinction complicates any easy claim that the two characters speak with entirely unrelated voices."},{"topic":"Family and relations with others","viz":770,"fierro":1160,"comment":"Vizcacha argues for avoiding marriage and attachment; Fierro insists that brothers should stand together. Their advice points toward opposite responses to vulnerability: minimize obligations, or invest in durable bonds."},{"topic":"Violence and responsibility","viz":773,"fierro":1167,"comment":"Vizcacha emphasizes keeping weapons ready. Fierro's warning against violence is striking precisely because he has killed before. His advice invites critical reflection, not absolution for his earlier actions."}];
const find=(c:number,n:number)=> (c===15?vizcacha:fierro).find(s=>s.numero===n);
const faq=[
{q:'Who is Old Vizcacha in Martín Fierro?',a:'Old Vizcacha is the younger son’s guardian, whose pragmatic and often cynical advice is recalled in Canto XV of the 1879 sequel.'},
{q:'Where are the pieces of advice in Martín Fierro?',a:'The sayings of Old Vizcacha appear in La vuelta de Martín Fierro, Canto XV. Fierro’s advice to his sons appears in Canto XXXII.'},
{q:'How are Old Vizcacha’s and Martín Fierro’s teachings different?',a:'Vizcacha frequently favors self-protection, accommodation to authority and personal advantage, while Fierro places greater stress on labor, solidarity and honesty. Both appeal to practical experience, and neither voice is beyond criticism.'}
];
---
<Base lang="en-US" adKind="article" pageType="Article" title="Old Vizcacha vs Martín Fierro: Advice and Moral Lessons Compared" description="Compare Old Vizcacha's advice with Martín Fierro's advice to his sons. Original Spanish verses from Cantos XV and XXXII, English commentary, themes and study questions.">
<article class="comparison"><nav class="crumb"><a href="/en/">English home</a> / <a href="/en/library/">Popular library</a> / Advice compared</nav><header><p class="eyebrow">MARTÍN FIERRO STUDY GUIDE · THEMES · QUOTES · LITERARY ANALYSIS</p><h1>Old Vizcacha vs. Martín Fierro: <em>Two Ways of Learning from Life</em></h1><p class="lead">The advice of the Old Vizcacha and the advice Martín Fierro gives his sons sound similar at first: both speak in memorable rural sayings and claim the authority of experience. But what kind of life does each recommend? One voice repeatedly asks how to survive; the other asks what kind of conduct might make living together possible.</p></header><figure><img src="/media/fotografias-v3/consejos-fogon-hijos.webp" alt="Modern illustration of Martín Fierro counseling young men by a campfire" fetchpriority="high"/><figcaption>Modern editorial recreation. The source verses below are reproduced directly from the structured corpus, not from this illustration.</figcaption></figure><div class="reading">
<section id="quick-answer"><h2>What is the difference between Martín Fierro and Old Vizcacha?</h2><p><strong>Old Vizcacha</strong> recommends caution, protecting oneself, seeking advantage and adapting to authority, sometimes at the expense of other people. <strong>Martín Fierro</strong>, speaking to his sons, stresses working, keeping friends, maintaining family solidarity and avoiding violence. That contrast is useful, but not absolute: both men are shaped by adversity, and Fierro has not always obeyed the ethics he later teaches.</p><p>These are two distinct speeches in <em>La vuelta de Martín Fierro</em> (1879). Vizcacha's words are reported by Fierro's younger son in <a href="/leer/vuelta/15/" lang="es">Canto XV</a>; Fierro addresses the younger generation in <a href="/leer/vuelta/32/" lang="es">Canto XXXII</a>. The two speakers must never be confused when quoting the poem.</p></section>
<nav class="toc" aria-label="Study sections"><strong>On this page</strong>{comparisons.map((p,i)=><a href={`#compare-${i+1}`}>{p.topic}</a>)}<a href="#study-questions">Study questions</a><a href="#sources">Sources</a></nav>
{comparisons.map((p,i)=><><section id={`compare-${i+1}`} class="case"><h2>{i+1}. {p.topic}</h2><div class="pair"><div class="quotation"><p class="speaker">OLD VIZCACHA · CANTO XV · STANZA {p.viz}</p><blockquote lang="es">{find(15,p.viz)?.versos.map(v=><span>{v.texto}</span>)}</blockquote><a href="/leer/vuelta/15/" lang="en">Read Canto XV in Spanish ↗</a></div><div class="quotation"><p class="speaker">MARTÍN FIERRO · CANTO XXXII · STANZA {p.fierro}</p><blockquote lang="es">{find(32,p.fierro)?.versos.map(v=><span>{v.texto}</span>)}</blockquote><a href={`/en/martin-fierro-advice-to-his-sons/#mf-vuelta-e${p.fierro}`}>Read the complete father's advice ↗</a></div></div><p class="commentary"><strong>English commentary:</strong> {p.comment}</p></section>{i===0&&<AdSlot id="article-02-after-opening-comparison" kind="article"/>}{i===2&&<AdSlot id="article-03-middle" kind="article"/>}{i===4&&<AdSlot id="article-04-near-conclusion" kind="article"/>}</>)}
<section id="study-questions"><h2>Study questions and classroom discussion</h2><ol><li>Which sayings are motivated by fear of poverty or authority, and which by a wish to live with others?</li><li>Does age make either speaker trustworthy? Compare Vizcacha’s claim about old age with Fierro’s admission that he may be mistaken.</li><li>How do Vizcacha’s warnings about attachments differ from Fierro’s advice to brothers?</li><li>Why is Fierro’s warning against violence difficult to read as a straightforward claim of moral superiority?</li><li>Which comparison changes most when read in the larger context of the poem?</li></ol><p>These questions have more than one defensible answer. Use the actual verses and their narrative contexts rather than treating isolated proverbs as the full argument.</p></section>
<section id="questions"><h2>Frequently asked questions</h2>{faq.map(x=><section><h3>{x.q}</h3><p>{x.a}</p></section>)}</section>
<section id="sources"><h2>Sources, original verses and critical readings</h2><p>All quoted Spanish lines on this page are rendered directly from the repository's <em>La vuelta de Martín Fierro</em> corpus. Commentary and comparisons are editorial interpretation, not a translation or an assertion that José Hernández endorsed every character’s words.</p><ul><li><a href="/leer/vuelta/15/" lang="es">Original poem: Canto XV, Old Vizcacha’s sayings</a></li><li><a href="/leer/vuelta/32/" lang="es">Original poem: Canto XXXII, Fierro’s advice</a></li><li><a href="https://entrama.educacion.gob.ar/uploads/documentos/cuadernos_para_el_aula_lengua_6/documento_1.pdf" target="_blank" rel="noopener noreferrer">Argentina's Ministry of Education: Cuadernos para el aula, Lengua 6 (comparative reading activity)</a></li><li><a href="https://www.pagina12.com.ar/305098-los-consejos-del-martin-fierro-y-los-del-viejo-vizcacha-en-l/" target="_blank" rel="noopener noreferrer">Liliana Bellone (2020): Los consejos del Martín Fierro y los del viejo Vizcacha</a></li><li><a href="https://www.cervantesvirtual.com/research/martin-fierro-como-obra-portadora-de-valores-cristianos-enraizados-en-el-ser-cultural-argentino/f8c16284-ca6a-11e1-b1fb-00163ebf5e63.pdf" target="_blank" rel="noopener noreferrer">Biblioteca Virtual Miguel de Cervantes: study of moral values in Martín Fierro</a></li><li><a href="/en/library/themes-and-analysis/">Literary themes and analysis in English</a></li></ul><p>For further reading: <a href="/en/martin-fierro-advice-to-his-sons/">the complete father's advice with commentary</a> and <a href="/en/characters/">the English character guide</a>.</p></section><AdSlot id="article-05-end" kind="article"/>
