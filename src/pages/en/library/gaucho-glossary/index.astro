import Base from '../../../layouts/Base.astro';
import AdSlot from '../../../components/AdSlot.astro';
const terms=[["Gaucho","Rural horseman associated with the pampas and the wider Río de la Plata. A historical and literary category whose meaning has changed."],["Pampas","Extensive grassland plains of South America, especially Argentina and Uruguay; a landscape, not a synonym for every rural region."],["Pulpería","Rural general store that could also serve as a meeting place for trade, conversation and music."],["Payada","A tradition of sung verse, sometimes improvised as an exchange between performers."],["Payador","A singer-poet who performs payadas, often accompanied by guitar."],["Mate","An infusion made from yerba mate leaves, as well as the vessel in which it is often served."],["Yerba mate","The processed leaves of Ilex paraguariensis used to prepare the infusion."],["Bombilla","A filtered drinking straw used for mate."],["Cebar","To prepare and pour successive servings of mate."],["Poncho","A woven outer garment worn as a cloak or protection against the weather."],["Chiripá","A traditional wrapped garment secured around the waist, historically worn in the Río de la Plata countryside."],["Bombachas","Loose trousers associated with regional riding attire; not interchangeable with every earlier garment."],["Facón","A large rural knife, used as a tool and sometimes as a weapon."],["Fortín","A small military outpost on the historical frontier."],["Pingo","A familiar regional term for a horse."],["Recado","Saddle gear or an arrangement of riding equipment; usage varies by region."]];
const sources=[{"name":"Spanish illustrated glossary and cultural guide","url":"/cultura-gauchesca/"},{"name":"English cultural essays","url":"/en/magazine/"},{"name":"Original Spanish poem","url":"/leer/"},{"name":"Argentina.gob.ar: mate cultural heritage","url":"https://www.argentina.gob.ar/cultura/manifestaciones-del-patrimonio-cultural-inmaterial/entre-rios/mate"}];
---
<Base lang="en-US" adKind="article" pageType="Article" title="Gaucho Glossary: 16 Spanish Terms Explained in English" description="A practical gaucho vocabulary guide: mate, bombilla, pulpería, payada, payador, chiripá, poncho, facón, fortín, pingo, recado and more.">
<article class="popular-library"><nav class="crumb" aria-label="Breadcrumb"><a href="/en/">English home</a> / <a href="/en/library/">Popular library</a></nav><header><p class="kicker">MARTINFIERRO.ORG · THE ENGLISH REFERENCE LIBRARY</p><h1>Gaucho Glossary: 16 Spanish Terms Explained in English</h1><p class="intro">Many words in Martín Fierro carry a history that no single English equivalent can fully reproduce. This practical glossary explains key rural and literary terms for readers approaching the poem in Spanish or studying gaucho culture in English.</p></header><figure class="hero"><img src="/media/fotografias-v3/biblioteca-critica.webp" alt="Modern editorial reconstruction of a historical literary library" loading="eager"/><figcaption>Editorial reconstruction, not an archival photograph.</figcaption></figure><div class="body"><section class="terms" aria-label="Gaucho vocabulary">{terms.map(([term,description],i)=><section id={`term-${i+1}`}><h2>{term}</h2><p>{description}</p>{i===3&&<AdSlot id="article-02-after-terms" kind="article"/>}{i===7&&<AdSlot id="article-03-middle" kind="article"/>}{i===11&&<AdSlot id="article-04-late" kind="article"/>}</section>)}</section><section id="sources"><h2>Sources and further reading</h2><p>This original English guide is explanatory scholarship for the general reader. Historical contexts and interpretations should not be confused with the words of the poem itself.</p><ul>{sources.map(s=><li><a href={s.url} target={s.url.startsWith('http')?'_blank':undefined} rel={s.url.startsWith('http')?'noopener noreferrer':undefined}>{s.name}</a></li>)}</ul><p><a href="/en/library/">← Explore the popular library</a> · <a href="/en/characters/">Characters</a></p></section><AdSlot id="article-05-end" kind="article"/></div></article>
