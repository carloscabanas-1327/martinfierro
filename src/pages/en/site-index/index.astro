---
import Base from '../../../layouts/Base.astro';
import {englishSections, englishArticles, cantoGuides, editorialPairs} from '../../../data/en-reference';
---
<Base lang="en-US" pageType="CollectionPage" title="English Site Index — Martín Fierro Reference Library" description="Explore the complete English study collection: 46 canto guides, literary analysis, characters, history, magazine and documentary reference resources.">
<article class="reference"><nav class="crumb"><a href="/en/">English edition</a> / Site index</nav><header><p class="eyebrow">ENGLISH REFERENCE LIBRARY</p><h1>Explore the complete English collection</h1><p class="deck">Find canto-by-canto study guides, characters, cultural essays and original documentary sources. This index distinguishes English commentary from José Hernández’s original Spanish text.</p><p class="actions"><a href="/en/search/">Search the English collection</a> · <a href="/en/students/">For students</a></p></header>
<section><h2>Browse by subject</h2><div class="grid">{englishSections.map(x=><article><h3><a href={x.url}>{x.title}</a></h3><p>{x.description}</p>{x.lang==='es'&&<small>Original text in Spanish</small>}</article>)}</div></section>
<section><h2>Articles and essays</h2><div class="grid">{englishArticles.map(x=><article><h3><a href={x.url}>{x.title}</a></h3><p>{x.description}</p></article>)}</div></section>
<section><h2>All 46 canto study guides</h2><h3>Part One — El gaucho Martín Fierro (1872)</h3><div class="chapters">{cantoGuides.slice(0,13).map(x=><a href={x.url}>{x.title}</a>)}</div><h3>Part Two — La vuelta de Martín Fierro (1879)</h3><div class="chapters">{cantoGuides.slice(13).map(x=><a href={x.url}>{x.title}</a>)}</div></section>
<section><h2>Related Spanish and English research</h2><p>These pages cover the same general subjects but are not necessarily translations or editorially equivalent. The original verse reader remains in Spanish.</p><div class="pair-list">{editorialPairs.map(x=><article><strong>{x.subject}</strong><a href={x.english}>English study or research page</a><a href={x.spanish} lang="es">Spanish research page <span>(Spanish)</span></a></article>)}</div></section>
</article>
<style>.reference{max-width:1060px;margin:28px auto 90px;color:#31291f}.reference a{color:#86402e;text-underline-offset:4px}.crumb{font:.85rem system-ui,sans-serif}.eyebrow{letter-spacing:.13em;font:750 .72rem system-ui,sans-serif;color:#945139}.reference h1{font:600 clamp(2.3rem,5vw,4.4rem)/1.09 Georgia,serif;max-width:22ch}.deck{max-width:76ch;font:1.2rem/1.65 Georgia,serif}.actions{font:600 .95rem system-ui,sans-serif}.reference section{margin:48px 0}.reference h2{font:600 2rem/1.2 Georgia,serif;border-bottom:1px solid #bcaa97;padding-bottom:15px}.reference h3{font:600 1.35rem/1.3 Georgia,serif}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.grid article{background:#eee3d6;border-top:2px solid #554338;padding:18px;min-width:0}.grid p,.reference section>p{font:1rem/1.65 Georgia,serif}.grid small{font:.72rem system-ui,sans-serif}.chapters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.chapters a{padding:11px;border-bottom:1px solid #c2ae99;font:.88rem/1.35 system-ui,sans-serif}.pair-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.pair-list article{display:grid;gap:8px;background:#f1e9dd;padding:16px}.pair-list article a{font:.88rem system-ui,sans-serif}.pair-list span{font-size:.8rem}@media(max-width:700px){.grid,.pair-list{grid-template-columns:1fr}.chapters{grid-template-columns:repeat(2,minmax(0,1fr))}.reference{padding:0 12px}}</style>
</Base>