---
import Base from '../../../../layouts/Base.astro';
import {estrofasDeCanto} from '../../../../lib/corpus';
import {englishVueltaReadings} from '../../../../data/exegesis-vuelta-en';
const groups=[{id:'return',title:'Return and exile',from:1,to:11},{id:'sons',title:'The stories of the sons',from:12,to:19},{id:'picardia',title:'Picardía and authority',from:20,to:28},{id:'payada',title:'The payada and the ending',from:29,to:33}];
const readings=englishVueltaReadings.map(r=>({...r,first:estrofasDeCanto('vuelta',r.canto)[0]}));
---
<Base lang="en-US" pageType="Article" title="La vuelta de Martín Fierro: English Exegesis of 33 Cantos" description="33 original English critical readings of La vuelta de Martín Fierro with authentic Spanish excerpts and links to the original poem.">
<article class="reading-edition"><nav><a href="/en/">English home</a> / <a href="/en/exegesis/">Exegesis</a> / La vuelta</nav><header><p class="eyebrow">LITERARY EXEGESIS · 1879</p><h1>La vuelta de Martín Fierro: 33 critical readings</h1><p class="lead">Narrative voices, exile, the sons, Picardía, the Moreno and the unresolved ending. Every quotation is selected directly from the site's original Spanish corpus.</p><p><strong>Reading note:</strong> These titles and interpretations are editorial, not original headings by Hernández. A character’s account is not necessarily an objective historical record or the author’s personal position.</p></header>
<nav class="jump" aria-label="Narrative movements">{groups.map(g=><a href={`#${g.id}`}>{g.title}</a>)}</nav>
{groups.map(g=><section id={g.id} class="movement"><h2>{g.title}</h2>{readings.filter(r=>r.canto>=g.from&&r.canto<=g.to).map(r=><article id={`canto-${r.canto}`} class="chapter"><p class="eyebrow">PART TWO · CANTO {r.canto}</p><h3>{r.title}</h3><p>{r.analysis}</p>{r.first&&<figure><blockquote lang="es">{r.first.versos.slice(0,6).map(v=><span>{v.texto}</span>)}</blockquote><figcaption>José Hernández, <em>La vuelta de Martín Fierro</em>, Canto {r.canto}, stanza {r.first.numero}. Original Spanish; {r.first.versos.length>6?'opening six lines only.':'complete first stanza.'}</figcaption></figure>}<h4>Context and interpretive limits</h4><p>{r.context}</p><p><a href={`/en/students/vuelta-canto-${r.canto}/`}>English study guide</a> · <a href={`/leer/vuelta/${r.canto}/#${r.first?.id??''}`} lang="es">Original canto (Spanish)</a></p></article>)}</section>)}
<footer><h2>Sources and method</h2><p>All source verses come from the single structured corpus used by the <a href="/leer/vuelta/" lang="es">original Spanish reader</a>. The commentary is a modern literary interpretation, not a certified textual collation or a substitute for historical scholarship. Consult the <a href="/en/archive/">English documentary archive</a> and the <a href="https://www.cervantesvirtual.com/obra/la-vuelta-de-martin-fierro--0/">Biblioteca Virtual Miguel de Cervantes edition</a> for further research.</p></footer></article>
<style>.reading-edition{max-width:1050px;margin:28px auto 80px;color:#30281f}.reading-edition a{color:#87412e}.reading-edition h1{font:600 clamp(2.4rem,5vw,4.4rem)/1.1 Georgia,serif}.reading-edition h2{font:600 clamp(1.8rem,3vw,2.6rem) Georgia,serif}.reading-edition h3{font:600 1.8rem/1.25 Georgia,serif}.reading-edition p{font:1.05rem/1.7 Georgia,serif}.eyebrow{font:750 .73rem system-ui,sans-serif!important;letter-spacing:.12em;color:#8d4c35}.lead{font-size:1.25rem!important}.jump{display:flex;flex-wrap:wrap;gap:18px;border-block:1px solid #b9a58c;padding:20px 0}.movement{margin:45px 0}.chapter{border-top:1px solid #c8b39c;padding:22px 0}.chapter figure{background:#eee3d6;padding:20px;margin:24px 0}.chapter blockquote{font:1.1rem/1.65 Georgia,serif;margin:0}.chapter blockquote span{display:block}.chapter figcaption{font:.78rem/1.5 system-ui,sans-serif;margin-top:15px}.chapter h4{font:700 1rem system-ui,sans-serif}.reading-edition footer{background:#eee3d6;padding:25px}@media(max-width:700px){.reading-edition{padding:0 12px}}</style>
</Base>