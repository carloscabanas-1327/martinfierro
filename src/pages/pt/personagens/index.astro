---
import Base from '../../../layouts/Base.astro';
import {personajes} from '../../../data/personajes';
const fichas:Record<string,{nome:string;papel:string;descricao:string;leitura:string}>={
 'martin-fierro':{nome:'Martín Fierro',papel:'O cantador, protagonista e narrador',descricao:'Gaúcho cuja vida em família desmorona depois do serviço forçado na fronteira. O seu canto fala de injustiça, violência, fuga, amizade e reencontro.',leitura:'Fierro não é José Hernández falando sem filtro. As queixas dele importam, mas as tentativas de justificar a violência também devem ser examinadas.'},
 'sargento-cruz':{nome:'Sargento Cruz',papel:'O sargento que escolhe a amizade',descricao:'Faz parte da partida enviada para prender Fierro, muda de lado e luta com ele. A solidariedade entre os dois é uma das relações centrais do poema.',leitura:'A escolha de Cruz levanta uma pergunta sobre lealdade: o que fazer quando a ordem recebida contraria o próprio senso de justiça?'},
 'esposa-fierro':{nome:'A mulher de Fierro',papel:'A esposa e o lar perdido',descricao:'Presença central na vida familiar que Fierro perde com o recrutamento. A notícia da sua morte chega a ele depois, pela boca dos filhos.',leitura:'O poema não lhe dá voz própria nem um nome fixo, uma ausência que merece atenção.'},
 'primer-hijo':{nome:'O filho mais velho',papel:'O filho que conheceu a prisão',descricao:'Um dos dois filhos que reencontram o pai na segunda parte. O seu relato amplia a história da família com a orfandade, a acusação injusta e a penitenciária.',leitura:'A experiência e a voz dele não devem ser confundidas com as do irmão.'},
 'segundo-hijo':{nome:'O filho mais novo',papel:'O filho criado por Vizcacha',descricao:'A sua história inclui a herança perdida e a vida sob a tutela do Velho Vizcacha, cujos conselhos cínicos misturam comédia amarga e sofrimento.',leitura:'O contraste entre os ditos de Vizcacha e os conselhos finais de Fierro é decisivo.'},
 'don-vizcacha':{nome:'Velho Vizcacha',papel:'O tutor e conselheiro satírico',descricao:'Velho pobre e esperto, nomeado tutor do filho mais novo de Fierro. As suas manias grotescas e os seus ditos interesseiros estão entre os episódios mais lembrados da segunda parte.',leitura:'Os provérbios de Vizcacha não devem ser tomados automaticamente como a moral do poema.'},
 'picardia':{nome:'Picardía',papel:'O filho de Cruz, contador de histórias',descricao:'Jovem que narra orfandade, jogo, abusos de autoridade e o serviço na fronteira, até descobrir que é filho do sargento Cruz.',leitura:'O nome sugere esperteza, mas a sua história mostra repetidamente o preço da sobrevivência.'},
 'la-cautiva':{nome:'A cativa',papel:'A mulher raptada num malón',descricao:'O seu sofrimento no cativeiro e a intervenção de Fierro são narrados pela perspectiva dele na segunda parte.',leitura:'Ela não tem nome; o trecho pede leitura crítica sobre gênero e sobre o retrato dos indígenas na época.'},
 'el-moreno':{nome:'O Moreno',papel:'O cantador negro da payada',descricao:'Um cantador afrodescendente desafia Fierro num duelo poético de perguntas e respostas e reabre a memória de uma morte antiga.',leitura:'Não é o homem que Fierro matou na primeira parte, mas irmão dele; e uma só voz literária não representa uma população inteira.'},
 'moreno-muerto':{nome:'O homem morto no baile',papel:'A vítima do canto VII',descricao:'Um homem negro morre numa briga com Fierro. O relato do narrador inclui insultos raciais, provocação e violência.',leitura:'A versão do narrador não é uma absolvição, e esta vítima não deve ser confundida com o cantador da payada.'},
 'juez-paz':{nome:'O juiz de paz',papel:'A autoridade local',descricao:'Figura do poder local no relato do recrutamento e da perseguição. O cargo lembra instituições reais, mas o personagem é ficção.',leitura:'Não há base para atribuir ao juiz do poema uma identidade histórica precisa.'},
};
const imagem=(id:string)=>({'martin-fierro':'martin-fierro','sargento-cruz':'sargento-cruz','esposa-fierro':'esposa-de-fierro','primer-hijo':'hijo-mayor-de-fierro','segundo-hijo':'hijo-segundo-de-fierro','don-vizcacha':'viejo-vizcacha','picardia':'picardia','la-cautiva':'la-cautiva','el-moreno':'el-moreno','moreno-muerto':'negro-del-baile','juez-paz':'juez-de-paz'} as Record<string,string>)[id];
const guia=(r:{parte:'ida'|'vuelta';canto:number})=>`/pt/estudantes/${r.parte==='ida'?'ida':'volta'}/${r.canto}/`;
---
<Base migas={[{label:'Personagens'}]} lingue={{es:'/personajes/',en:'/en/characters/'}} lang="pt-BR" noindex={true} pageType="CollectionPage" title="Os personagens de Martín Fierro: guia em português" description="Martín Fierro, o sargento Cruz, o Velho Vizcacha, Picardía, os filhos, a cativa e o Moreno: quem são os personagens do poema de José Hernández e como lê-los com senso crítico.">
<article class="personagens-pt">
<header><p class="eyebrow">GUIA DE LEITURA · PERSONAGENS</p><h1>Os personagens de <em>Martín Fierro</em></h1><p class="deck">Um gaúcho fugitivo, um amigo leal, dois filhos tentando entender as próprias perdas, um tutor irreverente e vozes empurradas para a margem. Conheça as pessoas que dão ao poema a sua complexidade moral.</p></header>
<nav class="saltos" aria-label="Ir para um personagem">{personajes.map(p=><a href={`#${p.id}`}>{fichas[p.id].nome}</a>)}</nav>
<div class="cartoes">{personajes.map(p=><section class="cartao" id={p.id} aria-labelledby={`t-${p.id}`}><figure><img src={`/media/fotografias-v3/${imagem(p.id)}.webp`} alt={`Interpretação editorial digital de ${fichas[p.id].nome}; não é retrato histórico`} loading="lazy"/><figcaption>Recriação editorial contemporânea</figcaption></figure><div><p class="eyebrow">{fichas[p.id].papel}</p><h2 id={`t-${p.id}`}>{fichas[p.id].nome}</h2><p>{fichas[p.id].descricao}</p><p><strong>Leitura crítica:</strong> {fichas[p.id].leitura}</p><p class="refs"><strong>Nos guias:</strong> {p.referencias.map(r=><a href={guia(r)}>{r.parte==='ida'?'Primeira parte':'Segunda parte'} · canto {r.canto}</a>)}</p></div></section>)}</div>
<section class="metodo"><h2>Como usar este guia</h2><p>As fichas explicam o papel de onze personagens e levam aos guias de estudo de cada canto, onde estão as estrofes originais. São resumos interpretativos, não citações nem traduções dos versos de Hernández. As ilustrações são recriações modernas, não documentos históricos.</p></section>
</article>
<style>.personagens-pt{max-width:1100px;margin:25px auto 80px;color:#31291f}.personagens-pt a{color:#843e2c;text-underline-offset:4px}.eyebrow{font:750 .72rem system-ui,sans-serif;letter-spacing:.13em;color:#955138;text-transform:uppercase}.personagens-pt h1{font:600 clamp(2.5rem,5vw,4.6rem)/1.08 Georgia,serif;letter-spacing:-.04em;margin:18px 0}.personagens-pt h1 em{font-weight:400}.deck{font:1.2rem/1.65 Georgia,serif;max-width:75ch}.saltos{border-block:1px solid #cbb9a5;display:flex;flex-wrap:wrap;gap:10px 17px;padding:19px 0;margin:35px 0;font:.86rem system-ui,sans-serif}.cartoes{display:grid;gap:30px}.cartao{display:grid;grid-template-columns:300px 1fr;gap:30px;border-top:2px solid #382d25;padding-top:24px;scroll-margin-top:70px}.cartao figure{margin:0}.cartao img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:4px}.cartao figcaption{font:.72rem system-ui,sans-serif;color:#74614d;margin-top:6px}.cartao h2{font:600 2rem Georgia,serif;margin:6px 0 12px}.cartao p{font:1.04rem/1.75 Georgia,serif}.refs{display:flex;flex-wrap:wrap;gap:6px 14px;font:.86rem system-ui,sans-serif!important}.metodo{background:#efe3d5;padding:22px 26px;margin-top:40px}.metodo h2{font:600 1.7rem Georgia,serif;margin:0 0 10px}.metodo p{font:1.03rem/1.7 Georgia,serif}@media(max-width:720px){.cartao{grid-template-columns:1fr;gap:14px}.cartao img{aspect-ratio:3/2}.metodo{padding:18px}}</style>
</Base>
