---
import Base from '../../../layouts/Base.astro';
const artigos=[
 {url:'/pt/revista/chimarrao/',chamada:'O mundo do gaúcho · Rio Grande do Sul e Prata',titulo:'Chimarrão: a erva que une o Pampa',texto:'Da erva dos guaranis às missões jesuíticas, dos ervais do Paraná à roda gaúcha: a história da cuia que passa de mão em mão, e o mate amargo nos versos de Martín Fierro.',img:'/media/fotografias-v3/chimarrao-chaleira-cuia.webp',alt:'Recriação digital de chaleira e cuia de chimarrão no campo'},
];
---
<Base migas={[{label:'Revista'}]} lingue={{es:'/revista/',en:'/en/magazine/',it:'/it/rivista/'}} lang="pt-BR" noindex={true} pageType="CollectionPage" title="Revista cultural: o mundo do gaúcho, do Prata ao Sul do Brasil" description="A revista cultural da edição brasileira do MARTINFIERRO.ORG: chimarrão, tradições do Pampa e o mundo rural do poema de José Hernández.">
<div class="revista-pt">
 <header><p class="eyebrow">REVISTA CULTURAL · EM PORTUGUÊS</p><h1>O mundo do gaúcho, dos dois lados da fronteira</h1><p class="deck">Artigos sobre a cultura rural do Pampa, que une o Rio Grande do Sul, o Uruguai e a Argentina, escritos para leitores brasileiros e sempre com as fontes indicadas.</p></header>
 <div class="lista">{artigos.map(a=><article><a href={a.url}><img src={a.img} alt={a.alt} loading="lazy" decoding="async"/><div><p class="chamada">{a.chamada}</p><h2>{a.titulo}</h2><p>{a.texto}</p><strong>Ler o artigo →</strong></div></a></article>)}</div>
 <section class="mais"><h2>Novos artigos a caminho</h2><p>A revista brasileira vai crescer com textos sobre a payada, a pulpería e o bolicho, os fortins da fronteira e o Dia da Tradição argentino. Enquanto isso, a revista em espanhol já tem dezenas de artigos, e quem lê português acompanha boa parte deles sem dificuldade.</p><p><a href="/revista/" lang="es">Revista cultural em espanhol</a> · <a href="/en/magazine/" lang="en">Cultural magazine (em inglês)</a> · <a href="/pt/conselhos-de-martin-fierro/">Os conselhos de Martín Fierro aos filhos</a></p></section>
</div>
<style>.revista-pt{max-width:1000px;margin:25px auto 85px;color:#302820}.revista-pt a{color:#853d2b;text-underline-offset:4px}.eyebrow{font:750 .72rem system-ui,sans-serif;letter-spacing:.13em;color:#934e35}.revista-pt h1{font:600 clamp(2.3rem,5vw,4.2rem)/1.1 Georgia,serif;letter-spacing:-.03em;margin:16px 0;text-wrap:balance}.deck{font:1.2rem/1.65 Georgia,serif;max-width:70ch}.lista{display:grid;gap:22px;margin:36px 0}.lista article{border-top:2px solid #382d25;background:#f3ecdf}.lista a{display:grid;grid-template-columns:300px 1fr;gap:24px;text-decoration:none;color:inherit}.lista img{width:100%;height:100%;min-height:220px;object-fit:cover}.lista div{padding:20px 22px 22px 0}.chamada{font:750 .7rem system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#8b4731;margin:0}.lista h2{font:600 clamp(1.6rem,3vw,2.2rem)/1.15 Georgia,serif;margin:8px 0 10px}.lista p:not(.chamada),.mais p{font:1.04rem/1.7 Georgia,serif}.lista strong{font:700 .84rem system-ui,sans-serif;text-decoration:underline}.mais{background:#eee3d7;padding:22px 28px}.mais h2{font:600 1.7rem Georgia,serif;margin:0 0 10px}@media(max-width:650px){.lista a{grid-template-columns:1fr;gap:0}.lista img{height:210px;min-height:0}.lista div{padding:16px}.mais{padding:18px}}</style>
</Base>
