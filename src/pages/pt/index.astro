.pt-abertura h2{font:600 clamp(1.9rem,3.4vw,3rem)/1.15 Georgia,serif;margin:0 0 22px}
.pt-abertura-grade{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.pt-abertura figure{margin:0;background:#f3ecdf;padding:22px 26px;border-top:2px solid #382d25}
.pt-abertura figcaption{font:700 .72rem system-ui,sans-serif;letter-spacing:.1em;color:#8b4731;text-transform:uppercase}
.pt-abertura blockquote{margin:12px 0 0}.pt-abertura blockquote span{display:block;font:1.15rem/1.7 Georgia,serif}
.pt-abertura figure p{font:1.08rem/1.7 Georgia,serif;margin:12px 0 0}
.pt-abertura>p{font:.92rem system-ui,sans-serif;margin-top:18px}
@media(max-width:700px){.pt-abertura-grade{grid-template-columns:1fr}}
</style>
</Base>
