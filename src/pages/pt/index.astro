---
import Base from '../../layouts/Base.astro';
import ConsejosPortada from '../../components/ConsejosPortada.astro';
import '../../styles/portale-edizione.css';
import {estrofasDeCanto} from '../../lib/corpus';
import {aberturaPt} from '../../data/pt-estudo';
const primeira=estrofasDeCanto('ida',1)[0];
const secoes=[
 {n:'01',titulo:'Ler o poema no original',texto:'Um guia para brasileiros: as grafias do espanhol do campo, as palavras que enganam e o caminho para cada um dos 46 cantos.',href:'/pt/ler-o-poema/',img:'/media/fotografias-v3/la-ida.webp',alt:'Recriação digital de um gaúcho no campo argentino'},
 {n:'02',titulo:'Os conselhos aos filhos',texto:'O canto XXXII completo, estrofe por estrofe, com tradução de estudo em português e notas de leitura.',href:'/pt/conselhos-de-martin-fierro/',img:'/media/fotografias-v3/consejos-fogon-hijos.webp',alt:'Recriação digital de Martín Fierro aconselhando os filhos junto ao fogo'},
 {n:'03',titulo:'Chimarrão: a erva que une o Pampa',texto:'Dos guaranis às missões, dos ervais do Paraná à roda gaúcha, e o mate amargo nos versos do poema.',href:'/pt/revista/chimarrao/',img:'/media/fotografias-v3/mate-pava-yerba.webp',alt:'Recriação digital de cuia, chaleira e erva-mate'},
 {n:'04',titulo:'Revista cultural',texto:'Tradições do Pampa contadas para leitores brasileiros: a cultura rural que une o Rio Grande do Sul, o Uruguai e a Argentina.',href:'/pt/revista/',img:'/media/fotografias-v3/revista-cultural.webp',alt:'Recriação digital da vida rural no pampa do século XIX'},
];
---
<Base lang="pt-BR" noindex={true} pageType="CollectionPage" title="Martín Fierro em português: o poema do gaúcho argentino" description="Martín Fierro, de José Hernández, para leitores brasileiros: os versos no original espanhol com traduções de estudo, os conselhos aos filhos, o chimarrão e o mundo do gaúcho dos dois lados da fronteira.">
<div class="en-portal pt-portal" lang="pt-BR">
 <div class="mf-editionline"><span>EDIÇÃO CULTURAL · ARGENTINA E BRASIL</span><span>JOSÉ HERNÁNDEZ · 1872 / 1879</span><a href="/pt/ler-o-poema/">COMO LER ESTA EDIÇÃO ↗</a></div>
 <section class="en-hero" aria-labelledby="pt-titulo">
  <div class="en-visual">
   <img src="/media/fotografias-v3/hero-gaucho-pampa.webp" width="1440" height="850" fetchpriority="high" alt="Recriação digital de um gaúcho a cavalo no pampa ao entardecer"/>
   <p>RECRIAÇÃO EDITORIAL · NÃO É FOTOGRAFIA HISTÓRICA</p>
  </div>
  <div class="en-hero-copy">
   <p class="en-kicker">JOSÉ HERNÁNDEZ · 1872 / 1879</p>
   <h1 id="pt-titulo">Martín Fierro: <em>o poema do gaúcho, para leitores brasileiros.</em></h1>
   <p class="en-lead">Um cantador, um desertor, um pai que volta para casa. O grande poema argentino fala de um mundo que o Rio Grande do Sul conhece bem: o pampa, o cavalo, o fogo de chão e a cuia que passa de mão em mão.</p>
   <div class="en-actions"><a class="en-button" href="/pt/ler-o-poema/">Comece a ler <span aria-hidden="true">↗</span></a><a class="en-outline" href="#explorar">Explore a edição ↓</a></div>
   <p class="en-language-note">Os versos aparecem sempre no espanhol original de José Hernández (7.210 versos em 46 cantos), acompanhados de traduções de estudo e comentários em português da nossa redação.</p>
  </div>
 </section>

 <ConsejosPortada id="pt-conselhos" kicker="LA VUELTA · CANTO XXXII · 1879 · FÉ · TRABALHO · AMIZADE" titulo="Os conselhos de Martín Fierro aos filhos" texto="Um velho do campo reúne o que a vida lhe ensinou: a fé, o domínio de si, o trabalho honrado, a amizade e a união entre irmãos. Leia o canto inteiro no original, com uma tradução de estudo para cada estrofe." llamado="Ler os conselhos" href="/pt/conselhos-de-martin-fierro/" alt="Recriação digital de Martín Fierro, seus dois filhos e o filho de Cruz ouvindo os conselhos junto ao fogo e ao mate"/>

 <section class="pt-abertura" aria-labelledby="pt-abertura-titulo">
  <p class="en-kicker">ASSIM COMEÇA O POEMA</p>
  <h2 id="pt-abertura-titulo">A primeira estrofe, no original e em português</h2>
  <div class="pt-abertura-grade">
   <figure lang="es"><figcaption>José Hernández, 1872</figcaption><blockquote>{primeira.versos.map(v=><span>{v.texto}</span>)}</blockquote></figure>
   <figure><figcaption>Tradução de estudo, em prosa</figcaption><p>{aberturaPt[primeira.numero]}</p></figure>
  </div>
  <p><a href="/pt/ler-o-poema/">Leia as primeiras estrofes com o vocabulário explicado →</a> · <a href="/leer/ida/1/" lang="es">Leer el canto I en español →</a></p>
 </section>

 <section class="en-first-feature" aria-labelledby="pt-pampa"><div><p class="en-kicker">UM SÓ PAMPA</p><h2 id="pt-pampa">O mesmo gaúcho dos dois lados da fronteira</h2><p>A planície que vai de Buenos Aires ao Rio Grande do Sul criou um mesmo tipo humano, com o mesmo poncho, a mesma bombacha e quase as mesmas palavras: pago, pingo, china, bagual, bolicho. Quem fala gauchês tem meio caminho andado para ler Martín Fierro no original. E o próprio José Hernández viveu exilado em Santana do Livramento, na fronteira gaúcha, pouco antes de escrever o poema.</p><a href="/pt/estudantes/glossario/">Glossário com as palavras irmãs ↗</a> · <a href="/pt/jose-hernandez/">José Hernández ↗</a> · <a href="/pt/revista/chimarrao/">De cimarrón a chimarrão ↗</a></div></section>

 <section class="en-first-feature" aria-labelledby="pt-estudantes"><div><p class="en-kicker">PARA ESTUDANTES</p><h2 id="pt-estudantes">Os 46 cantos, um por um</h2><p>Para cada canto, um guia em português: resumo, as estrofes originais mais importantes, personagens, temas, palavras do espanhol gauchesco e perguntas para a sala de aula ou o clube de leitura.</p><a href="/pt/estudantes/">Abrir os guias de estudo ↗</a> · <a href="/pt/personagens/">Os personagens ↗</a> · <a href="/pt/estudantes/ida/1/">Começar pelo canto I ↗</a></div></section>

 <section id="explorar" class="en-section" aria-labelledby="pt-explorar">
  <div class="en-section-heading"><p class="en-kicker">EXPLORE A EDIÇÃO</p><h2 id="pt-explorar">O poema, os conselhos, o mundo do gaúcho.</h2></div>
  <div class="en-grid">{secoes.map(s=><article class="en-card"><a href={s.href}><div class="en-image"><img src={s.img} alt={s.alt} loading="lazy" decoding="async"/></div><div class="en-card-copy"><span>{s.n} / A EDIÇÃO</span><h3>{s.titulo}</h3><p>{s.texto}</p><strong>Explore a seção <span aria-hidden="true">↗</span></strong></div></a></article>)}</div>
 </section>

 <section class="en-translation" aria-labelledby="pt-traducoes"><div><p class="en-kicker">AS TRADUÇÕES BRASILEIRAS</p><h2 id="pt-traducoes">Seis traduções feitas no Brasil.</h2><p>O português é a língua com mais traduções de Martín Fierro. A primeira completa, de João Otávio Nogueira Leiria, saiu em Porto Alegre em 1972, no centenário do poema; vieram depois as de Leopoldo Jobim e Walmir Ayala, além de trechos traduzidos por Cecília Meireles e Josué Montello. Como essas traduções têm direitos de autor, esta edição não as reproduz: oferece o original, traduções de estudo próprias e comentário, para ler ao lado do exemplar que você tem em casa.</p><div class="en-actions"><a class="en-button" href="/pt/ler-o-poema/#pt-traducoes">Saiba mais ↗</a><a class="en-outline" href="/traducciones/" lang="es">Catálogo de traduções (em espanhol) ↗</a></div></div><img src="/media/archivo/ejemplar-corregido-martin-fierro-1872-portada.webp" alt="Capa da primeira edição de El gaucho Martín Fierro, 1872" loading="lazy"/></section>

 <section class="en-final" aria-labelledby="pt-final"><p class="en-kicker">UMA BIBLIOTECA DOCUMENTAL</p><h2 id="pt-final">Quatro línguas, um só poema.</h2><p>MARTINFIERRO.ORG é uma edição digital independente em espanhol, inglês, italiano e, agora, português. Todas as edições compartilham o mesmo texto original e separam sempre as fontes históricas das interpretações modernas.</p><p><a href="/" lang="es">Edición en español</a> · <a href="/en/" lang="en">English edition</a> · <a href="/it/" lang="it">Edizione italiana</a></p></section>
</div>
