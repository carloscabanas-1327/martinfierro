---
import Base from '../../../layouts/Base.astro';
import {personajes} from '../../../data/personajes';
const fiches:Record<string,{nom:string;role:string;description:string;lecture:string}>={
 'martin-fierro':{nom:'Martín Fierro',role:'Le chanteur, protagoniste et narrateur',description:'Gaucho dont la vie de famille s’effondre après le service forcé à la frontière. Son chant parle d’injustice, de violence, de fuite, d’amitié et de retrouvailles.',lecture:'Fierro n’est pas José Hernández parlant sans filtre. Ses plaintes comptent, mais ses tentatives de justifier la violence doivent aussi être examinées.'},
 'sargento-cruz':{nom:'Le sergent Cruz',role:'Le sergent qui choisit l’amitié',description:'Il fait partie de la patrouille envoyée pour arrêter Fierro, change de camp et se bat à ses côtés. La solidarité entre les deux hommes est l’une des relations centrales du poème.',lecture:'Le choix de Cruz pose une question de loyauté : que faire quand l’ordre reçu contredit son propre sens de la justice ?'},
 'esposa-fierro':{nom:'La femme de Fierro',role:'L’épouse et le foyer perdu',description:'Présence centrale dans la vie familiale que Fierro perd avec l’enrôlement. La nouvelle de sa mort lui parvient plus tard, par la bouche de ses fils.',lecture:'Le poème ne lui donne ni voix propre ni nom fixe, une absence qui mérite l’attention.'},
 'primer-hijo':{nom:'Le fils aîné',role:'Le fils qui a connu la prison',description:'L’un des deux fils qui retrouvent leur père dans la seconde partie. Son récit élargit l’histoire de la famille : l’abandon, l’accusation injuste, le pénitencier.',lecture:'Son expérience et sa voix ne doivent pas être confondues avec celles de son frère.'},
 'segundo-hijo':{nom:'Le fils cadet',role:'Le fils élevé par Vizcacha',description:'Son histoire comprend l’héritage perdu et la vie sous la tutelle du Vieux Vizcacha, dont les conseils cyniques mêlent comédie amère et souffrance.',lecture:'Le contraste entre les maximes de Vizcacha et les derniers conseils de Fierro est décisif.'},
 'don-vizcacha':{nom:'Le Vieux Vizcacha',role:'Le tuteur et conseiller satirique',description:'Vieillard pauvre et rusé, nommé tuteur du fils cadet de Fierro. Ses manies grotesques et ses maximes intéressées comptent parmi les épisodes les plus célèbres de la seconde partie.',lecture:'Les proverbes de Vizcacha ne doivent pas être pris automatiquement pour la morale du poème.'},
 'picardia':{nom:'Picardía',role:'Le fils de Cruz, conteur',description:'Jeune homme qui raconte son enfance d’orphelin, le jeu, les abus d’autorité et le service à la frontière, jusqu’à découvrir qu’il est le fils du sergent Cruz.',lecture:'Son nom évoque la ruse, mais son histoire montre sans cesse le prix de la survie.'},
 'la-cautiva':{nom:'La captive',role:'La femme enlevée lors d’un malón',description:'Sa souffrance en captivité et l’intervention de Fierro sont racontées du point de vue de celui-ci dans la seconde partie.',lecture:'Elle n’a pas de nom ; le passage appelle une lecture critique sur le genre et sur la représentation des Indiens à l’époque.'},
 'el-moreno':{nom:'Le Moreno',role:'Le chanteur noir de la payada',description:'Un chanteur afro-descendant défie Fierro dans une joute poétique de questions et de réponses et réveille le souvenir d’une mort ancienne.',lecture:'Ce n’est pas l’homme que Fierro a tué dans la première partie, mais son frère ; et une seule voix littéraire ne représente pas toute une population.'},
 'moreno-muerto':{nom:'L’homme tué au bal',role:'La victime du chant VII',description:'Un homme noir meurt dans une rixe avec Fierro. Le récit du narrateur comprend des insultes racistes, de la provocation et de la violence.',lecture:'La version du narrateur n’est pas un acquittement, et cette victime ne doit pas être confondue avec le chanteur de la payada.'},
 'juez-paz':{nom:'Le juge de paix',role:'L’autorité locale',description:'Figure du pouvoir local dans le récit de l’enrôlement et de la persécution. La fonction renvoie à des institutions réelles, mais le personnage est une fiction.',lecture:'Rien ne permet d’attribuer au juge du poème une identité historique précise.'},
};
const image=(id:string)=>({'martin-fierro':'martin-fierro','sargento-cruz':'sargento-cruz','esposa-fierro':'esposa-de-fierro','primer-hijo':'hijo-mayor-de-fierro','segundo-hijo':'hijo-segundo-de-fierro','don-vizcacha':'viejo-vizcacha','picardia':'picardia','la-cautiva':'la-cautiva','el-moreno':'el-moreno','moreno-muerto':'negro-del-baile','juez-paz':'juez-de-paz'} as Record<string,string>)[id];
const fiche=(r:{parte:'ida'|'vuelta';canto:number})=>`/fr/etudiants/${r.parte==='ida'?'aller':'retour'}/${r.canto}/`;
---
<Base migas={[{label:'Personnages'}]} lingue={{es:'/personajes/',en:'/en/characters/',pt:'/pt/personagens/'}} lang="fr-FR" pageType="CollectionPage" title="Les personnages de Martín Fierro : guide en français" description="Martín Fierro, le sergent Cruz, le Vieux Vizcacha, Picardía, les fils, la captive et le Moreno : qui sont les personnages du poème de José Hernández et comment les lire avec esprit critique.">
<article class="personnages-fr">
<header><p class="eyebrow">GUIDE DE LECTURE · PERSONNAGES</p><h1>Les personnages de <em>Martín Fierro</em></h1><p class="chapo">Un gaucho fugitif, un ami loyal, deux fils qui tentent de comprendre leurs pertes, un tuteur sans scrupules et des voix reléguées aux marges. Découvrez les figures qui donnent au poème sa complexité morale.</p></header>
<nav class="sauts" aria-label="Aller à un personnage">{personajes.map(p=><a href={`#${p.id}`}>{fiches[p.id].nom}</a>)}</nav>
<div class="cartes">{personajes.map(p=><section class="carte" id={p.id} aria-labelledby={`t-${p.id}`}><figure><img src={`/media/fotografias-v3/${image(p.id)}.webp`} alt={`Interprétation éditoriale numérique : ${fiches[p.id].nom} ; ce n’est pas un portrait historique`} loading="lazy"/><figcaption>Reconstitution éditoriale contemporaine</figcaption></figure><div><p class="eyebrow">{fiches[p.id].role}</p><h2 id={`t-${p.id}`}>{fiches[p.id].nom}</h2><p>{fiches[p.id].description}</p><p><strong>Lecture critique :</strong> {fiches[p.id].lecture}</p><p class="refs"><strong>Dans les fiches :</strong> {p.referencias.map(r=><a href={fiche(r)}>{r.parte==='ida'?'Première partie':'Seconde partie'} · chant {r.canto}</a>)}</p></div></section>)}</div>
<section class="methode"><h2>Comment utiliser ce guide</h2><p>Ces fiches expliquent le rôle de onze personnages et renvoient aux fiches d’étude de chaque chant, où figurent les strophes originales. Ce sont des résumés interprétatifs, non des citations ni des traductions des vers de Hernández. Les illustrations sont des reconstitutions modernes, non des documents historiques.</p></section>
</article>
<style>.personnages-fr{max-width:1100px;margin:25px auto 80px;color:#31291f}.personnages-fr a{color:#843e2c;text-underline-offset:4px}.eyebrow{font:750 .72rem system-ui,sans-serif;letter-spacing:.13em;color:#955138;text-transform:uppercase}.personnages-fr h1{font:600 clamp(2.5rem,5vw,4.6rem)/1.08 Georgia,serif;letter-spacing:-.04em;margin:18px 0}.personnages-fr h1 em{font-weight:400}.chapo{font:1.2rem/1.65 Georgia,serif;max-width:75ch}.sauts{border-block:1px solid #cbb9a5;display:flex;flex-wrap:wrap;gap:10px 17px;padding:19px 0;margin:35px 0;font:.86rem system-ui,sans-serif}.cartes{display:grid;gap:30px}.carte{display:grid;grid-template-columns:300px 1fr;gap:30px;border-top:2px solid #382d25;padding-top:24px;scroll-margin-top:70px}.carte figure{margin:0}.carte img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:4px}.carte figcaption{font:.72rem system-ui,sans-serif;color:#74614d;margin-top:6px}.carte h2{font:600 2rem Georgia,serif;margin:6px 0 12px}.carte p{font:1.04rem/1.75 Georgia,serif}.refs{display:flex;flex-wrap:wrap;gap:6px 14px;font:.86rem system-ui,sans-serif!important}.methode{background:#efe3d5;padding:22px 26px;margin-top:40px}.methode h2{font:600 1.7rem Georgia,serif;margin:0 0 10px}.methode p{font:1.03rem/1.7 Georgia,serif}@media(max-width:720px){.carte{grid-template-columns:1fr;gap:14px}.carte img{aspect-ratio:3/2}.methode{padding:18px}}</style>
</Base>
