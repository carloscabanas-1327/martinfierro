---
import Base from '../../layouts/Base.astro';
import {idiomas} from '../../data/idiomas';
const ficha=idiomas.find(i=>i.codigo==='fr')!;
---
<Base title={ficha.titulo} description={ficha.intro} lang="fr" pageType="CollectionPage" noindex={ficha.estado !== 'original'}>
  <div class="breadcrumbs"><a href="/">Martín Fierro</a><span>{ficha.nombre}</span></div>
  <section class="section-intro">
    <p class="eyebrow">MARTINFIERRO.ORG · {ficha.nombre}</p>
    <h1>{ficha.titulo}</h1>
    <p class="lead">{ficha.intro}</p>
  </section>
  <nav class="language-picker" aria-label="Idiomas · Languages">
    {idiomas.map(i=><a href={`/${i.codigo}/`} lang={i.codigo} aria-current={i.codigo === ficha.codigo ? 'page' : undefined}>{i.nombre}</a>)}
  </nav>
  <section class="editorial-paper" aria-labelledby="traduccion-documentada">
    <p class="eyebrow">{ficha.estado==='original'?'Texto original · 1872 y 1879':'Catálogo documental · Verificación pendiente'}</p>
    <h2 id="traduccion-documentada">{ficha.traduccion}</h2>
    <p>{ficha.nota}</p>
    {ficha.estado!=='original' && <p><strong>Nota editorial:</strong> la referencia procede del inventario preliminar del proyecto; no implica que exista una edición íntegra localizada, ni que sea de dominio público o esté autorizada para reproducirse.</p>}
  </section>
  <div class="editorial-directory">
    <a class="directory-feature" href="/leer/ida/"><span class="directory-mark">1872 · ORIGINAL</span><h2>El gaucho Martín Fierro</h2><p>13 cantos · texto original en español</p><span class="text-link">Leer →</span></a>
    <a class="directory-feature" href="/leer/vuelta/"><span class="directory-mark">1879 · ORIGINAL</span><h2>La vuelta de Martín Fierro</h2><p>33 cantos · texto original en español</p><span class="text-link">Leer →</span></a>
    <a class="directory-feature" href="/archivo/"><span class="directory-mark">FUENTES</span><h2>Archivo documental</h2><p>Procedencia del corpus, metodología y recursos de investigación en español</p><span class="text-link">Consultar →</span></a>
  </div>
  <p class="notice">Las fichas internacionales son páginas documentales iniciales, no traducciones publicadas. Los enlaces a la obra llevan a la edición original española.</p>
</Base>
