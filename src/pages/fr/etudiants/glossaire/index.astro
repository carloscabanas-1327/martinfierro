---
import Base from '../../../../layouts/Base.astro';
import ArticleFr from '../../../../components/ArticleFr.astro';
// Quand un mot français proche existe, on l’indique (« En français »).
const entrees:{mot:string;type:string;sens:string;poeme:string;francais?:string;url:string}[]=[
 {mot:'Gaucho',type:'Terme historique et culturel',sens:'Cavalier des plaines d’Argentine, d’Uruguay et du sud du Brésil.',poeme:'Le mot renvoie au travail, à l’habileté, à une position sociale et à une identité littéraire discutée. Fierro parle en gaucho, non au nom de tous les gauchos.',url:'/fr/lire-le-poeme/'},
 {mot:'Payada',type:'Poésie orale et musique',sens:'Poésie chantée et improvisée du Río de la Plata, souvent sous forme de joute entre deux chanteurs à la guitare.',poeme:'Le Moreno et Fierro s’affrontent dans une payada qui rouvre une violence non résolue.',francais:'joute chantée',url:'/fr/etudiants/retour/30/'},
 {mot:'Pulpería',type:'Institution rurale',sens:'Épicerie-buvette de campagne et lieu de rencontre, où l’on achetait des provisions, où l’on buvait et parfois chantait.',poeme:'Plusieurs rixes du poème ont lieu dans ces espaces.',francais:'épicerie-buvette',url:'/fr/etudiants/aller/8/'},
 {mot:'Fortín',type:'Institution de frontière',sens:'Petit poste militaire sur la frontière avec les territoires autochtones.',poeme:'Fierro y décrit la misère et l’exploitation pendant son service.',francais:'fortin',url:'/fr/etudiants/aller/4/'},
 {mot:'Leva',type:'Terme militaire et politique',sens:'Enrôlement forcé d’hommes pour le service militaire.',poeme:'Elle explique pourquoi la frontière détruit la vie familiale de Fierro.',francais:'levée',url:'/fr/etudiants/aller/3/'},
 {mot:'Partida',type:'Groupe armé',sens:'Patrouille formée pour une mission ; dans le poème, presque toujours la force qui poursuit quelqu’un.',poeme:'Cruz fait partie de la patrouille qui traque Fierro avant de le défendre.',francais:'patrouille',url:'/fr/etudiants/aller/9/'},
 {mot:'Facón',type:'Culture matérielle',sens:'Grand couteau associé au gaucho historique.',poeme:'Les combats au couteau ne doivent pas être lus comme un éloge de la violence.',url:'/fr/etudiants/aller/7/'},
 {mot:'Mate, cimarrón',type:'Boisson',sens:'Infusion de yerba maté ; le mot désigne aussi la calebasse où on la boit. Le cimarrón est le maté amer, sans sucre.',poeme:'Fierro se souvient du cimarrón bu près du feu avant l’aube.',francais:'maté',url:'/fr/revue/mate/'},
 {mot:'Pago',type:'Lieu',sens:'Le pays natal, le lieu d’origine.',poeme:'Revenir au pago et le trouver en ruine est l’un des coups les plus durs de la première partie.',francais:'le pays, au sens de « mon pays »',url:'/fr/etudiants/aller/6/'},
 {mot:'Tapera',type:'Lieu',sens:'Maison abandonnée ou en ruine (mot d’origine guarani).',poeme:'Le rancho de Fierro est devenu une tapera quand il revient de la frontière.',francais:'masure',url:'/fr/etudiants/aller/6/'},
 {mot:'Matrero',type:'Condition sociale',sens:'Gaucho fugitif, qui vit caché pour échapper à l’autorité.',poeme:'Fierro devient matrero après sa désertion.',francais:'hors-la-loi',url:'/fr/etudiants/aller/6/'},
 {mot:'Pingo, flete',type:'Cheval',sens:'Le bon cheval, le cheval favori.',poeme:'Le cheval est compagnon, moyen de fuite et signe de statut.',url:'/fr/etudiants/aller/5/'},
 {mot:'China',type:'Appellation',sens:'La compagne, la femme de l’homme de la campagne.',poeme:'Le mot apparaît dans les tableaux de la vie domestique et dans les scènes de bal.',url:'/fr/etudiants/aller/2/'},
 {mot:'Malón',type:'Terme de frontière',sens:'Raid autochtone contre les estancias et les villages de la frontière.',poeme:'Fierro et Cruz arrivent au campement autochtone pendant la préparation d’un malón.',francais:'raid',url:'/fr/etudiants/retour/2/'},
 {mot:'Moreno',type:'Désignation historique',sens:'Terme de l’époque pour une personne à la peau foncée ; dans le poème, il désigne un chanteur afro-argentin.',poeme:'Le Moreno de la payada n’est pas l’homme tué dans la première partie, mais son frère.',url:'/fr/etudiants/retour/30/'},
 {mot:'Viejo Vizcacha',type:'Nom de personnage',sens:'Viejo signifie « vieux » ; la viscache est un rongeur de la pampa qui vit dans des terriers.',poeme:'Le surnom rappelle l’animal qui entasse toutes sortes d’objets dans son terrier ; le rapprochement est une lecture possible, non une règle.',url:'/fr/etudiants/retour/15/'},
 {mot:'Picardía',type:'Nom de personnage et mot courant',sens:'Ruse, roublardise, filouterie : selon le contexte, malice ingénieuse ou tricherie. Faux ami : aucun rapport avec la Picardie.',poeme:'Le fils de Cruz garde ce surnom même après avoir essayé de changer de vie.',francais:'roublardise',url:'/fr/etudiants/retour/26/'},
 {mot:'Naides',type:'Langue gauchesque',sens:'Forme populaire de « nadie », personne.',poeme:'La poésie gauchesque emploie ces formes pour créer une voix rurale reconnaissable.',url:'/fr/lire-le-poeme/'},
 {mot:'Canto, estrofa, verso',type:'Structure littéraire',sens:'Le chant est une section numérotée, comme un chapitre ; la strophe est un groupe de vers ; le vers est une ligne du poème.',poeme:'Les deux parties comptent 13 et 33 chants, presque toujours en sizains d’octosyllabes.',francais:'chant, strophe, vers',url:'/fr/etudiants/'},
];
---
<Base migas={[{label:'Pour les étudiants',href:'/fr/etudiants/'},{label:'Glossaire'}]} lingue={{en:'/en/students/glossary/',it:'/it/studenti/glossario/',pt:'/pt/estudantes/glossario/'}} lang="fr-FR" pageType="Article" noindex title="Glossaire de Martín Fierro : les mots gauchesques expliqués" description="Glossaire pour les étudiants de Martín Fierro : payada, pulpería, fortín, facón, leva, pago, tapera, Vizcacha, Picardía et autres mots du poème, expliqués en français.">
<ArticleFr surtitre="Pour les étudiants · Les mots en contexte" titre="Glossaire gauchesque"
 chapo="Les mots du poème se comprennent mieux en contexte qu’en cherchant un équivalent dans le dictionnaire. Chaque entrée explique le sens, le rôle du mot dans Martín Fierro et, quand il existe, le mot français le plus proche."
 sources={[{nom:'Diccionario de americanismos (ASALE), en espagnol',url:'https://www.asale.org/damer/',langue:'es'},{nom:'Gaucho glossary, édition anglaise',url:'/en/students/glossary/',langue:'en'}]}
 noteSources="Les définitions sont des explications pour le lecteur et ne remplacent pas les vers de Hernández.">
 <dl class="fr-glossaire">{entrees.map(v=><div><dt lang="es">{v.mot}</dt><dd><p class="fr-type">{v.type}</p><p><strong>Sens :</strong> {v.sens}</p><p><strong>Dans le poème :</strong> {v.poeme}</p>{v.francais&&<p><strong>En français :</strong> {v.francais}</p>}<p><a href={v.url}>En savoir plus →</a></p></dd></div>)}</dl>
</ArticleFr>
<style>.fr-glossaire{display:grid;gap:0;margin:0}.fr-glossaire>div{display:grid;grid-template-columns:200px 1fr;gap:20px;border-top:1px solid #c8baab;padding:18px 0}.fr-glossaire dt{font:600 1.3rem Georgia,serif;font-style:italic}.fr-glossaire dd{margin:0}.fr-glossaire dd p{margin:0 0 6px}.fr-type{font:700 .7rem system-ui,sans-serif!important;letter-spacing:.1em;text-transform:uppercase;color:#8b4731}@media(max-width:600px){.fr-glossaire>div{grid-template-columns:1fr;gap:6px}}</style>
</Base>
