---
import Base from '../../../layouts/Base.astro';
const articles=[
 {url:'/fr/revue/mate/',surtitre:'Le monde du gaucho · Río de la Plata',titre:'Le maté, boisson de la pampa',texte:'De l’herbe des Guaranis aux missions jésuites, de la ronde du maté au feu de camp : l’histoire de la calebasse qui passe de main en main, et le maté amer dans les vers de Martín Fierro.',img:'/media/fotografias-v3/mate-pava-yerba.webp',alt:'Reconstitution numérique d’une bouilloire et d’un maté près du feu'},
];
---
<Base migas={[{label:'Revue'}]} lingue={{es:'/revista/',en:'/en/magazine/',it:'/it/rivista/',pt:'/pt/revista/'}} lang="fr-FR" pageType="CollectionPage" title="Revue culturelle : le monde du gaucho et de la pampa" description="La revue culturelle de l’édition française de MARTINFIERRO.ORG : le maté, les traditions de la pampa et le monde rural du poème de José Hernández.">
<div class="revue-fr">
 <header><p class="eyebrow">REVUE CULTURELLE · EN FRANÇAIS</p><h1>Le monde du gaucho, raconté aux lecteurs francophones</h1><p class="chapo">Des articles sur la culture rurale de la pampa, entre l’Argentine, l’Uruguay et le sud du Brésil, écrits pour les lecteurs francophones et toujours accompagnés de leurs sources.</p></header>
 <div class="liste">{articles.map(a=><article><a href={a.url}><img src={a.img} alt={a.alt} loading="lazy" decoding="async"/><div><p class="surtitre">{a.surtitre}</p><h2>{a.titre}</h2><p>{a.texte}</p><strong>Lire l’article →</strong></div></a></article>)}</div>
 <section class="plus"><h2>D’autres articles en préparation</h2><p>La revue française s’enrichira de textes sur la payada, la pulpería, les fortins de la frontière, le Jour de la Tradition argentin et les émigrants basques et béarnais dans la pampa. En attendant, la revue en espagnol compte déjà des dizaines d’articles, et la revue en anglais en propose aussi.</p><p><a href="/revista/" lang="es">Revue culturelle en espagnol</a> · <a href="/en/magazine/" lang="en">Cultural magazine (en anglais)</a> · <a href="/fr/conseils-de-martin-fierro/">Les conseils de Martín Fierro à ses fils</a></p></section>
</div>
<style>.revue-fr{max-width:1000px;margin:25px auto 85px;color:#302820}.revue-fr a{color:#853d2b;text-underline-offset:4px}.eyebrow{font:750 .72rem system-ui,sans-serif;letter-spacing:.13em;color:#934e35}.revue-fr h1{font:600 clamp(2.3rem,5vw,4.2rem)/1.1 Georgia,serif;letter-spacing:-.03em;margin:16px 0;text-wrap:balance}.chapo{font:1.2rem/1.65 Georgia,serif;max-width:70ch}.liste{display:grid;gap:22px;margin:36px 0}.liste article{border-top:2px solid #382d25;background:#f3ecdf}.liste a{display:grid;grid-template-columns:300px 1fr;gap:24px;text-decoration:none;color:inherit}.liste img{width:100%;height:100%;min-height:220px;object-fit:cover}.liste div{padding:20px 22px 22px 0}.surtitre{font:750 .7rem system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#8b4731;margin:0}.liste h2{font:600 clamp(1.6rem,3vw,2.2rem)/1.15 Georgia,serif;margin:8px 0 10px}.liste p:not(.surtitre),.plus p{font:1.04rem/1.7 Georgia,serif}.liste strong{font:700 .84rem system-ui,sans-serif;text-decoration:underline}.plus{background:#eee3d7;padding:22px 28px}.plus h2{font:600 1.7rem Georgia,serif;margin:0 0 10px}@media(max-width:650px){.liste a{grid-template-columns:1fr;gap:0}.liste img{height:210px;min-height:0}.liste div{padding:16px}.plus{padding:18px}}</style>
</Base>
