---
import Base from '../layouts/Base.astro';
import {idiomas} from '../data/idiomas';
const secciones=[
{titulo:'La obra',detalle:'Los 46 cantos completos, verso a verso, con notas y contexto histórico.',url:'/leer/',imagen:'/media/tema-familia-y-regreso.svg',alt:'Ilustración original de la vida gauchesca'},
{titulo:'José Hernández',detalle:'Biografía, vida, obra y su tiempo.',url:'/jose-hernandez/',imagen:'/media/tema-vida-gaucha.svg',alt:'Ilustración editorial del paisaje rural argentino, no retrato histórico'},
{titulo:'Exégesis',detalle:'Análisis, personajes, significado y lecturas críticas.',url:'/exegesis/',imagen:'/media/tema-justicia-y-autoridad.svg',alt:'Ilustración original inspirada en los temas del poema'},
{titulo:'Biblioteca crítica',detalle:'Estudios, ensayos, ediciones y referencias académicas.',url:'/biblioteca-critica/',imagen:'/media/tema-consejos-y-sabiduria.svg',alt:'Ilustración editorial de escenas del mundo gauchesco'},
{titulo:'Revista cultural',detalle:'Literatura, historia, arte y cultura gauchesca hoy.',url:'/revista/',imagen:'/media/tema-frontera.svg',alt:'Ilustración del paisaje histórico de la frontera'},
{titulo:'Archivo documental',detalle:'Documentos, ediciones históricas, fuentes y bibliografía.',url:'/archivo/',imagen:'/media/tema-amistad-y-lealtad.svg',alt:'Ilustración editorial de personajes del poema'}
];
---
<Base title="Martín Fierro — biblioteca y revista cultural internacional" description="Leé Martín Fierro completo: 46 cantos y 7.210 versos de José Hernández. Biblioteca, análisis, archivo documental y ediciones internacionales.">
<div class="international-home">
  <section class="international-hero" aria-labelledby="portada-titulo">
    <div class="international-hero-overlay">
      <p class="international-kicker">Biblioteca y revista cultural · Argentina · 1872–1879</p>
      <h1 id="portada-titulo">Martín Fierro <span>una obra, un pueblo, un horizonte</span></h1>
      <p>La obra de José Hernández, su tiempo y su legado<br /> en una biblioteca digital abierta al mundo.</p>
      <div class="international-actions">
        <a class="international-button" href="/leer/ida/1/">Leer Martín Fierro <span aria-hidden="true">→</span></a>
        <a class="international-button international-button-outline" href="/acerca/">Conocer el proyecto</a>
      </div>
      <p class="international-image-note">Ilustración digital original del proyecto · Recreación artística, no documento histórico</p>
    </div>
  </section>
  <nav class="international-languages" aria-label="Elegir idioma">
    <span class="international-languages-label">Ediciones y traducciones</span>
    {idiomas.map(i=><a href={`/${i.codigo}/`} lang={i.codigo}>{i.nombre} <span aria-hidden="true">↗</span></a>)}
  </nav>
  <section class="international-sections" aria-label="Explorar la biblioteca y la revista">
    {secciones.map(s=><a class="international-section" href={s.url}>
      <div class="international-section-image"><img src={s.imagen} loading="lazy" width="480" height="300" alt={s.alt}/></div>
      <div class="international-section-text"><h2>{s.titulo}</h2><p>{s.detalle}</p><span aria-hidden="true">→</span></div>
    </a>)}
  </section>
  <section class="international-feature" aria-label="Primeros versos">
    <div class="international-verse">
      <p class="international-eyebrow">Martín Fierro · Canto I</p>
      <blockquote>“Aquí me pongo a cantar<br /> al compás de la vigüela…”</blockquote>
      <span class="international-rule"></span>
      <p>El gaucho Martín Fierro, 1872</p>
    </div>
    <div class="international-etching" role="img" aria-label="Ilustración original de un gaucho a caballo en la pampa"></div>
    <div class="international-message">
      <h2>Una obra universal</h2>
      <p>Martín Fierro es mucho más que un poema. Es la voz de un pueblo, un testimonio de su tiempo y una obra que sigue interpelando al mundo.</p>
      <a href="/leer/">Explorar la obra <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="international-editions">
    <header><p class="international-eyebrow">Texto original · Acceso libre</p><h2>Dos partes, una historia</h2></header>
    <div><a href="/leer/ida/"><span>1872 · 13 cantos</span><strong>El gaucho Martín Fierro</strong><span>Explorar los cantos →</span></a><a href="/leer/vuelta/"><span>1879 · 33 cantos</span><strong>La vuelta de Martín Fierro</strong><span>Explorar los cantos →</span></a></div>
  </section>
  <p class="international-legal">La edición original está disponible en español. Las fichas internacionales identifican traducciones investigadas, pero no afirman la publicación de textos completos en otros idiomas. <a href="/acerca/">Fuentes y criterios editoriales</a>.</p>
</div>
</Base>
