---
import AdSlot from '../components/AdSlot.astro';
import Base from '../layouts/Base.astro';
import { idiomas } from '../data/idiomas';
import '../styles/revista-v2.css';
const simbolosIdioma:Record<string,string>={es:'🇦🇷',en:'🇬🇧',it:'🇮🇹',pt:'🇧🇷',fr:'🇫🇷',la:'LAT',pms:'PMT'};
const rutas = [
 {numero:'01',titulo:'La obra',sub:'El poema íntegro',url:'/leer/',imagen:'/media/fotografias-v3/la-ida.webp',alt:'Recreación digital de la vida gauchesca en la pampa'},
 {numero:'02',titulo:'José Hernández',sub:'El autor y su época',url:'/jose-hernandez/',imagen:'https://upload.wikimedia.org/wikipedia/commons/d/de/Jos%C3%A9_Hern%C3%A1ndez.jpg',alt:'Fotografía histórica original de José Hernández, hacia 1875'},
 {numero:'03',titulo:'Exégesis',sub:'Claves de lectura',url:'/exegesis/',imagen:'/media/fotografias-v3/exegesis.webp',alt:'Escena de lectura e investigación literaria recreada digitalmente'},
 {numero:'04',titulo:'Biblioteca crítica',sub:'Estudios y ediciones',url:'/biblioteca-critica/',imagen:'/media/fotografias-v3/biblioteca-critica.webp',alt:'Libros y estudios literarios en una recreación digital'},
 {numero:'05',titulo:'Revista cultural',sub:'Historia y literatura',url:'/revista/',imagen:'/media/fotografias-v3/revista-cultural.webp',alt:'Escena recreada de la vida rural argentina'},
 {numero:'06',titulo:'Archivo',sub:'Fuentes documentales',url:'/archivo/',imagen:'/media/fotografias-v3/archivo-documental-recreacion.webp',alt:'Recreación digital de un archivo de investigación'},
 {numero:'07',titulo:'Personajes principales',sub:'Quién es quién',url:'/personajes/',imagen:'/media/fotografias-v3/la-vuelta.webp',alt:'Recreación digital contemporánea de una escena de la vida gauchesca'}
];
---
<Base title="Portada — Biblioteca y revista cultural" description="Martín Fierro: obra completa de José Hernández, 46 cantos, 7.210 versos, historia, archivo y revista cultural argentina." adKind="category">
<div class="mf-revista">
  <div class="mf-editionline"><span>EDICIÓN CULTURAL · ARGENTINA</span><span>JOSÉ HERNÁNDEZ · 1872 / 1879</span><a href="/acerca/">ACERCA DE ESTA EDICIÓN ↗</a></div>
  <section class="mf-lead" aria-labelledby="mf-headline">
    <div class="mf-lead-art">
      <img src="/media/fotografias-v3/hero-gaucho-pampa.webp" width="1440" height="850" alt="Recreación digital fotorrealista de un gaucho a caballo en la pampa al atardecer" fetchpriority="high"/>
      <p>RECREACIÓN DIGITAL · NO ES UNA FOTOGRAFÍA HISTÓRICA</p>
    </div>
    <div class="mf-lead-copy">
      <span class="mf-kicker">LA GRAN OBRA DE LA LITERATURA GAUCHESCA</span>
      <h1 id="mf-headline">El mundo de <em>Martín Fierro</em>, más allá del poema.</h1>
      <p class="mf-deck">Una obra, un pueblo, un horizonte. Leé el texto completo, descubrí su tiempo y explorá el legado cultural de José Hernández.</p>
      <div class="mf-lead-actions"><a class="mf-primary" href="/leer/ida/1/">Empezar a leer <span aria-hidden="true">↗</span></a><a class="mf-secondary" href="/buscar/">Buscar en los versos <span aria-hidden="true">↗</span></a><a class="mf-secondary mf-advice-link" href="/consejos-martin-fierro/">Consejos a sus hijos <span aria-hidden="true">↗</span></a></div>
      <a class="mf-language-toplink" href="#idiomas" aria-label="Ir a Martín Fierro en otros idiomas, al final de esta página">Martín Fierro en otros idiomas <span aria-hidden="true">↓</span></a>
      <div class="mf-lead-metrics"><span><strong>46</strong> cantos</span><span><strong>7.210</strong> versos</span><span><strong>2</strong> partes</span></div>
    </div>
  </section>
<AdSlot id="category-02" kind="category" />
  <section class="mf-storyline" aria-labelledby="mf-story-title">
    <div class="mf-section-header"><span class="mf-section-number">01 / BIBLIOTECA</span><h2 id="mf-story-title">La obra, de principio a fin</h2><a href="/leer/">Ver índice completo ↗</a></div>
    <div class="mf-story-grid">
      <a class="mf-feature-story" href="/leer/ida/"><div class="mf-story-img"><img loading="lazy" src="/media/fotografias-v3/la-ida.webp" alt="Recreación digital de una partida del mundo gauchesco" width="900" height="550"/></div><div class="mf-story-copy"><span class="mf-kicker">PRIMERA PARTE · 1872 · 13 CANTOS</span><h3>El gaucho Martín Fierro</h3><p>El comienzo de la historia. Accedé a cada canto y a sus versos identificados.</p><span class="mf-textlink">Explorar La ida ↗</span></div></a>
      <a class="mf-side-story" href="/leer/vuelta/"><div class="mf-story-img"><img loading="lazy" src="/media/fotografias-v3/la-vuelta.webp" alt="Recreación digital del regreso de un gaucho a su hogar" width="650" height="430"/></div><div class="mf-story-copy"><span class="mf-kicker">SEGUNDA PARTE · 1879 · 33 CANTOS</span><h3>La vuelta de Martín Fierro</h3><p>El regreso, los encuentros y los consejos. La segunda parte íntegra.</p><span class="mf-textlink">Explorar La vuelta ↗</span></div></a>
      <div class="mf-story-aside">
        <div class="mf-quote"><span class="mf-kicker">DEL CANTO I</span><blockquote>«Aquí me pongo a cantar<br/>al compás de la vigüela…»</blockquote><p>Las palabras originales, con el contexto y la navegación de la edición digital.</p><a href="/leer/ida/1/">Leer el primer canto ↗</a></div>
        <a class="mf-advice-story" href="/consejos-martin-fierro/" aria-label="Leer Consejos de Martín Fierro a sus hijos, canto XXXII">
          <div class="mf-advice-photo"><img src="/media/fotografias-v3/consejos-fogon-hijos.webp" width="1280" height="853" alt="Recreación digital de Martín Fierro, sus dos hijos jóvenes y el hijo de Cruz, con barba incipiente, escuchando sus consejos junto a un fogón y un mate" loading="lazy" decoding="async"/></div>
          <div class="mf-advice-copy"><span class="mf-kicker">LA VUELTA · CANTO XXXII · 1879</span><h3>Consejos de Martín Fierro a sus hijos</h3><p>Las palabras de un padre nacidas de la experiencia.</p><span class="mf-textlink">Leer los consejos ↗</span></div>
        </a>
      </div>
    </div>
  </section>
  <section class="mf-explore" aria-labelledby="mf-explore-title"><div class="mf-section-header"><span class="mf-section-number">02 / EXPLORAR</span><h2 id="mf-explore-title">Una cultura, muchas miradas</h2><span class="mf-header-note">RECORRIDOS DOCUMENTALES</span></div><div class="mf-explore-grid">{rutas.map(r=><a href={r.url} class:list={["mf-route", {"mf-route--historical": r.numero === "02"}]}><div class="mf-route-image"><img src={r.imagen} alt={r.alt} width="480" height="300" loading="lazy"/></div><div class="mf-route-text"><span>{r.numero} / {r.sub}</span><h3>{r.titulo}</h3><b aria-hidden="true">↗</b></div></a>)}</div></section>
  <section class="mf-bottom"><div><span class="mf-kicker">PATRIMONIO DOCUMENTAL ABIERTO</span><h2>Una biblioteca para leer. Un archivo para investigar.</h2><p>La revista y la biblioteca conviven sin alterar el texto original: cada canto mantiene su lugar y cada fuente puede consultarse.</p><a href="/archivo/">Conocer el archivo ↗</a></div><div class="mf-bottom-figures"><div><strong>1872</strong><span>El gaucho Martín Fierro</span></div><div><strong>1879</strong><span>La vuelta de Martín Fierro</span></div></div></section>
  <section class="mf-languages-compact" id="idiomas" aria-labelledby="mf-languages-bottom-title">
    <div class="mf-languages-compact-heading">
      <h2 id="mf-languages-bottom-title">Martín Fierro en otros idiomas</h2>
      <p>La obra original se lee en español. Hay un facsímil inglés consultable y estudios sobre traducciones italiana y francesa; ningún texto traducido está integrado a nuestro lector.</p>
    </div>
    <nav class="mf-language-flags" aria-label="Páginas de Martín Fierro por idioma">
      {idiomas.map(i=><a href={`/${i.codigo}/`} lang={i.codigo} title={i.estado==='original'?'Obra original en español':'Ficha bibliográfica en investigación, no traducción íntegra'}>
        <span class="mf-lang-symbol" aria-hidden="true">{simbolosIdioma[i.codigo] ?? '🌐'}</span>
        <span>{i.nombre}</span>
      </a>)}
    </nav>
    <p class="mf-languages-compact-note"><a href="/traducciones/">Consultar traducciones y fuentes documentales ↗</a></p>
    <p class="mf-languages-compact-note">Las banderas son referencias visuales, no indicaciones de exclusividad nacional de cada idioma. LAT = latín; PMT = piamontés.</p>
  </section>
  <p class="mf-disclaimer">Salvo el retrato histórico de José Hernández, las imágenes fotorrealistas de esta portada son recreaciones digitales, no fotografías ni documentos históricos. Las secciones enlazan a páginas del proyecto; las traducciones internacionales no se presentan como textos íntegros publicados. Retrato de José Hernández (hacia 1875): fuente Biblioteca Virtual Miguel de Cervantes, vía Wikimedia Commons, dominio público. <a href="https://commons.wikimedia.org/wiki/File:Jos%C3%A9_Hern%C3%A1ndez.jpg" rel="noopener noreferrer">Ficha y procedencia de la fotografía.</a> <a href="/acerca/">Consultar fuentes y método editorial.</a></p>
</div>
<AdSlot id="category-03" kind="category" />
<AdSlot id="category-04" kind="category" />
</Base>