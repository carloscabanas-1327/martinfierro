---
import Base from '../../../layouts/Base.astro';
import LectorVoz from '../../../components/LectorVoz.astro';
import {estrofasDeCanto} from '../../../lib/corpus';
import {sovetyRu,sovetySlova,sovetyZametki} from '../../../data/ru-izuchenie';
const strofy=estrofasDeCanto('vuelta',32);
const vsegoStihov=strofy.reduce((n,e)=>n+e.versos.length,0);
const temy=[
 {name:'Отец, который говорит как друг',n:1144},{name:'Учиться доброму',n:1146},
 {name:'Дружба и честность',n:1150},{name:'Труд',n:1153},
 {name:'Ковать железо',n:1158},{name:'Единство братьев',n:1160},
 {name:'Против насилия',n:1167},{name:'Прощание',n:1174}
];
const canonical=new URL('/ru/sovety-martina-fierro/',Astro.site).toString();
const dannye={'@context':'https://schema.org','@type':'Article',headline:'Советы Мартина Фьерро сыновьям: стихи оригинала и комментарий на русском',inLanguage:'ru-RU',url:canonical,author:{'@type':'Organization',name:'MARTINFIERRO.ORG'},about:{'@type':'CreativeWork',name:'La vuelta de Martín Fierro, canto XXXII',author:{'@type':'Person',name:'José Hernández'},datePublished:'1879',inLanguage:'es'}};
---
<Base migas={[{label:'Советы сыновьям'}]} lingue={{es:'/consejos-martin-fierro/',en:'/en/martin-fierro-advice-to-his-sons/',pt:'/pt/conselhos-de-martin-fierro/',fr:'/fr/conseils-de-martin-fierro/',de:'/de/ratschlaege-von-martin-fierro/'}} lang="ru-RU" pageType="Article" title="Советы Мартина Фьерро сыновьям: стихи и их смысл" description="Прочитайте строфа за строфой советы Мартина Фьерро сыновьям («Возвращение», песнь XXXII): испанский оригинал, учебный перевод на русский и пояснения о дружбе, труде и единстве.">
<article class="sovety-ru">
<script type="application/ld+json" set:html={JSON.stringify(dannye).replace(/</g,'\\u003c')}/>
<header class="vvedenie"><p class="eyebrow">LA VUELTA DE MARTÍN FIERRO · ПЕСНЬ XXXII · 1879</p><h1>Советы Мартина Фьерро сыновьям: <em>вся песнь, строфа за строфой</em></h1><p class="lid">В конце жизни, полной утрат, бегства и встреч, Мартин Фьерро собирает двух своих сыновей и сына Круса и передаёт им то, чему научился. Это самые цитируемые строфы аргентинской литературы, и полный смысл они обретают, если помнить об ошибках человека, который их произносит.</p></header>
<figure class="geroj"><img src="/media/fotografias-v3/consejos-fogon-hijos.webp" width="1280" height="853" alt="Цифровая реконструкция: Мартин Фьерро даёт советы трём юношам у огня, с мате" fetchpriority="high"/><figcaption>Современная цифровая иллюстрация, а не изображение той эпохи.</figcaption></figure>
<div class="telo">
<section class="kontekst"><h2>Как читать эту страницу</h2><p>Мы приводим {strofy.length} строфу и {vsegoStihov} стихов песни XXXII в испанском оригинале Хосе Эрнандеса, не осовременивая орфографию. Под каждой строфой стоит <strong>учебный перевод в прозе</strong>, написанный нашей редакцией, чтобы раскрыть смысл. Это не литературный перевод, и он не пытается воспроизвести рифму: стихи всегда остаются стихами Эрнандеса.</p><p>Самые запутанные слова, например «naides» (никто), «güeno» (хороший) или «juego» (огонь), объясняются при каждой строфе.</p><p>Песнь можно прочитать и в <a href="/leer/vuelta/32/" lang="es">разделе с оригинальным текстом</a>.</p></section>
<nav class="soderzhanie" aria-label="Перейти к совету"><strong>Самые известные советы</strong>{temy.map(t=><a href={`#${strofy.find(e=>e.numero===t.n)?.id}`}>{t.name}</a>)}</nav>
<section class="chtenie"><h2>Как понимать эти советы?</h2><p>Эти стихи — не собрание пословиц, оторванное от истории. Говорит человек, которого забрали на границу силой, который потерял семью, обрёл верного друга и не раз убивал. Этот путь осложняет нравственный авторитет отца и делает поэму богаче.</p><p><strong>Единство</strong> отвечает на распавшуюся семью. <strong>Труд</strong> обретает смысл после принудительного набора и потери хижины. Отказ от <strong>насилия</strong> требует от читателя помнить о том, что сделал рассказчик, а не забывать об этом. Эрнандес создаёт голос, который учит и который в то же время можно ставить под вопрос.</p></section>
<h2 id="vsya-pesn">Песнь XXXII целиком</h2>
<p class="zametka">Испанский оригинал, за ним учебный перевод. Примечания стоят после отдельных строф, никогда внутри стихов.</p>
<LectorVoz ui="ru" unidad=".strofa" pistas={[{clave:'original',sel:'blockquote',voz:'es-AR'},{clave:'estudio',sel:'.perevod > p:nth-child(2)',voz:'ru-RU'}]}/>
<div class="strofy">
{strofy.map(e=><section class="strofa" id={e.id} aria-label={`Строфа ${e.numero}`}>
<p class="num">Строфа {e.numero}</p>
<div class="para">
<blockquote lang="es">{e.versos.map(v=><span class="stih">{v.texto}</span>)}</blockquote>
<div class="perevod"><p class="metka">Учебный перевод</p><p>{sovetyRu[e.numero]}</p>{sovetySlova[e.numero]&&<dl>{sovetySlova[e.numero].map(([w,s])=><><dt lang="es">{w}</dt><dd>{s}</dd></>)}</dl>}</div>
</div>
{sovetyZametki[e.numero]&&<aside class="poyasnenie"><p class="poyasnenie-zagolovok">Пояснение · {sovetyZametki[e.numero].zagolovok}</p><p>{sovetyZametki[e.numero].tekst}</p><small>Толкование редакции; не часть поэмы.</small></aside>}
</section>)}
</div>
<section class="final"><h2>Почему эти советы живы до сих пор</h2><p>Многие читатели помнят эти строфы наизусть, потому что их можно повторять в семье. Но внимательное чтение идёт дальше готовых формул: оно спрашивает, почему Фьерро после разлуки ценит солидарность, после потери собственного заработка хвалит труд и осуждает насилие, хотя насилие отметило всю его жизнь.</p><p>Русский читатель узнает здесь знакомый жанр — отцовское поучение детям, от «Поучения» Владимира Мономаха до «Домостроя», только перенесённый в пампу, к костру и мате. Чтобы открыть этот мир, прочитайте статью <a href="/ru/zhurnal/mate/">«Мате, напиток пампы»</a>.</p><h2>Источники и литература</h2><ul><li><a href="/leer/vuelta/32/" lang="es">Песнь XXXII в разделе с оригинальным текстом</a></li><li><a href="/consejos-martin-fierro/" lang="es">Комментированное испанское издание советов</a></li><li><a href="/ru/chitat-poemu/">Как русскоязычному читателю читать «Мартина Фьерро» по-испански</a></li></ul><p><strong>Целостность текста:</strong> стихи выше взяты прямо из корпуса поэмы, который использует весь сайт; ни один стих для этой страницы не переписан. Учебные переводы и примечания принадлежат редакции MARTINFIERRO.ORG.</p></section>
</div></article>
<style>.sovety-ru{max-width:1050px;margin:25px auto 85px;color:#302820}.sovety-ru a{color:#813b28;text-underline-offset:4px}.eyebrow{font:750 .72rem system-ui,sans-serif;letter-spacing:.13em;color:#974f35}.sovety-ru h1{font:600 clamp(2.3rem,5vw,4.5rem)/1.08 Georgia,serif;letter-spacing:-.035em;margin:18px 0;text-wrap:balance;hyphens:auto}.sovety-ru h1 em{font-weight:400}.lid{font:1.22rem/1.7 Georgia,serif;max-width:70ch}.geroj{margin:28px 0 38px}.geroj img{width:100%;height:auto;max-height:560px;object-fit:cover;border-radius:5px}.geroj figcaption{font:.75rem/1.5 system-ui,sans-serif;color:#74614d;margin-top:8px}.telo{max-width:860px;margin:auto}.telo h2{font:600 clamp(1.7rem,3vw,2.5rem)/1.2 Georgia,serif;margin:38px 0 17px;hyphens:auto}.telo p,.telo li{font:1.06rem/1.8 Georgia,serif;hyphens:auto}.telo li{margin:9px 0}.kontekst{background:#f6efe5;padding:10px 25px 25px}.soderzhanie{display:flex;flex-wrap:wrap;gap:10px 18px;border-block:1px solid #c5b5a2;padding:22px 0;margin:34px 0;font:.84rem system-ui,sans-serif}.soderzhanie strong{width:100%}.zametka{color:#655546}.strofa{border-top:1px solid #cfbeaa;padding:24px 0;scroll-margin-top:70px}.num{font:700 .75rem system-ui,sans-serif!important;color:#82654d;margin:0 0 12px!important;letter-spacing:.06em;text-transform:uppercase}.para{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:28px;align-items:start}.para blockquote{margin:0;padding-left:16px;border-left:3px solid #b9a38c}.stih{display:block;font:1.12rem/1.65 Georgia,serif}.perevod .metka{font:700 .7rem system-ui,sans-serif!important;letter-spacing:.1em;text-transform:uppercase;color:#8b4731;margin:0 0 6px!important}.perevod p{margin:0 0 10px;font-size:1rem!important;line-height:1.7!important}.perevod dl{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;margin:10px 0 0;font:.84rem/1.5 system-ui,sans-serif;color:#56483b}.perevod dt{font-style:italic;font-weight:600}.perevod dd{margin:0}.poyasnenie{background:#eee2d3;padding:17px 21px;margin-top:20px}.poyasnenie-zagolovok{font:700 .9rem/1.5 system-ui,sans-serif!important;color:#773f2e;margin:0!important}.poyasnenie p{font-size:.98rem}.poyasnenie small{font:.72rem system-ui,sans-serif;color:#746254}.final{background:#f0e6d9;padding:24px 28px;margin:28px 0}.final h2{font-size:1.8rem}@media(max-width:700px){.para{grid-template-columns:1fr;gap:14px}.stih{font-size:1.02rem}.final,.kontekst{padding:18px}}</style>
</Base>
