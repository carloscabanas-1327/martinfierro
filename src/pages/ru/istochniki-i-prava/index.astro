import Base from '../../../layouts/Base.astro';
const razdely:[string,string][]=[
 ['Оригинальная поэма','<em lang="es">El gaucho Martín Fierro</em> (1872) и <em lang="es">La vuelta de Martín Fierro</em> (1879) Хосе Эрнандеса находятся в общественном достоянии. Стихи этого издания взяты из того же структурированного текста, что и на всём сайте; метод описан на странице <a href="/acerca/" lang="es">Fuentes y método</a> (на испанском).'],
 ['Русский перевод','Перевод Михаила Донского (Москва, «Художественная литература», 1972) охраняется авторским правом и <strong>в этом издании не воспроизводится</strong>. Мы называем его, чтобы читатели могли найти его в библиотеках. Донской умер в 1996 году; по правилу семидесяти лет после смерти автора перевод перейдёт в общественное достояние 1 января 2067 года.'],
 ['Учебные переводы','Русские фрагменты рядом со стихами (например, в <a href="/ru/sovety-martina-fierro/">советах сыновьям</a>) — учебные переводы в прозе, написанные редакцией MARTINFIERRO.ORG. Они служат пониманию; это не литературные переводы, и они не заменяют оригинал. Их можно цитировать как «учебный перевод, MARTINFIERRO.ORG».'],
 ['Комментарии и учебные карточки','Краткие содержания, разборы, вопросы и словари — собственные редакционные тексты этого издания. В них всегда различается то, что говорит поэма, и то, что является толкованием.'],
 ['Фотографии и иллюстрации','Исторический портрет Хосе Эрнандеса указан на <a href="https://commons.wikimedia.org/wiki/File:Jos%C3%A9_Hern%C3%A1ndez.jpg">Wikimedia Commons</a>, фотограф неизвестен. Изображения гаучо, хижин и пейзажей — современные цифровые реконструкции, а не фотографии XIX века, и они всегда так и обозначены. Эти изображения создаются по указаниям издателя с помощью инструментов искусственного интеллекта и несут в углу пометку «Цифровая реконструкция». Искусственный интеллект помогает также писать сопроводительные тексты и сверять издания; издатель проверяет и одобряет каждое изменение перед публикацией. Текст поэмы взят из указанных изданий и не переписывается.'],
 ['Исправления','Вы нашли ошибку, учебный перевод, который можно улучшить, или сведения о «Мартине Фьерро» в русскоязычном мире? Напишите нам через страницу <a href="/contacto/" lang="es">Контакты</a> (на испанском; сообщения на русском приветствуются).'],
];
