---
import Base from '../../../../layouts/Base.astro';
import ArticleRu from '../../../../components/ArticleRu.astro';
// Если есть близкое русское слово, оно указывается («По-русски»).
const statyi:{slovo:string;tip:string;znachenie:string;vPoeme:string;poRusski?:string;url:string}[]=[
 {slovo:'Gaucho',tip:'Историческое и культурное понятие',znachenie:'Всадник равнин Аргентины, Уругвая и юга Бразилии.',vPoeme:'Слово указывает на труд, сноровку, общественное положение и спорную литературную идентичность. Фьерро говорит как гаучо, а не от имени всех гаучо.',url:'/ru/chitat-poemu/'},
 {slovo:'Payada',tip:'Устная поэзия и музыка',znachenie:'Импровизированная песенная поэзия Ла-Платы, часто состязание двух певцов под гитару.',vPoeme:'Морено и Фьерро состязаются в пайяде, которая бередит неразрешённую историю насилия.',poRusski:'песенное состязание',url:'/ru/studentam/vuelta/30/'},
 {slovo:'Pulpería',tip:'Сельское заведение',znachenie:'Лавка с распивочной и место встреч в деревне, где покупали припасы, пили и иногда пели.',vPoeme:'Несколько драк поэмы происходят в таких местах.',poRusski:'деревенская лавка-кабак',url:'/ru/studentam/ida/8/'},
 {slovo:'Fortín',tip:'Пограничное укрепление',znachenie:'Небольшой военный пост на границе с индейскими землями.',vPoeme:'Фьерро описывает там нищету и эксплуатацию во время своей службы.',poRusski:'пограничный форт, острожек',url:'/ru/studentam/ida/4/'},
 {slovo:'Leva',tip:'Военное и политическое понятие',znachenie:'Принудительный набор мужчин на военную службу.',vPoeme:'Объясняет, почему граница разрушает семейную жизнь Фьерро.',poRusski:'рекрутский набор',url:'/ru/studentam/ida/3/'},
 {slovo:'Partida',tip:'Вооружённая группа',znachenie:'Отряд, собранный для определённого поручения; в поэме почти всегда отряд, который кого-то преследует.',vPoeme:'Крус входит в отряд, который охотится за Фьерро, прежде чем встать на его защиту.',poRusski:'отряд, разъезд',url:'/ru/studentam/ida/9/'},
 {slovo:'Facón',tip:'Материальная культура',znachenie:'Большой нож, связанный с историческим гаучо.',vPoeme:'Поединки на ножах не следует читать как восхваление насилия.',url:'/ru/studentam/ida/7/'},
 {slovo:'Mate, cimarrón',tip:'Напиток',znachenie:'Настой из йербы мате; так же называют и сосуд, из которого его пьют. Cimarrón — горький мате без сахара.',vPoeme:'Фьерро вспоминает cimarrón, который пил у огня до рассвета.',poRusski:'мате, чай мате',url:'/ru/zhurnal/mate/'},
 {slovo:'Pago',tip:'Место',znachenie:'Родные места, край, откуда человек родом.',vPoeme:'Вернуться в свой pago и найти его в развалинах — один из самых тяжёлых ударов первой части.',poRusski:'родная сторона',url:'/ru/studentam/ida/6/'},
 {slovo:'Tapera',tip:'Место',znachenie:'Заброшенный или разрушенный дом (слово из языка гуарани).',vPoeme:'Хижина Фьерро превратилась в tapera, когда он возвращается с границы.',poRusski:'развалины, заброшенная хижина',url:'/ru/studentam/ida/6/'},
 {slovo:'Matrero',tip:'Общественное положение',znachenie:'Беглый гаучо, который прячется, чтобы скрыться от властей.',vPoeme:'После дезертирства Фьерро становится matrero.',poRusski:'беглый, изгой',url:'/ru/studentam/ida/6/'},
 {slovo:'Pingo, flete',tip:'Конь',znachenie:'Хороший конь, любимый конь.',vPoeme:'Конь — товарищ, средство бегства и знак достоинства.',url:'/ru/studentam/ida/5/'},
 {slovo:'China',tip:'Обозначение',znachenie:'Подруга, жена сельского жителя.',vPoeme:'Слово встречается в картинах домашней жизни и в сценах танцев.',url:'/ru/studentam/ida/2/'},
 {slovo:'Malón',tip:'Пограничное понятие',znachenie:'Набег индейцев на эстансии и посёлки на границе.',vPoeme:'Фьерро и Крус попадают в индейское стойбище, когда там готовится набег.',poRusski:'набег',url:'/ru/studentam/vuelta/2/'},
 {slovo:'Moreno',tip:'Историческое обозначение',znachenie:'Слово той эпохи для человека с тёмной кожей; в поэме — афроаргентинский певец.',vPoeme:'Морено из пайяды — не тот человек, которого убили в первой части, а его брат.',url:'/ru/studentam/vuelta/30/'},
 {slovo:'Viejo Vizcacha',tip:'Имя персонажа',znachenie:'Viejo значит «старый»; вискача — грызун пампы, живущий в норах.',vPoeme:'Прозвище напоминает о зверьке, который стаскивает в нору всякую всячину; это сравнение — одно из возможных прочтений, а не правило.',url:'/ru/studentam/vuelta/15/'},
 {slovo:'Picardía',tip:'Имя персонажа и обычное слово',znachenie:'Хитрость, лукавство, плутовство: смотря по обстоятельствам, находчивость или обман.',vPoeme:'Сын Круса сохраняет это прозвище и после того, как пытается изменить свою жизнь.',poRusski:'плутовство',url:'/ru/studentam/vuelta/26/'},
 {slovo:'Naides',tip:'Язык гаучо',znachenie:'Просторечная форма «nadie», никто.',vPoeme:'Поэзия гаучо использует такие формы, чтобы создать узнаваемый деревенский голос.',url:'/ru/chitat-poemu/'},
 {slovo:'Canto, estrofa, verso',tip:'Литературное членение',znachenie:'Canto — пронумерованный раздел, как глава; estrofa — группа стихов; verso — строка поэмы.',vPoeme:'В двух частях 13 и 33 песни, почти всегда в шестистишиях из восьмисложников.',poRusski:'песнь, строфа, стих',url:'/ru/studentam/'},
];
---
<Base noindex migas={[{label:'Студентам',href:'/ru/studentam/'},{label:'Словарь'}]} lingue={{en:'/en/students/glossary/',it:'/it/studenti/glossario/',pt:'/pt/estudantes/glossario/',fr:'/fr/etudiants/glossaire/',de:'/de/studierende/glossar/'}} lang="ru-RU" pageType="Article" title="Словарь к «Мартину Фьерро»: слова гаучо с объяснениями" description="Словарь для изучающих «Мартина Фьерро»: payada, pulpería, fortín, facón, leva, pago, tapera, Вискача, Пикардия и другие слова поэмы с объяснениями на русском.">
<ArticleRu nadzagolovok="Студентам · Слова в контексте" zagolovok="Словарь гаучо"
 lid="Слова поэмы лучше понимаются в контексте, чем через словарное соответствие. Каждая статья объясняет значение, роль слова в «Мартине Фьерро» и, если оно есть, ближайшее русское слово."
 istochniki={[{name:'Diccionario de americanismos (ASALE), на испанском',url:'https://www.asale.org/damer/',yazyk:'es'},{name:'Gaucho glossary, английское издание',url:'/en/students/glossary/',yazyk:'en'}]}
 primechanie="Определения — объяснения для читателя; они не заменяют стихов Эрнандеса.">
 <dl class="ru-slovar">{statyi.map(v=><div><dt lang="es">{v.slovo}</dt><dd><p class="ru-tip">{v.tip}</p><p><strong>Значение:</strong> {v.znachenie}</p><p><strong>В поэме:</strong> {v.vPoeme}</p>{v.poRusski&&<p><strong>По-русски:</strong> {v.poRusski}</p>}<p><a href={v.url}>Подробнее →</a></p></dd></div>)}</dl>
</ArticleRu>
<style>.ru-slovar{display:grid;gap:0;margin:0}.ru-slovar>div{display:grid;grid-template-columns:200px 1fr;gap:20px;border-top:1px solid #c8baab;padding:18px 0}.ru-slovar dt{font:600 1.3rem Georgia,serif;font-style:italic}.ru-slovar dd{margin:0;hyphens:auto}.ru-slovar dd p{margin:0 0 6px}.ru-tip{font:700 .7rem system-ui,sans-serif!important;letter-spacing:.1em;text-transform:uppercase;color:#8b4731}@media(max-width:600px){.ru-slovar>div{grid-template-columns:1fr;gap:6px}}</style>
</Base>
