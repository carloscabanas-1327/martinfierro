---
import Base from '../../../layouts/Base.astro';
const stati=[
 {url:'/ru/zhurnal/mate/',nadzagolovok:'Мир гаучо · Ла-Плата',zagolovok:'Мате, напиток пампы',tekst:'От травы гуарани к иезуитским миссиям, от круга мате к костру: история сосуда, который передают из рук в руки, и горький мате в стихах «Мартина Фьерро».',kartinka:'/media/fotografias-v3/mate-pava-yerba.webp',alt:'Цифровая реконструкция: чайник и мате у огня'},
];
---
<Base migas={[{label:'Журнал'}]} lingue={{es:'/revista/',en:'/en/magazine/',it:'/it/rivista/',pt:'/pt/revista/',fr:'/fr/revue/',de:'/de/magazin/'}} lang="ru-RU" pageType="CollectionPage" title="Культурный журнал: мир гаучо и пампы" description="Культурный журнал русского издания MARTINFIERRO.ORG: мате, традиции пампы и сельский мир в поэме Хосе Эрнандеса.">
<div class="zhurnal-ru">
 <header><p class="eyebrow">КУЛЬТУРНЫЙ ЖУРНАЛ · НА РУССКОМ</p><h1>Мир гаучо, рассказанный для русскоязычного читателя</h1><p class="lid">Статьи о сельской культуре пампы между Аргентиной, Уругваем и югом Бразилии, написанные для русскоязычного читателя и всегда со ссылками на источники.</p></header>
 <div class="spisok">{stati.map(a=><article><a href={a.url}><img src={a.kartinka} alt={a.alt} loading="lazy" decoding="async"/><div><p class="nadzagolovok">{a.nadzagolovok}</p><h2>{a.zagolovok}</h2><p>{a.tekst}</p><strong>Читать статью →</strong></div></a></article>)}</div>
 <section class="esche"><h2>Другие статьи готовятся</h2><p>Русский журнал пополнится текстами о пайяде, о пульперии, о пограничных фортах, об аргентинском Дне традиции и о переселенцах из Российской империи на Ла-Плате. А пока в испанском журнале уже десятки статей, и несколько есть в английском.</p><p><a href="/revista/" lang="es">Культурный журнал на испанском</a> · <a href="/en/magazine/" lang="en">Cultural magazine (на английском)</a> · <a href="/ru/sovety-martina-fierro/">Советы Мартина Фьерро сыновьям</a></p></section>
</div>
<style>.zhurnal-ru{max-width:1000px;margin:25px auto 85px;color:#302820}.zhurnal-ru a{color:#853d2b;text-underline-offset:4px}.eyebrow{font:750 .72rem system-ui,sans-serif;letter-spacing:.13em;color:#934e35}.zhurnal-ru h1{font:600 clamp(2.3rem,5vw,4.2rem)/1.1 Georgia,serif;letter-spacing:-.03em;margin:16px 0;text-wrap:balance;hyphens:auto}.lid{font:1.2rem/1.65 Georgia,serif;max-width:70ch}.spisok{display:grid;gap:22px;margin:36px 0}.spisok article{border-top:2px solid #382d25;background:#f3ecdf}.spisok a{display:grid;grid-template-columns:300px 1fr;gap:24px;text-decoration:none;color:inherit}.spisok img{width:100%;height:100%;min-height:220px;object-fit:cover}.spisok div{padding:20px 22px 22px 0}.nadzagolovok{font:750 .7rem system-ui,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#8b4731;margin:0}.spisok h2{font:600 clamp(1.6rem,3vw,2.2rem)/1.15 Georgia,serif;margin:8px 0 10px}.spisok p:not(.nadzagolovok),.esche p{font:1.04rem/1.7 Georgia,serif;hyphens:auto}.spisok strong{font:700 .84rem system-ui,sans-serif;text-decoration:underline}.esche{background:#eee3d7;padding:22px 28px}.esche h2{font:600 1.7rem Georgia,serif;margin:0 0 10px}@media(max-width:650px){.spisok a{grid-template-columns:1fr;gap:0}.spisok img{height:210px;min-height:0}.spisok div{padding:16px}.esche{padding:18px}}</style>
</Base>
