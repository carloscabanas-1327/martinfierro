---
import Base from '../../../layouts/Base.astro';
import {personajes} from '../../../data/personajes';
const kartochki:Record<string,{imya:string;rol:string;opisanie:string;chtenie:string}>={
 'martin-fierro':{imya:'Мартин Фьерро',rol:'Певец, герой и рассказчик',opisanie:'Гаучо, чья семейная жизнь рушится после принудительной службы на границе. Его песня — о несправедливости, насилии, бегстве, дружбе и встрече.',chtenie:'Фьерро — не Хосе Эрнандес, говорящий без посредников. Его жалобы весомы, но и его попытки оправдать насилие нужно проверять.'},
 'sargento-cruz':{imya:'Сержант Крус',rol:'Сержант, который выбирает дружбу',opisanie:'Он входит в отряд, который должен схватить Фьерро, переходит на его сторону и сражается рядом с ним. Солидарность двух мужчин — одна из главных связей поэмы.',chtenie:'Решение Круса ставит вопрос о верности: как поступить, если полученный приказ противоречит собственному чувству справедливости?'},
 'esposa-fierro':{imya:'Жена Фьерро',rol:'Супруга и утраченный дом',opisanie:'Центральная фигура семейной жизни, которую Фьерро теряет из-за набора. Весть о её смерти он позже узнаёт от сыновей.',chtenie:'Поэма не даёт ей ни собственного голоса, ни постоянного имени, и этот пробел заслуживает внимания.'},
 'primer-hijo':{imya:'Старший сын',rol:'Сын, узнавший тюрьму',opisanie:'Один из двух сыновей, которые во второй части находят отца. Его рассказ расширяет историю семьи: заброшенность, несправедливое обвинение, исправительная тюрьма.',chtenie:'Его опыт и его голос нельзя смешивать с опытом и голосом брата.'},
 'segundo-hijo':{imya:'Младший сын',rol:'Сын, которого воспитал Вискача',opisanie:'В его историю входят потерянное наследство и жизнь под опекой старика Вискачи, чьи циничные советы соединяют горький юмор и страдание.',chtenie:'Решающее значение имеет контраст между максимами Вискачи и последними советами Фьерро.'},
 'don-vizcacha':{imya:'Старик Вискача',rol:'Опекун и сатирический советчик',opisanie:'Бедный и хитрый старик, назначенный опекуном младшего сына Фьерро. Его гротескные причуды и корыстные максимы — одни из самых знаменитых эпизодов второй части.',chtenie:'Пословицы Вискачи нельзя автоматически принимать за мораль поэмы.'},
 'picardia':{imya:'Пикардия',rol:'Сын Круса, один из рассказчиков',opisanie:'Юноша, который рассказывает о сиротском детстве, об игре, о злоупотреблениях властью и о службе на границе, пока не узнаёт, что он сын сержанта Круса.',chtenie:'Его имя намекает на хитрость, но его история снова и снова показывает цену выживания.'},
 'la-cautiva':{imya:'Пленница',rol:'Женщина, угнанная во время набега',opisanie:'Её страдания в плену и вмешательство Фьерро описаны во второй части с его точки зрения.',chtenie:'У неё нет имени; этот эпизод требует критического чтения в том, что касается женщин и изображения индейцев той эпохи.'},
 'el-moreno':{imya:'Морено',rol:'Чернокожий певец пайяды',opisanie:'Певец африканского происхождения вызывает Фьерро на поэтическое состязание в вопросах и ответах и пробуждает память о давней смерти.',chtenie:'Это не тот человек, которого Фьерро убил в первой части, а его брат; и один литературный голос не представляет целый народ.'},
 'moreno-muerto':{imya:'Убитый на танцах',rol:'Жертва песни VII',opisanie:'Чернокожий мужчина гибнет в драке с Фьерро. Рассказ повествователя содержит расистские оскорбления, провокацию и насилие.',chtenie:'Версия рассказчика не оправдание, и эту жертву нельзя путать с певцом из пайяды.'},
 'juez-paz':{imya:'Мировой судья',rol:'Местная власть',opisanie:'Фигура местной власти в рассказе о наборе и преследованиях. Должность отсылает к реальным учреждениям, но сам персонаж вымышлен.',chtenie:'Ничто не позволяет приписать судье из поэмы определённую историческую личность.'},
};
const kartinka=(id:string)=>({'martin-fierro':'martin-fierro','sargento-cruz':'sargento-cruz','esposa-fierro':'esposa-de-fierro','primer-hijo':'hijo-mayor-de-fierro','segundo-hijo':'hijo-segundo-de-fierro','don-vizcacha':'viejo-vizcacha','picardia':'picardia','la-cautiva':'la-cautiva','el-moreno':'el-moreno','moreno-muerto':'negro-del-baile','juez-paz':'juez-de-paz'} as Record<string,string>)[id];
const karta=(r:{parte:'ida'|'vuelta';canto:number})=>`/ru/studentam/${r.parte}/${r.canto}/`;
---
<Base noindex migas={[{label:'Персонажи'}]} lingue={{es:'/personajes/',en:'/en/characters/',pt:'/pt/personagens/',fr:'/fr/personnages/',de:'/de/figuren/'}} lang="ru-RU" pageType="CollectionPage" title="Персонажи «Мартина Фьерро»: путеводитель на русском" description="Мартин Фьерро, сержант Крус, старик Вискача, Пикардия, сыновья, пленница и Морено: кто есть кто в поэме Хосе Эрнандеса и как читать этих персонажей критически.">
<article class="personazhi-ru">
<header><p class="eyebrow">ПУТЕВОДИТЕЛЬ ДЛЯ ЧТЕНИЯ · ПЕРСОНАЖИ</p><h1>Персонажи <em>«Мартина Фьерро»</em></h1><p class="lid">Беглый гаучо, верный друг, двое сыновей, которые пытаются понять свои утраты, беззастенчивый опекун и голоса, оттеснённые на обочину. Познакомьтесь с фигурами, которые придают поэме нравственную сложность.</p></header>
<nav class="perehody" aria-label="Перейти к персонажу">{personajes.map(p=><a href={`#${p.id}`}>{kartochki[p.id].imya}</a>)}</nav>
<div class="kartochki">{personajes.map(p=><section class="kartochka" id={p.id} aria-labelledby={`t-${p.id}`}><figure><img src={`/media/fotografias-v3/${kartinka(p.id)}.webp`} alt={`Цифровое редакционное толкование: ${kartochki[p.id].imya}; не исторический портрет`} loading="lazy"/><figcaption>Современная цифровая реконструкция</figcaption></figure><div><p class="eyebrow">{kartochki[p.id].rol}</p><h2 id={`t-${p.id}`}>{kartochki[p.id].imya}</h2><p>{kartochki[p.id].opisanie}</p><p><strong>Критическое чтение:</strong> {kartochki[p.id].chtenie}</p><p class="ssylki"><strong>В учебных карточках:</strong> {p.referencias.map(r=><a href={karta(r)}>{r.parte==='ida'?'Первая часть':'Вторая часть'} · песнь {r.canto}</a>)}</p></div></section>)}</div>
<section class="metod"><h2>Как пользоваться этим путеводителем</h2><p>Эти карточки объясняют роль одиннадцати персонажей и отсылают к учебным карточкам по отдельным песням, где приведены строфы оригинала. Это толкующие пересказы, а не цитаты и не переводы стихов Эрнандеса. Иллюстрации — современные реконструкции, а не исторические документы.</p></section>
</article>
<style>.personazhi-ru{max-width:1100px;margin:25px auto 80px;color:#31291f}.personazhi-ru a{color:#843e2c;text-underline-offset:4px}.eyebrow{font:750 .72rem system-ui,sans-serif;letter-spacing:.13em;color:#955138;text-transform:uppercase}.personazhi-ru h1{font:600 clamp(2.5rem,5vw,4.6rem)/1.08 Georgia,serif;letter-spacing:-.04em;margin:18px 0}.personazhi-ru h1 em{font-weight:400}.lid{font:1.2rem/1.65 Georgia,serif;max-width:75ch}.perehody{border-block:1px solid #cbb9a5;display:flex;flex-wrap:wrap;gap:10px 17px;padding:19px 0;margin:35px 0;font:.86rem system-ui,sans-serif}.kartochki{display:grid;gap:30px}.kartochka{display:grid;grid-template-columns:300px 1fr;gap:30px;border-top:2px solid #382d25;padding-top:24px;scroll-margin-top:70px}.kartochka figure{margin:0}.kartochka img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:4px}.kartochka figcaption{font:.72rem system-ui,sans-serif;color:#74614d;margin-top:6px}.kartochka h2{font:600 2rem Georgia,serif;margin:6px 0 12px;hyphens:auto}.kartochka p{font:1.04rem/1.75 Georgia,serif;hyphens:auto}.ssylki{display:flex;flex-wrap:wrap;gap:6px 14px;font:.86rem system-ui,sans-serif!important}.metod{background:#efe3d5;padding:22px 26px;margin-top:40px}.metod h2{font:600 1.7rem Georgia,serif;margin:0 0 10px}.metod p{font:1.03rem/1.7 Georgia,serif}@media(max-width:720px){.kartochka{grid-template-columns:1fr;gap:14px}.kartochka img{aspect-ratio:3/2}.metod{padding:18px}}</style>
</Base>
