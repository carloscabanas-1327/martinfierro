const textos = {
  "titulo": "«Мартин Фьерро» на русском: переводы и источники",
  "aviso": "Языковая версия готовится. Перевод не публикуется, пока не проверены его источник, полнота и права на воспроизведение.",
  "original": "Читать оригинал поэмы на испанском",
  "traducciones": "Задокументированные переводы",
  "sinTraducciones": "Для этого языка пока нет задокументированного перевода.",
  "biblioteca": "Библиотека и архив",
  "bibliotecaTexto": "Исторические источники, издания и документы общие для всех языков и доступны на испанском.",
