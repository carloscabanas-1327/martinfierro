---
import IdiomaEnPreparacion from '../../components/IdiomaEnPreparacion.astro';
const textos = {
  "titulo": "Μαρτίν Φιέρο στα ελληνικά: μεταφράσεις και πηγές",
  "aviso": "Η γλωσσική έκδοση βρίσκεται σε προετοιμασία. Καμία μετάφραση δεν δημοσιεύεται πριν ελεγχθούν η πηγή, η πληρότητα και τα δικαιώματα αναπαραγωγής της.",
  "original": "Διαβάστε το πρωτότυπο ποίημα στα ισπανικά",
  "traducciones": "Τεκμηριωμένες μεταφράσεις",
  "sinTraducciones": "Δεν υπάρχει ακόμη τεκμηριωμένη μετάφραση σε αυτή τη γλώσσα.",
  "biblioteca": "Βιβλιοθήκη και αρχείο",
  "bibliotecaTexto": "Οι ιστορικές πηγές, οι εκδόσεις και τα έγγραφα είναι κοινά για όλες τις γλώσσες και διατίθενται στα ισπανικά.",
  "derechos": "Κατάλογος μεταφράσεων και δικαιωμάτων"
};
---
<IdiomaEnPreparacion codigo="el" nombre="Ελληνικά" textos={textos} />
