---
// Ruta de navegación única para las tres ediciones. La raíz de cada edición se agrega sola.
interface Props {items:{label:string; href?:string}[]; edicion:'es'|'en'|'it'}
const {items,edicion}=Astro.props;
const raiz={es:{label:'Inicio',href:'/'},en:{label:'English edition',href:'/en/'},it:{label:'Edizione italiana',href:'/it/'}}[edicion];
const etiqueta={es:'Ruta de navegación',en:'Breadcrumb',it:'Percorso'}[edicion];
const todos=[raiz,...items];
---
<nav class="mf-migas" aria-label={etiqueta}>
 <ol>{todos.map((p,i)=><li>{p.href ? <a href={p.href}>{p.label}</a> : <span aria-current={i===todos.length-1?'page':undefined}>{p.label}</span>}</li>)}</ol>
</nav>
