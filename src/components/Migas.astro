---
// Ruta de navegación única para todas las ediciones. La raíz de cada edición se agrega sola.
interface Props {items:{label:string; href?:string}[]; edicion:'es'|'en'|'it'|'pt'|'fr'|'de'|'ru'|'zh'}
const {items,edicion}=Astro.props;
const raiz={es:{label:'Inicio',href:'/'},en:{label:'English edition',href:'/en/'},it:{label:'Edizione italiana',href:'/it/'},pt:{label:'Edição brasileira',href:'/pt/'},fr:{label:'Édition française',href:'/fr/'},de:{label:'Deutsche Ausgabe',href:'/de/'},ru:{label:'Русское издание',href:'/ru/'},zh:{label:'中文版',href:'/zh/'}}[edicion];
const etiqueta={es:'Ruta de navegación',en:'Breadcrumb',it:'Percorso',pt:'Você está em',fr:'Fil d’Ariane',de:'Sie sind hier',ru:'Вы здесь',zh:'当前位置'}[edicion];
const todos=[raiz,...items];
---
<nav class="mf-migas" aria-label={etiqueta}>
 <ol>{todos.map((p,i)=><li>{p.href ? <a href={p.href}>{p.label}</a> : <span aria-current={i===todos.length-1?'page':undefined}>{p.label}</span>}</li>)}</ol>
</nav>
