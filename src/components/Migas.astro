---
import {raizMigas} from '../data/migas-raiz';
// Ruta de navegación única para todas las ediciones. La raíz de cada edición se agrega sola.
interface Props {items:{label:string; href?:string}[]; edicion:'es'|'en'|'it'|'pt'|'fr'|'de'|'ru'|'zh'|'ja'}
const {items,edicion}=Astro.props;
const raiz=raizMigas[edicion];
const etiqueta={es:'Ruta de navegación',en:'Breadcrumb',it:'Percorso',pt:'Você está em',fr:'Fil d’Ariane',de:'Sie sind hier',ru:'Вы здесь',zh:'当前位置',ja:'現在の位置'}[edicion];
const todos=[raiz,...items];
---
<nav class="mf-migas" aria-label={etiqueta}>
 <div data-nosnippet><ol>{todos.map((p,i)=><li>{p.href ? <a href={p.href}>{p.label}</a> : <span aria-current={i===todos.length-1?'page':undefined}>{p.label}</span>}</li>)}</ol></div>
</nav>
