---
// Bloque destacado de los Consejos de Martín Fierro a sus hijos (canto XXXII de La vuelta)
// para las portadas de las ediciones inglesa e italiana. Modelo: tarjeta de la portada española.
interface Props {
  id: string;
  kicker: string;
  titulo: string;
  texto: string;
  llamado: string;
  href: string;
  alt: string;
  lang?: string;
}
const {id, kicker, titulo, texto, llamado, href, alt, lang} = Astro.props;
---
<section class="mf-consejos" aria-labelledby={id} lang={lang}>
  <a class="mf-consejos-foto" href={href} tabindex="-1" aria-hidden="true"><img src="/media/fotografias-v3/consejos-fogon-hijos.webp" width="1280" height="853" alt={alt} loading="lazy" decoding="async"/></a>
  <div class="mf-consejos-copia">
    <p class="mf-consejos-kicker">{kicker}</p>
    <h2 id={id}><a href={href}>{titulo}</a></h2>
    <p>{texto}</p>
    <a class="mf-consejos-boton" href={href}>{llamado} <span aria-hidden="true">↗</span></a>
  </div>
</section>
<style>
.mf-consejos{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);margin:30px 0;background:#f0e6d7;border-top:3px solid #aa533c;border-bottom:1px solid #d3bfab;color:#211c18}
.mf-consejos-foto{display:block;overflow:hidden;background:#dbbea0;min-height:300px}
.mf-consejos-foto img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .23s ease}
.mf-consejos:hover .mf-consejos-foto img{transform:scale(1.025)}
.mf-consejos-copia{padding:clamp(24px,3.5vw,48px);display:flex;flex-direction:column;justify-content:center;min-width:0}
.mf-consejos-kicker{color:#8b4731;letter-spacing:.13em;font:750 .7rem/1.5 system-ui,sans-serif;margin:0 0 14px}
.mf-consejos h2{font:600 clamp(1.8rem,3vw,2.7rem)/1.13 Georgia,serif;letter-spacing:-.025em;margin:0 0 16px;text-wrap:balance}
.mf-consejos h2 a{color:inherit;text-decoration:none}
.mf-consejos h2 a:hover{text-decoration:underline;text-underline-offset:5px}
.mf-consejos-copia>p:not(.mf-consejos-kicker){font:1.05rem/1.7 Georgia,serif;margin:0 0 22px;max-width:52ch}
.mf-consejos-boton{align-self:flex-start;display:inline-flex;align-items:center;gap:6px;padding:14px 17px;background:#392d23;color:#fff!important;font:700 .84rem system-ui,sans-serif;text-decoration:none}
.mf-consejos-boton:hover{background:#873e2c}
@media(max-width:760px){.mf-consejos{grid-template-columns:1fr}.mf-consejos-foto{min-height:0;aspect-ratio:3/2}}
</style>
