---
/**
 * Portada reservada (noindex) para un idioma sin traducción verificada en el sitio.
 * Reúne en un solo lugar portada, traducciones conocidas, biblioteca y archivo,
 * tomando las fichas del catálogo compartido: no duplica documentos por idioma.
 */
import Base from '../layouts/Base.astro';
import { traduccionesDe } from '../data/traducciones-catalogo';
import { idiomas } from '../data/idiomas';
interface Textos { titulo: string; aviso: string; original: string; traducciones: string; sinTraducciones: string; biblioteca: string; bibliotecaTexto: string; derechos: string; }
interface Props { codigo: string; nombre: string; dir?: 'ltr' | 'rtl'; textos: Textos; }
const { codigo, nombre, dir = 'ltr', textos } = Astro.props;
const fichas = traduccionesDe(codigo);
---
<Base lang={codigo} title={`Martín Fierro · ${nombre} · MARTINFIERRO.ORG`} description={textos.aviso} noindex={true} pageType="CollectionPage">
  <div class="breadcrumbs" dir="ltr"><a href="/">Martín Fierro</a><span>{nombre}</span></div>
  <div dir={dir} lang={codigo}>
    <section class="section-intro">
      <p class="eyebrow">MARTINFIERRO.ORG · {nombre}</p>
      <h1>{textos.titulo}</h1>
      <p class="lead">{textos.aviso}</p>
    </section>
    <nav class="language-picker" aria-label="Idiomas · Languages" dir="ltr">
      {idiomas.map((i) => <a href={`/${i.codigo}/`} lang={i.codigo}>{i.nombre}</a>)}
    </nav>
    <section class="editorial-paper" aria-labelledby={`trad-${codigo}`}>
      <h2 id={`trad-${codigo}`}>{textos.traducciones}</h2>
      {fichas.length === 0 && <p>{textos.sinTraducciones}</p>}
      {fichas.length > 0 && (
        <ul lang="es" dir="ltr">
          {fichas.map((f) => (
            <li>
              <strong>{f.traductor}</strong> · {f.anio}. <em>{f.titulo}</em>. {f.notaDerechos}
              {f.fuentes.map((s) => <> <a href={s.url} rel="noopener noreferrer" target="_blank">{s.texto} ↗</a></>)}
            </li>
          ))}
        </ul>
      )}
      <p><a href="/traducciones/">{textos.derechos} →</a></p>
    </section>
    <section class="editorial-paper" aria-labelledby={`bib-${codigo}`}>
      <h2 id={`bib-${codigo}`}>{textos.biblioteca}</h2>
      <p>{textos.bibliotecaTexto}</p>
      <p dir="ltr"><a href="/archivo/">/archivo/</a> · <a href="/biblioteca/">/biblioteca/</a> · <a href="/fuentes-y-derechos/">/fuentes-y-derechos/</a></p>
    </section>
    <div class="editorial-directory" dir="ltr">
      <a class="directory-feature" href="/leer/ida/"><span class="directory-mark">1872 · ORIGINAL</span><h2 lang="es">El gaucho Martín Fierro</h2><span class="text-link">{textos.original} →</span></a>
      <a class="directory-feature" href="/leer/vuelta/"><span class="directory-mark">1879 · ORIGINAL</span><h2 lang="es">La vuelta de Martín Fierro</h2><span class="text-link">{textos.original} →</span></a>
    </div>
  </div>
</Base>
