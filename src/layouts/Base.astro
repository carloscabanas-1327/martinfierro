---
interface Props {title:string; description?:string; lang?:string; pageType?:string; noindex?:boolean}
const {title,description='Leé Martín Fierro completo: las dos partes, sus cantos, versos y un buscador.',lang='es-AR',pageType='WebPage',noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).toString();
const jsonLd={ '@context':'https://schema.org','@type':pageType, name:title, description, url:canonical, inLanguage:lang, isPartOf:{'@type':'WebSite',name:'Martín Fierro',url:'https://martinfierro.org/'} };
import '../styles/global.css';
---
<!doctype html>
<html lang={lang}>
<head>
 <meta charset="UTF-8"/>
 <meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="description" content={description}/>
 <meta name="theme-color" content="#18362a"/>
 <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2"/>
 <link rel="shortcut icon" href="/favicon.svg?v=2"/>
 <link rel="canonical" href={canonical}/>
 {noindex && <meta name="robots" content="noindex,follow"/>}
 <meta property="og:type" content="website"/>
 <meta property="og:site_name" content="Martín Fierro"/>
 <meta property="og:title" content={`${title} | Martín Fierro`}/>
 <meta property="og:description" content={description}/>
 <meta property="og:url" content={canonical}/>
 <meta property="og:locale" content={lang.replace("-", "_")}/>
 <meta name="twitter:card" content="summary"/>
 <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>
 <title>{title} | Martín Fierro</title>
</head>
<body>
 <a class="skip" href="#contenido">Saltar al contenido</a>
 <header class="site-header">
  <div class="container header-content">
   <a class="brand" href="/" aria-label="Martín Fierro — inicio"><span class="brand-mark">MF</span><span>Martín Fierro<small>Biblioteca y revista cultural</small></span></a>
   <nav aria-label="Navegación principal">
    <a href="/leer/">Leer</a><a href="/temas/">Explorar</a><a href="/jose-hernandez/">José Hernández</a><a href="/exegesis/">Exégesis</a><a href="/revista/">Revista</a><a href="/archivo/">Archivo</a><a href="/es/" aria-label="Idiomas y ediciones internacionales">Idiomas</a>
   </nav>
  </div>
 </header>
 <main id="contenido" class="container"><slot/></main>
 <footer class="site-footer">
  <div class="container"><p><strong>Martín Fierro</strong> · José Hernández · 1872 y 1879</p>
  <p>Edición digital estructurada, basada en Project Gutenberg, con enmiendas documentadas. <a href="/acerca/">Fuentes, variantes y estado de verificación</a>.</p></div>
 </footer>
</body>
</html>
