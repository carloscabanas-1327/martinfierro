---
interface Props {title:string; description?:string; lang?:string; pageType?:string; noindex?:boolean; image?:string; modified?:string; adKind?:'article'|'category'|'transition'|'none'}
const {title,description='Leé Martín Fierro completo: las dos partes, sus cantos, versos y un buscador.',lang='es-AR',pageType='WebPage',noindex=false,image,modified,adKind='none'}=Astro.props;
const brandSuffix=title.toLocaleLowerCase('es').includes('martín fierro')?'':' | Martín Fierro';
const fullTitle=title+brandSuffix;
const imageUrl=new URL(image||'/media/fotografias-v3/hero-gaucho-pampa.webp',Astro.site).toString();
const editorial=lang.toLowerCase().startsWith('es')&&(['Article','LearningResource','NewsArticle'].includes(pageType));
const authorOrg={'@type':'Organization',name:'Edición MARTINFIERRO.ORG',url:new URL('/proyecto/',Astro.site).toString()};
const canonical=new URL(Astro.url.pathname,Astro.site).toString();
const english=lang.toLowerCase().startsWith('en');
const ruta=Astro.url.pathname.split('/').filter(Boolean);
const esCapitulo=pageType==='Chapter'&&ruta[0]==='leer'&&(ruta[1]==='ida'||ruta[1]==='vuelta')&&/^\d+$/.test(ruta[2]??'');
const esGuia=pageType==='LearningResource'&&ruta[0]==='estudiantes'&&(ruta[1]==='ida'||ruta[1]==='vuelta');
const libroDelCanto=esCapitulo||esGuia?{'@type':'Book',name:ruta[1]==='ida'?'El gaucho Martín Fierro':'La vuelta de Martín Fierro',author:{'@type':'Person',name:'José Hernández'},datePublished:ruta[1]==='ida'?'1872':'1879',inLanguage:'es'}:undefined;
const refCanto=esGuia?{'@type':'Chapter',name:`Canto ${ruta[2]?.split('-')[1]??''}`,isPartOf:libroDelCanto}:undefined;
const crumbs=[{ '@type':'ListItem',position:1,name:'Inicio',item:new URL('/',Astro.site).toString()},...ruta.map((part,i)=>({ '@type':'ListItem',position:i+2,name:part.replaceAll('-',' '),item:new URL('/'+ruta.slice(0,i+1).join('/')+'/',Astro.site).toString()}))];
const jsonLd={ '@context':'https://schema.org','@type':pageType, name:title, description, url:canonical, inLanguage:lang, isPartOf:{'@type':'WebSite',name:'Martín Fierro',url:new URL('/',Astro.site).toString()}, ...(editorial?{headline:title,author:authorOrg,publisher:authorOrg}:{}), ...(modified?{dateModified:modified}:{}), ...(editorial?{image:imageUrl}: {}), ...(pageType==='LearningResource'?{educationalLevel:'Educación secundaria',learningResourceType:'Guía de lectura', ...(refCanto?{about:refCanto}:{})}:{}), ...(esCapitulo?{position:Number(ruta[2]),isPartOf:libroDelCanto}:{}) };
const schemaGraph={'@context':'https://schema.org','@graph':[jsonLd,...(ruta.length?[{'@type':'BreadcrumbList',itemListElement:crumbs}]:[])]};
import AdSlot from '../components/AdSlot.astro';
import '../styles/global.css';
import '../styles/editorial-shell.css';
---
<!doctype html>
<html lang={lang}>
<head>
 <meta charset="UTF-8"/>
 <meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="description" content={description}/>
 <meta name="theme-color" content="#f7f2e8"/>
 <link rel="icon" type="image/x-icon" href="/favicon.ico?v=20261030-original-2"/>
 <link rel="shortcut icon" href="/favicon.ico?v=20261030-original-2"/>
 <link rel="canonical" href={canonical}/>
 <meta property="og:type" content={editorial||esCapitulo?"article":"website"}/>
 <meta property="og:site_name" content="Martín Fierro"/>
 <meta property="og:title" content={fullTitle}/>
 <meta property="og:description" content={description}/>
 <meta property="og:url" content={canonical}/>
 <meta property="og:image" content={imageUrl}/>
 <meta property="og:locale" content={lang.replace("-", "_")}/>
 <meta name="twitter:card" content="summary_large_image"/>
 <meta name="robots" content={noindex?"noindex,follow":"index,follow,max-image-preview:large"}/>
 <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)}/>
 <title>{fullTitle}</title>
</head>
<body>
 <!-- Reserva n.º 1: inmediatamente después de abrir BODY; permanece oculta. -->
 {adKind !== 'none' && <AdSlot id={`${adKind}-01-body`} kind={adKind} />}
 <a class="skip" href="#contenido">{english ? "Skip to content" : "Saltar al contenido"}</a>
 <header class="site-header">
  <div class="editorial-topline"><div class="container"><span>{english ? "ARGENTINA · LITERATURE · CULTURE" : "ARGENTINA · LITERATURA · CULTURA"}</span><span>JOSÉ HERNÁNDEZ · 1872—1879</span></div></div>
  <div class="container editorial-masthead">
   <a class="brand" href={english ? "/en/" : "/"} aria-label={english ? "Martín Fierro — English edition" : "Martín Fierro — inicio"}><span>Martín Fierro<small>{english ? "Documentary library & cultural magazine" : "Biblioteca documental & revista cultural"}</small></span></a>
   <a class="editorial-read" href={english ? "/en/students/" : "/leer/ida/1/"}>{english ? "STUDY THE POEM" : "LEER LA OBRA"} <span aria-hidden="true">↗</span></a>
  </div>
  <div class="editorial-nav-wrap">
   <div class="container">
    <nav class="editorial-nav" aria-label={english ? "Main navigation" : "Navegación principal"}>
     {english ? <><a href="/en/">English home</a><a href="/en/reader/">Read the original poem</a><a href="/en/jose-hernandez/">José Hernández</a><a href="/en/what-is-a-gaucho/">Gaucho culture</a><a href="/en/characters/">Characters</a><a href="/en/students/">For students</a><a href="/en/reader/">Original reader guide</a><a href="/en/verse-search/">Verse search</a><a href="/en/exegesis/">Literary exegesis</a><a href="/en/themes/">Reading themes</a><a href="/en/library/">Popular library</a><a href="/en/magazine/">Cultural magazine</a><a href="/en/archive/">Historical archive</a><a href="/en/site-index/">Site index</a><a href="/en/search/">Search</a><a href="/en/martin-fierro-english-translation/">Translations</a><a href="/">Español</a></> : <><a href="/leer/">Leer la obra</a><a href="/revista/">Revista</a><a href="/estudiantes/">Para estudiantes</a><a href="/jose-hernandez/">José Hernández</a><a href="/biblioteca/">Biblioteca</a><a href="/indice-general/">Índice general</a><a href="/buscar-documentos/">Buscar documentos</a></>}
    </nav>
   </div>
  </div>
  {!english && <div class="mf-es-shortcuts"><details class="mf-es-shortcuts-disclosure"><summary>Lectura y herramientas <span aria-hidden="true">▾</span></summary><nav aria-label="Recorridos y búsqueda del poema"><a href="/leer/ida/">La ida</a><a href="/leer/vuelta/">La vuelta</a><a href="/buscar/">Buscar versos</a><a href="/temas/">Temas</a><a href="/personajes/">Personajes</a><a href="/exegesis/">Análisis</a><a href="/archivo/">Archivo</a><a href="/en/" lang="en">English</a></nav></details></div>}
 </header>
 <main id="contenido" class="container">
 {['Article','NewsArticle','Chapter','LearningResource'].includes(pageType) && <div class="mf-share-wrap">
  <details class="mf-share">
   <summary aria-label={english?'Share this page':'Compartir esta página'} title={english?'Share':'Compartir'}><svg viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.7 10.7 6.6-4.2M8.7 13.3l6.6 4.2"/></svg></summary>
   <nav class="mf-share-menu" aria-label={english?'Sharing options':'Opciones para compartir'}>
    <button type="button" class="mf-share-copy" data-share-copy={canonical}>{english?'Copy link':'Copiar enlace'}</button>
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`} target="_blank" rel="noopener noreferrer">Facebook</a>
    <a href={`https://wa.me/?text=${encodeURIComponent(fullTitle+' '+canonical)}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    <a href={`mailto:?subject=${encodeURIComponent(fullTitle)}&body=${encodeURIComponent(canonical)}`}>Email</a>
    <a href={`https://pinterest.com/pin/create/button/?url=${encodeURIComponent(canonical)}&media=${encodeURIComponent(imageUrl)}&description=${encodeURIComponent(fullTitle)}`} target="_blank" rel="noopener noreferrer">Pinterest</a>
    <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonical)}&text=${encodeURIComponent(fullTitle)}`} target="_blank" rel="noopener noreferrer">X</a>
   </nav>
  </details>
 </div>}
 <slot/></main>
 <style is:global>
 .mf-share-wrap{display:flex;justify-content:flex-end;margin:.7rem 0 0;position:relative;z-index:5}.mf-share{position:relative}.mf-share>summary{list-style:none;cursor:pointer;border:1px solid #c5d1c8;border-radius:50%;width:43px;height:43px;display:grid;place-items:center;color:#244b39;background:#fff}.mf-share>summary::-webkit-details-marker{display:none}.mf-share>summary:focus-visible,.mf-share-menu a:focus-visible,.mf-share-menu button:focus-visible{outline:3px solid #386c54;outline-offset:2px}.mf-share-menu{position:absolute;right:0;top:calc(100% + 7px);width:215px;background:#fff;border:1px solid #ddd;border-radius:10px;box-shadow:0 8px 26px #0002;padding:8px;display:grid;gap:2px}.mf-share-menu a,.mf-share-menu button{font:inherit;color:#17251e;background:transparent;border:0;text-align:left;text-decoration:none;padding:10px 12px;border-radius:6px;cursor:pointer}.mf-share-menu a:hover,.mf-share-menu button:hover{background:#f0f5f0}
 </style>
 <script>
 document.addEventListener('click',async e=>{
  const target=e.target;
  if(!(target instanceof Element))return;
  const copy=target.closest('[data-share-copy]');
  if(copy instanceof HTMLButtonElement){
   const url=copy.dataset.shareCopy||location.href;
   try{await navigator.clipboard.writeText(url);const old=copy.textContent;copy.textContent=document.documentElement.lang.startsWith('en')?'Copied!':'¡Enlace copiado!';setTimeout(()=>{copy.textContent=old},1600)}catch{window.prompt('Copiar enlace',url)}
  }
  document.querySelectorAll('.mf-share[open]').forEach(d=>{if(!d.contains(target))d.removeAttribute('open')});
 });
 document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('.mf-share[open]').forEach(d=>d.removeAttribute('open'))});
 </script>
 {english ?  <footer class="site-footer editorial-footer" aria-label="Site information and footer">
  <div class="container editorial-footer-grid">
   <div class="editorial-footer-identity">
    <a href="/en/" class="editorial-footer-brand">Martín Fierro</a>
    <p>Documentary library · Argentine literature, history, and culture.</p>
    <p>José Hernández · <em>El gaucho Martín Fierro</em> (1872) · <em>La vuelta de Martín Fierro</em> (1879).</p>
   </div>
   <nav class="editorial-footer-links" aria-label="Explore">
    <strong>Explore</strong>
    <a href="/en/">English home</a>
    <a href={english ? "/en/reader/" : "/leer/"}>{english ? "Original poem: English guide" : "Original poem (Spanish)"}</a>
    <a href="/en/what-is-a-gaucho/">Who were the gauchos?</a>
    <a href="/en/archive/">Historical archive</a>
    <a href="/en/magazine/">Cultural magazine</a>
    <a href="/en/site-index/">English site index</a>
    <a href="/en/search/">Search English articles</a>
    <a href="/en/martin-fierro-english-translation/">English translation guide</a>
   </nav>
   <nav class="editorial-footer-links" aria-label="About this project">
    <strong>About this project</strong>
    <a href="/en/about/">About the project</a>
    <a href="/en/contact/">Contact</a>
    <a href="/en/editorial-method/">Editorial sources and methods</a>
    <a href="/en/sources-and-rights/">Sources and rights</a>
   </nav>
   <nav class="editorial-footer-links" aria-label="Legal information">
    <strong>Legal information</strong>
    <a href="/en/privacy/">Privacy policy</a>
    <a href="/en/terms/">Terms of use</a>
    <a href="/en/advertising-and-affiliates/">Advertising and affiliates</a>
    <a href="/en/site-index/">English site index</a>
   </nav>
  </div>
  <div class="container editorial-footer-credits">
   <p>© {new Date().getFullYear()} MARTINFIERRO.ORG · Independent digital edition · With thanks to Professor Robertino Ferro.</p>
   <p>Original text by José Hernández, in the public domain · <a href="/en/sources-and-rights/">Credits and provenance</a></p>
  </div>
 </footer> :  <footer class="site-footer editorial-footer" aria-label="Pie de página institucional">
  <div class="container editorial-footer-grid">
   <div class="editorial-footer-identity">
    <a href="/" class="editorial-footer-brand">Martín Fierro</a>
    <p>Biblioteca documental · Revista literaria, histórica y cultural argentina.</p>
    <p>José Hernández · <em>El gaucho Martín Fierro</em>, 1872 · <em>La vuelta de Martín Fierro</em>, 1879.</p>
   </div>
   <nav class="editorial-footer-links" aria-label="Explorar">
    <strong>Explorar</strong>
    <a href="/">Inicio</a>
    <a href="/leer/">La obra</a>
    <a href="/revista/">Revista</a>
    <a href="/archivo/">Archivo</a>
    <a href="/indice-general/"><strong>Índice general del sitio</strong></a>
    <a href="/traducciones/">Traducciones y otros idiomas</a>
   </nav>
   <nav class="editorial-footer-links" aria-label="Institucional">
    <strong>Institucional</strong>
    <a href="/proyecto/">Acerca del proyecto</a>
    <a href="/contacto/">Contacto</a>
    <a href="/acerca/">Fuentes y método</a>
    <a href="/fuentes-y-derechos/">Derechos de autor</a>
   </nav>
   <nav class="editorial-footer-links" aria-label="Información legal">
    <strong>Información legal</strong>
    <a href="/privacidad/">Política de privacidad</a>
    <a href="/terminos/">Términos de uso</a>
    <a href="/publicidad-y-afiliados/">Publicidad y afiliados</a>
    <a href="/indice-general/">Índice completo de categorías y artículos</a>
   </nav>
  </div>
  <div class="container editorial-footer-credits">
   <p>© {new Date().getFullYear()} MARTINFIERRO.ORG · Edición digital independiente · Gracias al profesor Robertino Ferro.</p>
   <p>Texto original de José Hernández, de dominio público · <a href="/fuentes-y-derechos/">Créditos y procedencia</a></p>
  </div>
 </footer>}
</body>
</html>
