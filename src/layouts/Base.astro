---
import {equivalenti,hreflang,type Grupo} from '../data/equivalencias';
interface Props {title:string; description?:string; lang?:string; pageType?:string; noindex?:boolean; adKind?:'article'|'category'|'transition'|'none'; lingue?:Grupo; migas?:{label:string; href?:string}[]}
const {title,description='Leé Martín Fierro completo: las dos partes, sus cantos, versos y un buscador.',lang='es-AR',pageType='WebPage',noindex=false,adKind='none',lingue,migas}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).toString();
const robotsBlocked=noindex;
const english=lang.toLowerCase().startsWith('en');
const italian=lang.toLowerCase().startsWith('it');
const portuguese=lang.toLowerCase().startsWith('pt');
// hreflang recíproco: solo para páginas indexables registradas en src/data/equivalencias.ts.
const grupo=robotsBlocked?undefined:equivalenti(Astro.url.pathname);
const alternates=grupo?(Object.entries(grupo) as [keyof typeof hreflang,string][]).map(([l,href])=>({hreflang:hreflang[l],href:new URL(href,Astro.site).toString()})):[];
const xDefault=grupo?.es??grupo?.en;
const nomiLingua={es:'Español',en:'English',it:'Italiano',pt:'Português'} as const;
type Lingua=keyof typeof nomiLingua;
const linguaCorrente:Lingua=english?'en':italian?'it':portuguese?'pt':'es';
// La edición brasileña (/pt/) está en construcción y en noindex: solo aparece en el
// selector dentro de sus propias páginas. Al lanzarla, poner PT_PUBLICADA en true.
const PT_PUBLICADA=false;
const lingueSelettore:Lingua[]=['es','en','it',...(PT_PUBLICADA||portuguese?['pt' as const]:[])];
// Selector visible de idioma: los mismos idiomas en todas las ediciones.
// Usa la página equivalente si está registrada; si no, la portada de cada edición.
// Las fichas en otras lenguas (/de/, /fr/…) no marcan ningún idioma como actual.
const edicionPropia=english||italian||portuguese||lang.toLowerCase().startsWith('es');
const selettore:Partial<Record<Lingua,string>>={es:'/',en:'/en/',it:'/it/',pt:'/pt/',...(edicionPropia?{[linguaCorrente]:Astro.url.pathname}:{}),...(grupo??{}),...(lingue??{})};
// Textos fijos de la cabecera, uno por edición.
const testata={
 es:{salto:'Saltar al contenido',franja:'ARGENTINA · LITERATURA · CULTURA',idioma:'Idioma',inicio:'/',marca:'Martín Fierro — inicio',lema:'Biblioteca documental & revista cultural',leerHref:'/leer/ida/1/',leer:'LEER LA OBRA',nav:'Navegación principal'},
 en:{salto:'Skip to content',franja:'ARGENTINA · LITERATURE · CULTURE',idioma:'Language',inicio:'/en/',marca:'Martín Fierro — English edition',lema:'Documentary library & cultural magazine',leerHref:'/en/students/',leer:'STUDY THE POEM',nav:'Main navigation'},
 it:{salto:'Vai al contenuto',franja:'ARGENTINA · LETTERATURA · CULTURA',idioma:'Lingua',inicio:'/it/',marca:'Martín Fierro — edizione italiana',lema:'Biblioteca documentaria & rivista culturale',leerHref:'/it/lettore/andata/1/',leer:'LEGGI IL CANTO I',nav:'Navigazione principale'},
 pt:{salto:'Pular para o conteúdo',franja:'ARGENTINA · LITERATURA · CULTURA',idioma:'Idioma',inicio:'/pt/',marca:'Martín Fierro — edição brasileira',lema:'Biblioteca documental & revista cultural',leerHref:'/pt/ler-o-poema/',leer:'LER O POEMA',nav:'Navegação principal'},
}[linguaCorrente];
// Menú principal: mismos destinos en todas las ediciones (la brasileña crece por etapas).
const menu={
 es:[['/', 'Inicio'],['/leer/','Leer la obra'],['/revista/','Revista'],['/estudiantes/','Para estudiantes'],['/jose-hernandez/','José Hernández'],['/biblioteca/','Biblioteca'],['/indice-general/','Índice general'],['/buscar-documentos/','Buscar']],
 en:[['/en/','Home'],['/en/reader/','Read the poem'],['/en/magazine/','Magazine'],['/en/students/','For students'],['/en/jose-hernandez/','José Hernández'],['/en/library/','Library'],['/en/site-index/','Site index'],['/en/search/','Search']],
 it:[['/it/','Home'],['/it/lettore/','Leggi il poema'],['/it/rivista/','Rivista'],['/it/studenti/','Per gli studenti'],['/it/jose-hernandez/','José Hernández'],['/it/biblioteca/','Biblioteca'],['/it/indice/','Indice del sito'],['/it/cerca/','Cerca']],
 pt:[['/pt/','Início'],['/pt/ler-o-poema/','Ler o poema'],['/pt/conselhos-de-martin-fierro/','Os conselhos'],['/pt/revista/','Revista']],
}[linguaCorrente];
const jsonLd={ '@context':'https://schema.org','@type':pageType, name:title, description, url:canonical, inLanguage:lang, isPartOf:{'@type':'WebSite',name:'Martín Fierro',url:new URL('/',Astro.site).toString()} };
import AdSlot from '../components/AdSlot.astro';
import Migas from '../components/Migas.astro';
import '../styles/global.css';
import '../styles/editorial-shell.css';
---
<!doctype html>
<html lang={lang}>
<head>
 <meta charset="UTF-8"/>
 <meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="description" content={description}/>
 <meta name="theme-color" content="#f7f2e8"/>
 <link rel="icon" type="image/x-icon" href="/favicon.ico?v=20261030-original-2"/>
 <link rel="shortcut icon" href="/favicon.ico?v=20261030-original-2"/>
 <link rel="canonical" href={canonical}/>
 {alternates.map(a=><link rel="alternate" hreflang={a.hreflang} href={a.href}/>)}
 {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault,Astro.site).toString()}/>}
 {robotsBlocked && <meta name="robots" content="noindex,nofollow"/>}
 <meta property="og:type" content="website"/>
 <meta property="og:site_name" content="Martín Fierro"/>
 <meta property="og:title" content={`${title} | Martín Fierro`}/>
 <meta property="og:description" content={description}/>
 <meta property="og:url" content={canonical}/>
 <meta property="og:locale" content={lang.replace("-", "_")}/>
 <meta property="og:image" content="https://martinfierro.org/media/compartir/gaucho-a-caballo-1200x630.jpg"/>
 <meta property="og:image:width" content="1200"/>
 <meta property="og:image:height" content="630"/>
 <meta property="og:image:alt" content="Recreación digital de un gaucho a caballo en la pampa al atardecer"/>
 <meta name="twitter:card" content="summary_large_image"/>
 <meta name="twitter:image" content="https://martinfierro.org/media/compartir/gaucho-a-caballo-1200x630.jpg"/>
 <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>
 <title>{title} | Martín Fierro</title>
</head>
<body>
 <!-- Reserva n.º 1: inmediatamente después de abrir BODY; permanece oculta. -->
 {adKind !== 'none' && <AdSlot id={`${adKind}-01-body`} kind={adKind} />}
 <a class="skip" href="#contenido">{testata.salto}</a>
 <header class="site-header">
  <div class="editorial-topline"><div class="container"><span>{testata.franja}</span><span>JOSÉ HERNÁNDEZ · 1872—1879</span><nav class="mf-lingue" aria-label={testata.idioma}>{lingueSelettore.filter(l=>selettore[l]).map(l=>edicionPropia && l===linguaCorrente ? <b aria-current="page" lang={l}>{nomiLingua[l]}</b> : <a href={selettore[l]} hreflang={hreflang[l]} lang={l}>{nomiLingua[l]}</a>)}</nav></div></div>
  <div class="container editorial-masthead">
   <a class="brand" href={testata.inicio} aria-label={testata.marca}><span>Martín Fierro<small>{testata.lema}</small></span></a>
   <a class="editorial-read" href={testata.leerHref}>{testata.leer} <span aria-hidden="true">↗</span></a>
  </div>
  <div class="editorial-nav-wrap">
   <div class="container">
    <nav class="editorial-nav" aria-label={testata.nav}>
     {menu.map(([href,label])=><a href={href}>{label}</a>)}
    </nav>
   </div>
  </div>
  
 </header>
 <main id="contenido" class="container">{migas && <Migas items={migas} edicion={linguaCorrente}/>}<slot/></main>
 {portuguese ? <footer class="site-footer editorial-footer" aria-label="Informações do site">
  <div class="container editorial-footer-grid">
   <div class="editorial-footer-identity">
    <a href="/pt/" class="editorial-footer-brand">Martín Fierro</a>
    <p>Biblioteca documental · Literatura, história e cultura do Prata e do Pampa.</p>
    <p>José Hernández · <em>El gaucho Martín Fierro</em> (1872) · <em>La vuelta de Martín Fierro</em> (1879). Versos sempre no original espanhol.</p>
   </div>
   <nav class="editorial-footer-links" aria-label="Explorar">
    <strong>Explorar</strong>
    <a href="/pt/">Edição brasileira</a>
    <a href="/pt/ler-o-poema/">Como ler o poema</a>
    <a href="/pt/conselhos-de-martin-fierro/">Os conselhos aos filhos</a>
    <a href="/pt/revista/">Revista cultural</a>
    <a href="/leer/" lang="es">Texto original em espanhol</a>
   </nav>
   <nav class="editorial-footer-links" aria-label="O projeto">
    <strong>O projeto</strong>
    <a href="/acerca/" lang="es">Fontes e método (em espanhol)</a>
    <a href="/fuentes-y-derechos/" lang="es">Direitos e créditos (em espanhol)</a>
    <a href="/contacto/" lang="es">Contato (em espanhol)</a>
   </nav>
   <nav class="editorial-footer-links" aria-label="Outros idiomas">
    <strong>Outros idiomas</strong>
    <a href="/" lang="es">Español</a>
    <a href="/en/" lang="en">English</a>
    <a href="/it/" lang="it">Italiano</a>
    <a href="/traducciones/" lang="es">Traduções do poema (em espanhol)</a>
   </nav>
  </div>
  <div class="container editorial-footer-credits">
   <p>© {new Date().getFullYear()} MARTINFIERRO.ORG · Edição digital independente · Agradecimentos ao professor Robertino Ferro.</p>
   <p>Texto original de José Hernández, em domínio público · Comentários e traduções de estudo em português: MARTINFIERRO.ORG</p>
  </div>
 </footer> : italian ? <footer class="site-footer editorial-footer" aria-label="Informazioni sul sito">
  <div class="container editorial-footer-grid">
   <div class="editorial-footer-identity">
    <a href="/it/" class="editorial-footer-brand">Martín Fierro</a>
    <p>Biblioteca documentaria · Letteratura, storia e cultura argentina.</p>
    <p>José Hernández · <em>El gaucho Martín Fierro</em> (1872) · <em>La vuelta de Martín Fierro</em> (1879). Traduzione italiana di Folco Testena (1919).</p>
   </div>
   <nav class="editorial-footer-links" aria-label="Esplora">
    <strong>Esplora</strong>
    <a href="/it/">Edizione italiana</a>
    <a href="/it/lettore/">Il poema in italiano</a>
    <a href="/leer/" lang="es">Testo originale spagnolo</a>
    <a href="/it/rivista/">Rivista culturale</a>
    <a href="/it/indice/">Indice del sito</a>
    <a href="/it/cerca/">Cerca</a>
   </nav>
   <nav class="editorial-footer-links" aria-label="Il progetto">
    <strong>Il progetto</strong>
    <a href="/it/metodo-editoriale/">Metodo editoriale</a>
    <a href="/it/fonti-e-diritti/">Diritti e crediti</a>
    <a href="/it/biblioteca/traduzione-testena/">La traduzione di Testena</a>
    <a href="/contacto/" lang="es">Contatti (in spagnolo)</a>
   </nav>
   <nav class="editorial-footer-links" aria-label="Altre lingue">
    <strong>Altre lingue</strong>
    <a href="/" lang="es">Español</a>
    <a href="/en/" lang="en">English</a>
    <a href="/traducciones/" lang="es">Traduzioni del poema (in spagnolo)</a>
   </nav>
  </div>
  <div class="container editorial-footer-credits">
   <p>© {new Date().getFullYear()} MARTINFIERRO.ORG · Edizione digitale indipendente · Grazie al professor Robertino Ferro.</p>
   <p>Testo originale di José Hernández e traduzione di Folco Testena, di pubblico dominio · <a href="/it/fonti-e-diritti/">Crediti e provenienza</a></p>
  </div>
 </footer> : english ?  <footer class="site-footer editorial-footer" aria-label="Site information and footer">
  <div class="container editorial-footer-grid">
   <div class="editorial-footer-identity">
    <a href="/en/" class="editorial-footer-brand">Martín Fierro</a>
    <p>Documentary library · Argentine literature, history, and culture.</p>
    <p>José Hernández · <em>El gaucho Martín Fierro</em> (1872) · <em>La vuelta de Martín Fierro</em> (1879).</p>
   </div>
   <nav class="editorial-footer-links" aria-label="Explore">
    <strong>Explore</strong>
    <a href="/en/">English home</a>
    <a href={english ? "/en/reader/" : "/leer/"}>{english ? "Original poem: English guide" : "Original poem (Spanish)"}</a>
    <a href="/en/what-is-a-gaucho/">Who were the gauchos?</a>
    <a href="/en/archive/">Historical archive</a>
    <a href="/en/magazine/">Cultural magazine</a>
    <a href="/en/site-index/">English site index</a>
    <a href="/en/search/">Search English articles</a>
    <a href="/en/martin-fierro-english-translation/">English translation guide</a>
   </nav>
   <nav class="editorial-footer-links" aria-label="About this project">
    <strong>About this project</strong>
    <a href="/en/about/">About the project</a>
    <a href="/en/contact/">Contact</a>
    <a href="/en/editorial-method/">Editorial sources and methods</a>
    <a href="/en/sources-and-rights/">Sources and rights</a>
   </nav>
   <nav class="editorial-footer-links" aria-label="Legal information">
    <strong>Legal information</strong>
    <a href="/en/privacy/">Privacy policy</a>
    <a href="/en/terms/">Terms of use</a>
    <a href="/en/advertising-and-affiliates/">Advertising and affiliates</a>
    <a href="/en/site-index/">English site index</a>
   </nav>
  </div>
  <div class="container editorial-footer-credits">
   <p>© {new Date().getFullYear()} MARTINFIERRO.ORG · Independent digital edition · With thanks to Professor Robertino Ferro.</p>
   <p>Original text by José Hernández, in the public domain · <a href="/en/sources-and-rights/">Credits and provenance</a></p>
  </div>
 </footer> :  <footer class="site-footer editorial-footer" aria-label="Pie de página institucional">
  <div class="container editorial-footer-grid">
   <div class="editorial-footer-identity">
    <a href="/" class="editorial-footer-brand">Martín Fierro</a>
    <p>Biblioteca documental · Revista literaria, histórica y cultural argentina.</p>
    <p>José Hernández · <em>El gaucho Martín Fierro</em>, 1872 · <em>La vuelta de Martín Fierro</em>, 1879.</p>
   </div>
   <nav class="editorial-footer-links" aria-label="Explorar">
    <strong>Explorar</strong>
    <a href="/">Inicio</a>
    <a href="/leer/">La obra</a>
    <a href="/revista/">Revista</a>
    <a href="/archivo/">Archivo</a>
    <a href="/indice-general/"><strong>Índice general del sitio</strong></a>
    <a href="/traducciones/">Traducciones y otros idiomas</a>
   </nav>
   <nav class="editorial-footer-links" aria-label="Institucional">
    <strong>Institucional</strong>
    <a href="/proyecto/">Acerca del proyecto</a>
    <a href="/contacto/">Contacto</a>
    <a href="/acerca/">Fuentes y método</a>
    <a href="/fuentes-y-derechos/">Derechos de autor</a>
   </nav>
   <nav class="editorial-footer-links" aria-label="Información legal">
    <strong>Información legal</strong>
    <a href="/privacidad/">Política de privacidad</a>
    <a href="/terminos/">Términos de uso</a>
    <a href="/publicidad-y-afiliados/">Publicidad y afiliados</a>
    <a href="/indice-general/">Índice completo de categorías y artículos</a>
   </nav>
  </div>
  <div class="container editorial-footer-credits">
   <p>© {new Date().getFullYear()} MARTINFIERRO.ORG · Edición digital independiente · Gracias al profesor Robertino Ferro.</p>
   <p>Texto original de José Hernández, de dominio público · <a href="/fuentes-y-derechos/">Créditos y procedencia</a></p>
  </div>
 </footer>}
</body>
</html>
