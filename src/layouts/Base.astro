---
import {equivalenti,hreflang,type Grupo} from '../data/equivalencias';
interface Props {title:string; description?:string; lang?:string; pageType?:string; noindex?:boolean; adKind?:'article'|'category'|'transition'|'none'; lingue?:Grupo; migas?:{label:string; href?:string}[]}
const {title,description='Leé Martín Fierro completo: las dos partes, sus cantos, versos y un buscador.',lang='es-AR',pageType='WebPage',noindex=false,adKind='none',lingue,migas}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).toString();
const robotsBlocked=noindex;
const english=lang.toLowerCase().startsWith('en');
const italian=lang.toLowerCase().startsWith('it');
const portuguese=lang.toLowerCase().startsWith('pt');
const french=lang.toLowerCase().startsWith('fr');
const german=lang.toLowerCase().startsWith('de');
const russian=lang.toLowerCase().startsWith('ru');
// hreflang recíproco: solo para páginas indexables registradas en src/data/equivalencias.ts.
const grupo=robotsBlocked?undefined:equivalenti(Astro.url.pathname);
const alternates=grupo?(Object.entries(grupo) as [keyof typeof hreflang,string][]).map(([l,href])=>({hreflang:hreflang[l],href:new URL(href,Astro.site).toString()})):[];
const xDefault=grupo?.es??grupo?.en;
const nomiLingua={es:'Español',en:'English',it:'Italiano',pt:'Português',fr:'Français',de:'Deutsch',ru:'Русский'} as const;
type Lingua=keyof typeof nomiLingua;
const linguaCorrente:Lingua=english?'en':italian?'it':portuguese?'pt':french?'fr':german?'de':russian?'ru':'es';
// Edición brasileña (/pt/): abierta a buscadores desde el 2026-11-04. Con false,
// «Português» solo aparecería en el selector dentro de /pt/.
const PT_PUBLICADA=true;
// Edición francesa (/fr/): abierta a buscadores desde el 2026-11-04. Con false,
// «Français» solo aparecería en el selector dentro de /fr/.
const FR_PUBLICADA=true;
// Edición alemana (/de/): abierta a buscadores desde el 2026-11-06. Con false,
// «Deutsch» solo aparecería en el selector dentro de /de/.
const DE_PUBLICADA=true;
// Edición rusa (/ru/): abierta a buscadores desde el 2026-11-06. Con false,
// «Русский» solo aparecería en el selector dentro de /ru/.
const RU_PUBLICADA=true;
const lingueSelettore:Lingua[]=['es','en','it',...(PT_PUBLICADA||portuguese?['pt' as const]:[]),...(FR_PUBLICADA||french?['fr' as const]:[]),...(DE_PUBLICADA||german?['de' as const]:[]),...(RU_PUBLICADA||russian?['ru' as const]:[])];
// Selector visible de idioma: los mismos idiomas en todas las ediciones.
// Usa la página equivalente si está registrada; si no, la portada de cada edición.
// Las fichas en otras lenguas (/de/, /fr/…) no marcan ningún idioma como actual.
const edicionPropia=english||italian||portuguese||french||german||russian||lang.toLowerCase().startsWith('es');
const selettore:Partial<Record<Lingua,string>>={es:'/',en:'/en/',it:'/it/',pt:'/pt/',fr:'/fr/',de:'/de/',ru:'/ru/',...(edicionPropia?{[linguaCorrente]:Astro.url.pathname}:{}),...(grupo??{}),...(lingue??{})};
// Textos fijos de la cabecera, uno por edición.
const testata={
 es:{salto:'Saltar al contenido',franja:'ARGENTINA · LITERATURA · CULTURA',idioma:'Idioma',inicio:'/',marca:'Martín Fierro — inicio',lema:'Biblioteca documental & revista cultural',leerHref:'/leer/ida/1/',leer:'LEER LA OBRA',nav:'Navegación principal'},
 en:{salto:'Skip to content',franja:'ARGENTINA · LITERATURE · CULTURE',idioma:'Language',inicio:'/en/',marca:'Martín Fierro — English edition',lema:'Documentary library & cultural magazine',leerHref:'/en/students/',leer:'STUDY THE POEM',nav:'Main navigation'},
 it:{salto:'Vai al contenuto',franja:'ARGENTINA · LETTERATURA · CULTURA',idioma:'Lingua',inicio:'/it/',marca:'Martín Fierro — edizione italiana',lema:'Biblioteca documentaria & rivista culturale',leerHref:'/it/lettore/andata/1/',leer:'LEGGI IL CANTO I',nav:'Navigazione principale'},
 pt:{salto:'Pular para o conteúdo',franja:'ARGENTINA · LITERATURA · CULTURA',idioma:'Idioma',inicio:'/pt/',marca:'Martín Fierro — edição brasileira',lema:'Biblioteca documental & revista cultural',leerHref:'/pt/estudantes/',leer:'ESTUDAR O POEMA',nav:'Navegação principal'},
 de:{salto:'Zum Inhalt springen',franja:'ARGENTINIEN · LITERATUR · KULTUR',idioma:'Sprache',inicio:'/de/',marca:'Martín Fierro — deutsche Ausgabe',lema:'Dokumentarische Bibliothek & Kulturmagazin',leerHref:'/de/studierende/',leer:'STUDIENBLÄTTER',nav:'Hauptnavigation'},
 ru:{salto:'Перейти к содержанию',franja:'АРГЕНТИНА · ЛИТЕРАТУРА · КУЛЬТУРА',idioma:'Язык',inicio:'/ru/',marca:'Martín Fierro — русское издание',lema:'Документальная библиотека и культурный журнал',leerHref:'/ru/studentam/',leer:'СТУДЕНТАМ',nav:'Главное меню'},
 fr:{salto:'Aller au contenu',franja:'ARGENTINE · LITTÉRATURE · CULTURE',idioma:'Langue',inicio:'/fr/',marca:'Martín Fierro — édition française',lema:'Bibliothèque documentaire & revue culturelle',leerHref:'/fr/etudiants/',leer:'ÉTUDIER LE POÈME',nav:'Navigation principale'},
}[linguaCorrente];
// Menú principal: mismos destinos en todas las ediciones (la brasileña crece por etapas).
const menu={
 es:[['/', 'Inicio'],['/leer/','Leer la obra'],['/revista/','Revista'],['/estudiantes/','Para estudiantes'],['/jose-hernandez/','José Hernández'],['/biblioteca/','Biblioteca'],['/indice-general/','Índice general'],['/buscar-documentos/','Buscar']],
 en:[['/en/','Home'],['/en/reader/','Read the poem'],['/en/magazine/','Magazine'],['/en/students/','For students'],['/en/jose-hernandez/','José Hernández'],['/en/library/','Library'],['/en/site-index/','Site index'],['/en/search/','Search']],
 it:[['/it/','Home'],['/it/lettore/','Leggi il poema'],['/it/rivista/','Rivista'],['/it/studenti/','Per gli studenti'],['/it/jose-hernandez/','José Hernández'],['/it/biblioteca/','Biblioteca'],['/it/indice/','Indice del sito'],['/it/cerca/','Cerca']],
 pt:[['/pt/','Início'],['/pt/ler-o-poema/','Ler o poema'],['/pt/revista/','Revista'],['/pt/estudantes/','Para estudantes'],['/pt/jose-hernandez/','José Hernández'],['/pt/personagens/','Personagens'],['/pt/conselhos-de-martin-fierro/','Os conselhos']],
 de:[['/de/','Start'],['/de/das-gedicht-lesen/','Das Gedicht lesen'],['/de/magazin/','Magazin'],['/de/studierende/','Für Studierende'],['/de/jose-hernandez/','José Hernández'],['/de/figuren/','Figuren'],['/de/ratschlaege-von-martin-fierro/','Die Ratschläge']],
 ru:[['/ru/','Главная'],['/ru/chitat-poemu/','Читать поэму'],['/ru/zhurnal/','Журнал'],['/ru/studentam/','Студентам'],['/ru/jose-hernandez/','Хосе Эрнандес'],['/ru/personazhi/','Персонажи'],['/ru/sovety-martina-fierro/','Советы']],
 fr:[['/fr/','Accueil'],['/fr/lire-le-poeme/','Lire le poème'],['/fr/revue/','Revue'],['/fr/etudiants/','Pour les étudiants'],['/fr/jose-hernandez/','José Hernández'],['/fr/personnages/','Personnages'],['/fr/conseils-de-martin-fierro/','Les conseils']],
}[linguaCorrente];
const jsonLd={ '@context':'https://schema.org','@type':pageType, name:title, description, url:canonical, inLanguage:lang, isPartOf:{'@type':'WebSite',name:'Martín Fierro',url:new URL('/',Astro.site).toString()} };
import AdSlot from '../components/AdSlot.astro';
import Migas from '../components/Migas.astro';
import '../styles/global.css';
import '../styles/editorial-shell.css';
import AvisoRecreacion from '../components/AvisoRecreacion.astro';
---
<!doctype html>
<html lang={lang}>
<head>
 <meta charset="UTF-8"/>
 <meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="description" content={description}/>
 <meta name="theme-color" content="#f7f2e8"/>
 <link rel="icon" type="image/x-icon" href="/favicon.ico?v=20261030-original-2"/>
 <link rel="shortcut icon" href="/favicon.ico?v=20261030-original-2"/>
 <link rel="canonical" href={canonical}/>
 {alternates.map(a=><link rel="alternate" hreflang={a.hreflang} href={a.href}/>)}
 {xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault,Astro.site).toString()}/>}
 {robotsBlocked && <meta name="robots" content="noindex,nofollow"/>}
 <meta property="og:type" content="website"/>
 <meta property="og:site_name" content="Martín Fierro"/>
 <meta property="og:title" content={`${title} | Martín Fierro`}/>
 <meta property="og:description" content={description}/>
 <meta property="og:url" content={canonical}/>
 <meta property="og:locale" content={lang.replace("-", "_")}/>
 <meta property="og:image" content="https://martinfierro.org/media/compartir/gaucho-a-caballo-1200x630.jpg"/>
 <meta property="og:image:width" content="1200"/>
 <meta property="og:image:height" content="630"/>
 <meta property="og:image:alt" content="Recreación digital de un gaucho a caballo en la pampa al atardecer"/>
 <meta name="twitter:card" content="summary_large_image"/>
 <meta name="twitter:image" content="https://martinfierro.org/media/compartir/gaucho-a-caballo-1200x630.jpg"/>
 <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>
 <title>{title} | Martín Fierro</title>
</head>
<body>
 <!-- Reserva n.º 1: inmediatamente después de abrir BODY; permanece oculta. -->
 {adKind !== 'none' && <AdSlot id={`${adKind}-01-body`} kind={adKind} />}
 <a class="skip" href="#contenido">{testata.salto}</a>
 <header class="site-header">
  <div class="editorial-topline"><div class="container"><span>{testata.franja}</span><nav class="mf-lingue" aria-label={testata.idioma}>{lingueSelettore.filter(l=>selettore[l]).map(l=>edicionPropia && l===linguaCorrente ? <b aria-current="page" lang={l}>{nomiLingua[l]}</b> : <a href={selettore[l]} hreflang={hreflang[l]} lang={l}>{nomiLingua[l]}</a>)}</nav></div></div>
  <div class="container editorial-masthead">
   <a class="brand" href={testata.inicio} aria-label={testata.marca}><span>Martín Fierro<small>{testata.lema}</small></span></a>
   <a class="editorial-read" href={testata.leerHref}>{testata.leer} <span aria-hidden="true">↗</span></a>
  </div>
  <div class="editorial-nav-wrap">
   <div class="container">
    <nav class="editorial-nav" aria-label={testata.nav}>
     {menu.map(([href,label])=><a href={href}>{label}</a>)}
    </nav>
   </div>
  </div>
  
 </header>
 <main id="contenido" class="container">{migas && <Migas items={migas} edicion={linguaCorrente}/>}<slot/></main>
