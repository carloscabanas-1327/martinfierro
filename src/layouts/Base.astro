---
interface Props {title:string; description?:string; lang?:string; pageType?:string; noindex?:boolean; adKind?:'article'|'category'|'transition'|'none'}
const {title,description='Leé Martín Fierro completo: las dos partes, sus cantos, versos y un buscador.',lang='es-AR',pageType='WebPage',noindex=false,adKind='none'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).toString();
const jsonLd={ '@context':'https://schema.org','@type':pageType, name:title, description, url:canonical, inLanguage:lang, isPartOf:{'@type':'WebSite',name:'Martín Fierro',url:new URL('/',Astro.site).toString()} };
import AdSlot from '../components/AdSlot.astro';
import '../styles/global.css';
import '../styles/editorial-shell.css';
---
<!doctype html>
<html lang={lang}>
<head>
 <meta charset="UTF-8"/>
 <meta name="viewport" content="width=device-width, initial-scale=1"/>
 <meta name="description" content={description}/>
 <meta name="theme-color" content="#f7f2e8"/>
 <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=20261030-gaucho"/>
 <link rel="shortcut icon" type="image/svg+xml" href="/favicon.svg?v=20261030-gaucho"/>
 <link rel="canonical" href={canonical}/>
 {noindex && <meta name="robots" content="noindex,follow"/>}
 <meta property="og:type" content="website"/>
 <meta property="og:site_name" content="Martín Fierro"/>
 <meta property="og:title" content={`${title} | Martín Fierro`}/>
 <meta property="og:description" content={description}/>
 <meta property="og:url" content={canonical}/>
 <meta property="og:locale" content={lang.replace("-", "_")}/>
 <meta name="twitter:card" content="summary"/>
 <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>
 <title>{title} | Martín Fierro</title>
</head>
<body>
 <!-- Reserva n.º 1: inmediatamente después de abrir BODY; permanece oculta. -->
 {adKind !== 'none' && <AdSlot id={`${adKind}-01-body`} kind={adKind} />}
 <a class="skip" href="#contenido">Saltar al contenido</a>
 <header class="site-header">
  <div class="editorial-topline"><div class="container"><span>ARGENTINA · LITERATURA · CULTURA</span><span>JOSÉ HERNÁNDEZ · 1872—1879</span></div></div>
  <div class="container editorial-masthead">
   <a class="brand" href="/" aria-label="Martín Fierro — inicio"><span>Martín Fierro<small>Biblioteca documental & revista cultural</small></span></a>
   <a class="editorial-read" href="/leer/ida/1/">LEER LA OBRA <span aria-hidden="true">↗</span></a>
  </div>
  <div class="editorial-nav-wrap">
   <div class="container">
    <nav class="editorial-nav" aria-label="Navegación principal">
     <a href="/leer/">La obra</a><a href="/temas/">Explorar</a><a href="/jose-hernandez/">José Hernández</a><a href="/exegesis/">Exégesis</a><a href="/biblioteca-critica/">Biblioteca crítica</a><a href="/revista/">Revista</a><a href="/archivo/">Archivo</a><a href="/buscar/">Buscar <span aria-hidden="true">⌕</span></a>
    </nav>
   </div>
  </div>
 </header>
 <main id="contenido" class="container"><slot/></main>
 <footer class="site-footer editorial-footer">
  <div class="container editorial-footer-grid">
   <div><a href="/" class="editorial-footer-brand">Martín Fierro</a><p>Biblioteca documental y revista cultural argentina.</p><p>José Hernández · 1872 y 1879.</p></div>
   <nav aria-label="Navegación del pie"><strong>Explorá</strong><a href="/leer/">La obra</a><a href="/revista/">Revista</a><a href="/archivo/">Archivo</a><a href="/buscar/">Buscar versos</a></nav>
   <div><strong>Fuentes y método</strong><p>Edición digital estructurada basada en Project Gutenberg, con enmiendas documentadas.</p><a href="/acerca/">Procedencia, variantes e integridad ↗</a></div>
  </div>
 </footer>
</body>
</html>
